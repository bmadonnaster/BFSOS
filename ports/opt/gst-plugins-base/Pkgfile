# Description: An essential exemplary set of plugins for GStreamer
# URL: https://gstreamer.freedesktop.org/modules/gst-plugins-base.html
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: gstreamer libvorbis opus mesa
# Optional: alsa-lib cdparanoia-iii gobject-introspection ISO-codes libgudev libjpeg-turbo libogg libpng libtheora pango wayland-protocols xorg-libs graphene gtk3 qt5 sdl2 valgrind hotdoc libvisual orc tremor

name=gst-plugins-base
version=1.28.7
release=1
source=(https://gstreamer.freedesktop.org/src/$name/$name-$version.tar.xz)

pkg_build() {
    meson setup build \
        --prefix=/usr \
        --buildtype=release \
        --wrap-mode=nodownload \
        -Dpackage-origin="https://www.bfsos.org/" \
        -Dpackage-name="GStreamer $version BFSOS" || return 1

    ninja -C build || return 1
    DESTDIR="$PKG" ninja -C build install || return 1

    test -f "$PKG/usr/lib/pkgconfig/gstreamer-gl-1.0.pc" || {
        echo "ERROR: gst-plugins-base built without required GstGL support" >&2
        return 1
    }
}
