# Description: An essential exemplary set of plugins for GStreamer
# URL: https://gstreamer.freedesktop.org/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: gstreamer libvorbis opus
# Optional: alsa-lib cdparanoia-iii gobject-introspection iso-codes libgudev libjpeg-turbo libogg libpng libtheora mesa pango wayland-protocols xorg-libs graphene gtk3 qt5 sdl2 valgrind hotdoc libvisual orc tremor

name=gst-plugins-base
version=1.28.6
release=3

source=(
  https://gstreamer.freedesktop.org/src/$name/$name-$version.tar.xz
  gst-plugins-base-1.28.6-videopool-include-cycle.patch
)

pkg_build() {
  meson setup build \
    --prefix=/usr \
    --buildtype=release \
    --wrap-mode=nodownload \
    -Dpackage-origin=https://www.linuxfromscratch.org/blfs/ \
    -Dpackage-name="GStreamer $version BFSOS" || return 1

  ninja -C build || return 1

  DESTDIR="$PKG" \
    ninja -C build install || return 1
}
