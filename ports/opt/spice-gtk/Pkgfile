# Description: GTK3 SPICE client library and widget
# URL: https://www.spice-space.org/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: cairo cyrus-sasl gdk-pixbuf glib gtk3 gstreamer gst-plugins-base gst-plugins-good json-glib libcap-ng libepoxy libjpeg-turbo libusb lz4 openssl opus pixman polkit python3-pyparsing python3-six spice-protocol usbredir wayland wayland-protocols zlib

name=spice-gtk
version=0.42
release=1
source=(https://www.spice-space.org/download/gtk/spice-gtk-$version.tar.xz)

build_opt=(
    -Dgtk=enabled
    -Dwayland-protocols=enabled
    -Dwebdav=disabled
    -Dusbredir=enabled
    -Dlibcap-ng=enabled
    -Dpolkit=enabled
    -Dintrospection=disabled
    -Dvapi=disabled
    -Dlz4=enabled
    -Dsasl=enabled
    -Dopus=enabled
    -Dsmartcard=disabled
    -Degl=enabled
    -Dgtk_doc=disabled
)
