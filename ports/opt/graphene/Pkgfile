name=graphene
version=1.10.8
release=1
source=(https://download.gnome.org/sources/$name/1.10/$name-$version.tar.xz)

build() {
	cd $name-$version

	mkdir build &&
cd    build &&

meson setup --prefix=/usr --buildtype=release .. &&
ninja
	DESTDIR=$PKG ninja install
}
