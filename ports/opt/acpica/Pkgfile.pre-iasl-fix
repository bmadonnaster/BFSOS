# Description: ACPI Component Architecture utilities including iASL
# URL: https://www.intel.com/content/www/us/en/developer/topic-technology/open/acpica/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: bison flex

name=acpica
version=20260408
release=1
source=(https://github.com/open-acpica/acpica/releases/download/$version/acpica-unix-$version.tar.gz)

pkg_build() {
    cd acpica-unix-$version

    make -j "${JOBS:-1}" || return 1

    mkdir -p "$PKG/usr/bin"

    install -m755 generate/unix/bin/* "$PKG/usr/bin/" || return 1
}
