# Depends on: cairomm glibmm-2.68 gtk4 libsigc++ pangomm-2.48 vulkan-loader

name=gtkmm
version=4.22.0
release=1
source=(https://download.gnome.org/sources/${name}/${version%.*}/${name}-${version}.tar.xz)
pkg_build () {
mkdir gtkmm4-build &&
cd    gtkmm4-build &&

meson setup --prefix=/usr --buildtype=release .. &&
ninja
DESTDIR="$PKG" ninja install
}
