# Description: HTTP/2 C Library and tools
# URL: https://github.com/libnghttp2/libnghttp2/
# Maintainer: Brian Madonna email bmadonnaster@gmail.com
# Optional: libxml2 boost c-ares cython jansson libevent sphinx jemalloc libev mruby spdylay cUnit

name=libnghttp2
version=1.64.0
release=2
source=(https://github.com/libnghttp2/libnghttp2/releases/download/v$version/libnghttp2-$version.tar.xz)

build() {
	cd libnghttp2-$version
	./configure --prefix=/usr     \
            --disable-static  \
            --enable-lib-only \
            --docdir=/usr/share/doc/libnghttp2-$version &&
make

	make DESTDIR=$PKG install
}
