name=libnghttp2
version=1.64.0
release=1
source=(https://github.com/nghttp2/nghttp2/releases/download/v$version/nghttp2-$version.tar.xz)

build() {
	cd nghttp2-$version
	./configure --prefix=/usr     \
            --disable-static  \
            --enable-lib-only \
            --docdir=/usr/share/doc/nghttp2-$version &&
make

	make DESTDIR=$PKG install
}
