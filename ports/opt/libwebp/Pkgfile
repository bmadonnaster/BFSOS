# Description: A library for a new image format comparable to JPEG.
# URL: https://developers.google.com/speed/webp/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on:
# Optional: libjpeg-turbo libpng libtiff sdl12-compat freeglut giflib

name=libwebp
version=1.6.0
release=2
source=(https://storage.googleapis.com/downloads.webmproject.org/releases/webp/$name-$version.tar.gz)

pkg_build() {
  ./configure --prefix=/usr           \
            --enable-libwebpmux     \
            --enable-libwebpdemux   \
            --enable-libwebpdecoder \
            --enable-libwebpextras  \
            --enable-swap-16bit-csp \
            --disable-static        &&
make


  DESTDIR=$PKG make install
}
