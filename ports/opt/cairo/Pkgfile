name=cairo
version=1.18.2
release=1
source=(https://www.cairographics.org/releases/$name-$version.tar.xz)

build() {
	cd $name-$version
        mkdir build &&
cd    build &&

meson setup --prefix=/usr --buildtype=release -Dxlib-xcb=enabled  .. &&
ninja
DESTDIR=$PKG ninja install
}
