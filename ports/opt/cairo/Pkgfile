# Description: A 2D graphics library with support for multiple output devices
# URL: https://www.cairographics.org/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: fontconfig glib pixman libXext libXrender xcb-util libpng
# Optional: ghostscript gtk+-3 gtk+-2 gtk-doc libdrm librsvg libxml2 lzo mesa poppler valgrind jbig2dec libspectre Skia
name=cairo
version=1.18.4
release=3
source=(https://mirror.subgraph.com/$name-$version.tar.xz)

pkg_build() {
        meson setup build . --prefix=/usr --buildtype=release -Dxlib-xcb=enabled || return $?
        meson compile -C build -j "${JOBS:-1}" || return $?
        DESTDIR="$PKG" meson install -C build || return $?
}
