# Description: Performance-portable SIMD library
# URL: https://github.com/google/highway
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: cmake ninja

name=highway
version=1.4.0
release=3
source=(https://github.com/google/highway/archive/refs/tags/$version.tar.gz)
renames=(highway-$version.tar.gz)

pkg_build() {
    cmake -S . -B build \
        -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_SHARED_LIBS=ON \
        -DHWY_ENABLE_TESTS=OFF \
        -DHWY_ENABLE_EXAMPLES=OFF || return 1

    cmake --build build -j "${JOBS:-1}" || return 1

    DESTDIR="$PKG" \
        cmake --install build || return 1
}
