# Description: QEMU machine emulator and KVM virtualizer
# URL: https://www.qemu.org/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: dtc alsa-lib glib gtk3 libaio libcap-ng libepoxy libseccomp libslirp liburing libusb spice spice-protocol usbredir libxml2 ncurses pixman sdl2 virglrenderer zlib zstd
# Optional: pipewire pulseaudio

name=qemu
version=11.1.2
release=1
build_work=disk
configure_out_of_tree=yes
configure_build_tool=ninja
source=(https://download.qemu.org/qemu-$version.tar.xz)

build_opt=(
    --libexecdir=/usr/lib/qemu
    --target-list=x86_64-softmmu,i386-softmmu
    --disable-download
    --enable-tools
    --enable-guest-agent
    --enable-kvm
    --enable-linux-aio
    --enable-linux-io-uring
    --enable-slirp
    --enable-gtk
    --enable-sdl
    --enable-opengl
    --enable-virglrenderer
    --enable-vnc
    --enable-spice
    --enable-seccomp
    --enable-cap-ng
    --enable-libusb
    --enable-usb-redir
    --disable-werror
)


# QEMU contains meson.build, but its supported feature switches belong to
# QEMU's ./configure wrapper. Do not let the generic backend invoke Meson
# directly with QEMU configure options.
pkg_build() {
    rm -rf _bfs_qemu_build
    mkdir _bfs_qemu_build
    cd _bfs_qemu_build || return 1

    ../configure \
        --prefix=/usr \
        --libdir=/usr/lib \
        --sysconfdir=/etc \
        --localstatedir=/var \
        "${build_opt[@]}" || return 1

    ninja || return 1
    DESTDIR="$PKG" ninja install || return 1
}
