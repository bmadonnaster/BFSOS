# Description: QEMU machine emulator and KVM virtualizer
# URL: https://www.qemu.org/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: dtc alsa-lib glib gtk3 libaio libcap-ng libepoxy libseccomp libslirp liburing libusb spice spice-protocol usbredir libxml2 ncurses pixman sdl2 virglrenderer zlib zstd
# Optional: pipewire pulseaudio

name=qemu
version=11.1.1
release=6
build_work=disk
configure_out_of_tree=yes
configure_build_tool=ninja
source=(https://download.qemu.org/qemu-$version.tar.xz)

build_opt=(
    --libexecdir=/usr/lib/qemu
    --target-list=x86_64-softmmu,i386-softmmu
    --disable-download
    --enable-tools
    --enable-guest-agent
    --enable-kvm
    --enable-linux-aio
    --enable-linux-io-uring
    --enable-slirp
    --enable-gtk
    --enable-sdl
    --enable-opengl
    --enable-virglrenderer
    --enable-vnc
    --enable-spice
    --enable-seccomp
    --enable-cap-ng
    --enable-libusb
    --enable-usb-redir
    --disable-werror
)
