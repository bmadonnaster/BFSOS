name=lmdb
version=0.9.31
release=1
source=(https://github.com/LMDB/lmdb/archive/LMDB_$version.tar.gz)

build() {
	cd $name-LMDB_$version
	cd libraries/liblmdb &&
make                 &&
sed -i 's| liblmdb.a||' Makefile
	make prefix=$PKG/usr install
}
