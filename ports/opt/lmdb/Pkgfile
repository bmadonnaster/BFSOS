# Description: Fast, compact memory-mapped key-value database
# URL: https://github.com/LMDB/lmdb
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>

name=lmdb
version=1.0.1
release=3
source=(https://github.com/LMDB/lmdb/archive/LMDB_$version.tar.gz)

pkg_build() {
    cd libraries/liblmdb || return 1

    make || return 1

    # BFSOS does not ship static libraries.
    sed -i 's| liblmdb.a||' Makefile || return 1

    make prefix=/usr DESTDIR="$PKG" install || return 1
}
