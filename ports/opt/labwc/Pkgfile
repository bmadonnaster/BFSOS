# Description: Lightweight Wayland stacking compositor inspired by Openbox
# URL: https://labwc.github.io/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: meson wlroots wayland wayland-protocols libinput libxkbcommon libxml2 glib cairo pango pixman libpng libdrm

name=labwc
version=0.20.2
release=1
source=(https://github.com/labwc/labwc/archive/refs/tags/${version}.tar.gz)

pkg_build() {
    meson setup build . \
        --prefix=/usr \
        --buildtype=release \
        --wrap-mode=nodownload \
        -Dicon=disabled \
        -Dtest=disabled || return 1

    meson compile -C build || return 1

    DESTDIR="$PKG" meson install -C build || return 1
}
