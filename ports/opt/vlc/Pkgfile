# Description: VLC media player
# URL: https://www.videolan.org/vlc/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: alsa-lib desktop-file-utils ffmpeg liba52 libgcrypt libmad lua52 dbus libidn libssh2 libarchive libcddb libdv libdvdcss libdvdread libdvdnav opencv v4l-utils libcdio libogg faad2 flac libaom libass libmpeg2 libpng libva libvorbis opus speex libvpx x264 aalib fontconfig freetype fribidi librsvg libvdpau sdl12-compat pulseaudio libsamplerate qt5 gnutls libnotify libxml2 protobuf taglib xdg-utils

name=vlc
version=3.0.23
release=2

source=(
  https://download.videolan.org/$name/$version/$name-$version.tar.xz
)

build_opt="--enable-lua
           --enable-wayland
           --disable-libplacebo"

pre_build() {
  # BLFS compatibility fix for GStreamer 1.28+
  sed -i 's/gstvideopool.h/video.h/' \
    modules/codec/gstreamer/gstvlcvideopool.h || return 1

  export LUAC=/usr/bin/luac5.2 || return 1
  export LUA_LIBS="$(pkgconf --libs lua52)" || return 1
  export CPPFLAGS="$(pkgconf --cflags lua52)" || return 1
}
