name=icu
version=77.1
release=1
source=(https://github.com/unicode-org/icu/releases/download/release-${version//./-}/icu4c-${version/./_}-src.tgz)

pkg_build() {
  cd $SRC/icu/source
  ./configure --prefix=/usr                    &&
make
 
  make -j1 DESTDIR=$PKG install
}
