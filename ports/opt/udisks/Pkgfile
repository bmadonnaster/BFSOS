name=udisks
version=2.10.1
release=1
source=(https://github.com/storaged-project/$name/releases/download/$name-$version/$name-$version.tar.bz2)

build() {
	cd $name-$version
./configure --prefix=/usr        \
            --sysconfdir=/etc    \
            --localstatedir=/var \
            --disable-static     \
            --enable-available-modules &&
make

	make DESTDIR=$PKG install
}
