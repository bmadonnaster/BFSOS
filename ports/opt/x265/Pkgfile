# Depends on: cmake nasm

name=x265
version=4.3
release=1
source=(https://github.com/Multicorewareinc/x265/releases/download/$version/x265_$version.tar.gz)
pkg_build () {
mkdir bld &&
cd    bld &&

cmake -D CMAKE_INSTALL_PREFIX=/usr \
      -D GIT_ARCHETYPE=1           \
      -W no-dev ../source          &&
make
make DESTDIR="$PKG" install
}
