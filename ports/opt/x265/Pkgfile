# Depends on: cmake nasm

name=x265
version=4.2
release=2
source=(https://bitbucket.org/multicoreware/x265_git/downloads/x265_$version.tar.gz)
pkg_build () {
mkdir bld &&
cd    bld &&

cmake -D CMAKE_INSTALL_PREFIX=/usr \
      -D GIT_ARCHETYPE=1           \
      -W no-dev ../source          &&
make
make DESTDIR="$PKG" install
}
