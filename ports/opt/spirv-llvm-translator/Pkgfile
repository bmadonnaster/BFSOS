# Description: Bidirectional translation between LLVM IR and SPIR-V
# URL: https://github.com/KhronosGroup/SPIRV-LLVM-Translator
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: libxml2 llvm spirv-headers spirv-tools

name=spirv-llvm-translator
version=23.1.1
release=1
source=(https://github.com/KhronosGroup/SPIRV-LLVM-Translator/archive/v${version}/SPIRV-LLVM-Translator-${version}.tar.gz)

pkg_build() {
    cmake -S . -B build \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_SHARED_LIBS=ON \
        -DCMAKE_SKIP_INSTALL_RPATH=ON \
        -DLLVM_EXTERNAL_SPIRV_HEADERS_SOURCE_DIR=/usr \
        -G Ninja || return $?
    cmake --build build -j "${JOBS:-1}" || return $?
    DESTDIR="$PKG" cmake --install build || return $?
}
