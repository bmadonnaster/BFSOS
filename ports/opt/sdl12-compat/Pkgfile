# Description: SDL 1.2 compatibility layer implemented on top of SDL2
# URL: https://github.com/libsdl-org/sdl12-compat
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: cmake glu sdl2

name=sdl12-compat
version=1.2.76
release=1

source=(
  https://github.com/libsdl-org/sdl12-compat/archive/refs/tags/release-$version/$name-release-$version.tar.gz
)

pkg_build() {
  cmake -S . -B build \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DCMAKE_BUILD_TYPE=Release \
    -DSDL12TESTS=OFF \
    -DSDL12DEVEL=ON \
    -DSTATICDEVEL=OFF || return 1

  cmake --build build -j "${JOBS:-1}" || return 1

  DESTDIR="$PKG" \
    cmake --install build || return 1
}
