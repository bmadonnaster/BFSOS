# Description: PDF rendering library
# URL: https://poppler.freedesktop.org/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: poppler-data fontconfig gobject-introspection boost cairo lcms2 libjpeg-turbo libpng nss openjpeg2 gpgme gpgmepp qt6

name=poppler
version=26.09.0
release=2

source=(
    https://poppler.freedesktop.org/poppler-$version.tar.xz
)

build_opt="\
    -DCMAKE_PREFIX_PATH=/opt/qt6 \
    -DENABLE_UNSTABLE_API_ABI_HEADERS=ON \
    -DENABLE_QT5=OFF \
    -DENABLE_QT6=ON \
    -DENABLE_GLIB=ON \
    -DBUILD_GTK_TESTS=OFF \
    -DBUILD_QT5_TESTS=OFF \
    -DBUILD_QT6_TESTS=OFF \
    -DBUILD_CPP_TESTS=OFF \
    -DBUILD_MANUAL_TESTS=OFF"
