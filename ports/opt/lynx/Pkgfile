# Description: Text-based web browser.
# URL: https://lynx.invisible-island.net/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: brotli openssl
# Optional: gnutls libarchive libidn2 zip sharutils

name=lynx
version=2.9.3
release=2
source=(https://invisible-mirror.net/archives/lynx/tarballs/lynx${version}.tar.bz2)

pkg_build() {
    ./configure --prefix=/usr \
        --sysconfdir=/etc/lynx \
        --with-zlib \
        --with-bzlib \
        --with-ssl \
        --with-screen=ncursesw \
        --enable-ipv6 \
        --enable-locale-charset \
        --enable-nls \
        --datadir=/usr/share/doc/lynx-$version
    make -j "${JOBS:-1}"
    make DESTDIR="$PKG" install-full
    chgrp -R root "$PKG/usr/share/doc/lynx-$version/lynx_doc"
    sed -e '/#LOCALE/     a LOCALE_CHARSET:TRUE' -i "$PKG/etc/lynx/lynx.cfg"
    sed -e '/#DEFAULT_ED/ a DEFAULT_EDITOR:vi' -i "$PKG/etc/lynx/lynx.cfg"
    sed -e '/#PERSIST/    a PERSISTENT_COOKIES:TRUE' -i "$PKG/etc/lynx/lynx.cfg"
}
