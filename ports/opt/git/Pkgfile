# Description: Distributed version control system
# URL: https://git-scm.com/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: curl expat
# Optional: tk

name=git
version=2.55.0
release=4
source=(
    https://www.kernel.org/pub/software/scm/$name/$name-$version.tar.xz
    git
)

pkg_build() {
    ./configure \
        --prefix=/usr \
        --with-gitconfig=/etc/gitconfig \
        --with-python=/usr/bin/python3

    make \
        NO_RUST=YesPlease

    make \
        DESTDIR="$PKG" \
        NO_RUST=YesPlease \
        install
}

post_build() {
    # Install the CRUX ports git driver.
    install -Dm755 "$SRC/git" "$PKG/etc/ports/drivers/git"
}
