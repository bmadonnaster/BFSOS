# Description: LLVM compiler infrastructure with Clang and compiler-rt
# URL: https://llvm.org/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: cmake libffi ninja python3
# Optional: doxygen git graphviz libunwind libxml2 python3-psutil python3-pygments python3-pyyaml rsync sphinx texlive valgrind zip z3

name=llvm
version=23.1.1
release=1
keep_static=1
source=(
    https://github.com/llvm/llvm-project/releases/download/llvmorg-$version/llvm-project-$version.src.tar.xz
)

pkg_build() {
  
    # Keep LLVM/Clang/LLD/compiler-rt in one coherent monorepo build.
    mkdir -p llvm/build
    cd llvm/build

    CC=gcc CXX=g++ cmake \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_SKIP_INSTALL_RPATH=ON \
        -DLLVM_ENABLE_FFI=ON \
        -DCMAKE_BUILD_TYPE=Release \
        -DLLVM_BUILD_LLVM_DYLIB=ON \
        -DLLVM_LINK_LLVM_DYLIB=ON \
        -DLLVM_ENABLE_RTTI=ON \
        -DLLVM_TARGETS_TO_BUILD='host;AMDGPU;BPF' \
        -DLLVM_ENABLE_PROJECTS='clang;lld' \
        -DLLVM_ENABLE_RUNTIMES=compiler-rt \
        -DLLVM_BINUTILS_INCDIR=/usr/include \
        -DLLVM_INCLUDE_BENCHMARKS=OFF \
        -DCLANG_DEFAULT_PIE_ON_LINUX=ON \
        -DCLANG_CONFIG_FILE_SYSTEM_DIR=/etc/clang \
        -Wno-author -G Ninja ..

    ninja -j "${JOBS:-1}"
    DESTDIR="$PKG" ninja install

    install -d "$PKG/etc/clang"
    printf '%s\n' '-fstack-protector-strong' > "$PKG/etc/clang/clang.cfg"
    printf '%s\n' '-fstack-protector-strong' > "$PKG/etc/clang/clang++.cfg"
}
