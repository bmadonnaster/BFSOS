name=libndp
version=1.9
release=1
source=(http://$name.org/files/$name-$version.tar.gz)

build() {
	cd $name-$version

	./configure --prefix=/usr        \
            --sysconfdir=/etc    \
            --localstatedir=/var \
            --disable-static     &&
make
	make DESTDIR=$PKG install
}
