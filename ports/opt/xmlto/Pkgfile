# Description: Convert XML to many other formats.
# URL: https://codeberg.org/xmlto/xmlto
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: docbook-xml docbook-xsl-nons libxslt

name=xmlto
version=0.0.29
release=2

source=(https://codeberg.org/xmlto/xmlto/archive/$version.tar.gz)

pkg_build() {
        autoreconf -fiv

        sed -i \
                -e 's,4\.2,4\.5,g' doc/xmlif.xml \
                -e 's,4\.2,4\.5,g; /productname/s|25|28|;' doc/xmlto.xml

        LINKS=/usr/bin/links \
        ./configure \
                --prefix=/usr

        make
        make DESTDIR="$PKG" install
}
