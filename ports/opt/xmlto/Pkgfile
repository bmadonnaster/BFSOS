# Description: Convert xml to many other formats.
# URL: https://pagure.io/xmlto
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: docbook-xml docbook-xsl-nons libxslt

name=xmlto
version=0.0.29
release=1
source=(https://ftp.ludd.ltu.se/mirrors/blfs/conglomeration/xmlto/xmlto-$version.tar.gz)


pkg_build() {

autoreconf -i
	sed -i -e 's,4\.2,4\.5,g' doc/xmlif.xml
	sed -i -e 's,4\.2,4\.5,g; /productname/s|25|28|;' doc/xmlto.xml

	./configure \
		--prefix=/usr

	make
	make DESTDIR=$PKG install
}
