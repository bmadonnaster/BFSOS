# Description: Lightweight PDF and XPS viewer
# URL: https://www.mupdf.com/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: glu harfbuzz libjpeg-turbo libXi
# Optional: freeglut openjpeg2 jbig2dec gumbo-parser

name=mupdf
version=1.28.6
release=1
source=(https://mupdf.com/downloads/archive/$name-$version-source.tar.gz)
pkg_build() {
    local PKGMK_MUPDF="USE_SYSTEM_LIBS=yes"

    prt-get isinst freeglut ||
        PKGMK_MUPDF+=" USE_SYSTEM_GLUT=no"

    prt-get isinst openjpeg2 ||
        PKGMK_MUPDF+=" USE_SYSTEM_OPENJPEG=no"

    prt-get isinst jbig2dec ||
        PKGMK_MUPDF+=" USE_SYSTEM_JBIG2DEC=no"

    prt-get isinst gumbo-parser ||
        PKGMK_MUPDF+=" USE_SYSTEM_GUMBO=no"

    make install $PKGMK_MUPDF \
        prefix=/usr \
        mandir=/usr/share/man \
        DESTDIR="$PKG" \
        XCFLAGS="-fpic -fcommon" || return 1

    ln -s mupdf-gl "$PKG/usr/bin/mupdf" || return 1

    if [ -d "$PKG/usr/share/doc" ]; then
        rm -r "$PKG/usr/share/doc" || return 1
    fi
}
