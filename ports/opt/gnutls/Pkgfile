# Description: Secure communications library implementing TLS, DTLS, and related protocols
# URL: https://gnutls.org/
# Maintainer: Brian Madonna email [bmadonnaster@gmail.com](mailto:bmadonnaster@gmail.com)
# Depends on: libunistring nettle p11-kit libtasn1
# Optional: brotli libidn2

name=gnutls
version=3.8.13
release=1
source=(https://mirrors.dotsrc.org/gcrypt/$name/v${version:0:3}/$name-$version.tar.xz)

pkg_build() {
local configure_options=(
--prefix=/usr
--docdir=/usr/share/doc/$name-$version
--with-default-trust-store-pkcs11=pkcs11:
)
if pkg-config --exists libbrotlienc 2>/dev/null; then
    configure_options+=(--with-brotli)
else
    configure_options+=(--without-brotli)
fi

if pkg-config --exists libidn2 2>/dev/null; then
    configure_options+=(--with-idn)
else
    configure_options+=(--without-idn)
fi

./configure "${configure_options[@]}"

make
make DESTDIR="$PKG" install

rm -rf \
    "$PKG/usr/share/doc" \
    "$PKG/usr/share/info" \
    "$PKG/usr/share/locale"
}
