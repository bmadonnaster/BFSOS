# Description: SIP bindings generator used by PyQt
# URL: https://www.riverbankcomputing.com/software/sip/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: python3-build python3-installer python3-packaging python3-setuptools python3-wheel

name=python3-sip
version=6.17.0
release=1
source=(https://files.pythonhosted.org/packages/source/s/sip/sip-$version.tar.gz)

pkg_build() {
    python3 -m build --wheel --skip-dependency-check --no-isolation || return 1
    python3 -m installer --compile-bytecode 2 --destdir="$PKG" dist/*.whl || return 1
}
