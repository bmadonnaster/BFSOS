# Description: The libqalculate package contains a library that provides functions for a multi-purpose calculator.
# URL:         https://github.com/Qalculate/libqalculate/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on:  curl icu libxml2
# Optional:	gnuplot	doxygen

name=libqalculate
version=5.12.0
release=2
source=(https://github.com/Qalculate/$name/releases/download/v$version/$name-$version.tar.gz)
build_opt=" --prefix=/usr
            --disable-static
            --docdir=/usr/share/doc/$name-$version"
