# Description: Fast system information display with BFSOS branding
# URL: https://github.com/fastfetch-cli/fastfetch
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: cmake ninja
# Optional: imagemagick libdrm libpci wayland libxcb dbus

name=fastfetch
version=2.70.0
release=3
source=(
    https://github.com/fastfetch-cli/fastfetch/archive/refs/tags/$version.tar.gz
    bfsos-logo.txt
    bfsos-config.jsonc
)

pkg_build() {
    local image_logo=OFF
    if command -v magick >/dev/null 2>&1 && pkg-config --list-all 2>/dev/null | grep -qi '^MagickCore'; then
        image_logo=ON
    fi

    cmake -S . -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_TESTS=OFF \
        -DBUILD_FLASHFETCH=OFF \
        -DENABLE_IMAGE_LOGO="$image_logo" \
        -DSET_TWEAK=OFF || return 1
    cmake --build build --target fastfetch -j "${JOBS:-1}" || return 1
    DESTDIR="$PKG" cmake --install build || return 1

    install -d "$PKG/usr/share/fastfetch/bfsos"
    install -m 0644 "$SRC/bfsos-logo.txt" "$PKG/usr/share/fastfetch/bfsos/logo.txt" || return 1
    install -m 0644 "$SRC/bfsos-config.jsonc" "$PKG/usr/share/fastfetch/bfsos/config.jsonc" || return 1
}
