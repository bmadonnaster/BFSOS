# Description: Modular Wayland compositor library
# URL: https://gitlab.freedesktop.org/wlroots/wlroots
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: meson wayland wayland-protocols libdrm libxkbcommon pixman libinput seatd systemd mesa libdisplay-info hwdata libliftoff

name=wlroots
version=0.20.2
release=2
source=(https://gitlab.freedesktop.org/wlroots/wlroots/-/releases/${version}/downloads/${name}-${version}.tar.gz)

pkg_build() {
    meson setup build . \
        --prefix=/usr \
        --buildtype=release \
        --wrap-mode=nodownload \
        -Dexamples=false \
        -Dbackends=drm,libinput \
        -Drenderers=gles2 \
        -Dsession=enabled \
        -Dlibliftoff=enabled \
        -Dxwayland=disabled || return 1

    meson compile -C build || return 1

    DESTDIR="$PKG" meson install -C build || return 1
}
