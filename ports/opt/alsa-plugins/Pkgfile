name=alsa-plugins
version=1.2.7.1
release=1
source=(ftp://ftp.alsa-project.org/pub/plugins/$name-$version.tar.bz2)

build() {
	cd $name-$version

	./configure --sysconfdir=/etc &&
make
	make DESTDIR=$PKG install
}
