# Description: C implementation of Protocol Buffers
# URL: https://github.com/protobuf-c/protobuf-c
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: protobuf
# Optional: doxygen

name=protobuf-c
version=1.5.2
release=2
source=(https://github.com/${name}/${name}/releases/download/v${version}/${name}-${version}.tar.gz
        https://www.linuxfromscratch.org/patches/blfs/svn/protobuf-c-${version}-protobuf34_fix-1.patch)

build_opt="--prefix=/usr --disable-static"
export CXXFLAGS="${CXXFLAGS:--O2 -g} -std=c++20"
