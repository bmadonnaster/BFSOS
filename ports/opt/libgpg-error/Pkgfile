# Description: Common error codes and messages used by GnuPG and related software.
# URL: https://www.gnupg.org/software/libgpg-error/
# Maintainer: Brian Madonna email bmadonnaster@gmail.com

name=libgpg-error
version=1.56
release=1

source=(
    https://www.gnupg.org/ftp/gcrypt/$name/$name-$version.tar.bz2
)

build_opt=(
    --prefix=/usr
)

pkg_build() {
    ./configure "${build_opt[@]}"

    make
    make DESTDIR="$PKG" install

    # Install the upstream README.
    install -Dm644 README \
        "$PKG/usr/share/doc/$name-$version/README"

    # BFS does not package GNU info pages.
    rm -rf "$PKG/usr/share/info"
}
