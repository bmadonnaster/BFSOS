name=libgpg-error
version=1.51
release=1
source=(https://www.gnupg.org/ftp/gcrypt/$name/$name-$version.tar.bz2)

build() {
	cd $name-$version

	./configure --prefix=/usr &&
make
	make DESTDIR=$PKG install &&
	install -v -m644 -D README $PKG/usr/share/doc/libgpg-error-1.47/README

	rm -r $PKG/usr/share/info/
}
