# Description: Common error codes and messages used by GnuPG and related software.
# URL: https://www.gnupg.org/software/libgpg-error/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>

name=libgpg-error
version=1.56
release=2

source=(
    https://distfiles.icmpv6.org/distfiles/$name-$version.tar.bz2
)

build_opt="--prefix=/usr"

post_build() {
    install -Dm644 README \
        "$PKG/usr/share/doc/$name-$version/README"

    # BFSOS does not package GNU info pages.
    rm -rf "$PKG/usr/share/info"
}
