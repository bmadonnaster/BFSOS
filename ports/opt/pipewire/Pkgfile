# Description: Server and userspace API for handling audio and video multimedia pipelines
# URL: https://pipewire.org/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: bluez gstreamer gst-plugins-base pulseaudio sbc v4l-utils
# Optional: alsa-lib avahi fdk-aac ffmpeg libcanberra libdrm libcamera libxcb libsndfile libusb opus sdl2 valgrind xorg-libs doxygen graphviz jack ldacbt libmysofa vulkan xmltoman

name=pipewire
version=1.6.8
release=4

source=(
    https://github.com/PipeWire/$name/archive/$version/$name-$version.tar.gz
)

build_opt="-Dtests=disabled \
-Dinstalled_tests=disabled \
-Dexamples=disabled \
-Dsession-managers=[] \
-Dsystemd-user-service=enabled"
