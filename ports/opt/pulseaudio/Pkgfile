# Description: PulseAudio is a cross-platform, networked sound server
# URL: https://www.freedesktop.org/wiki/Software/PulseAudio/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: libsndfile
# Optional: avahi bluez5 doxygen fftw gtk3 libsamplerate sbc valgrind jack libasyncns lirc orc soxr tdb webrtc audioprocessing

name=pulseaudio
version=17.0
release=5
source=(https://ftp.debian.org/debian/pool/main/p/pulseaudio/pulseaudio_$version+dfsg1.orig.tar.xz)
renames=(pulseaudio-$version.tar.xz)

pkg_build() {
  meson setup build . \
      --prefix=/usr \
      --buildtype=release \
      -Ddaemon=false \
      -Dclient=true \
      -Ddatabase=gdbm \
      -Ddoxygen=false \
      -Dbluez5=disabled || return 1

  meson compile -C build -j "${JOBS:-1}" || return 1
  DESTDIR="$PKG" meson install -C build || return 1

  # BFSOS Plasma uses PipeWire-Pulse as the PulseAudio protocol server.
  # Keep libpulse/tools for compatibility, but do not auto-launch the
  # standalone PulseAudio daemon and race PipeWire for pulse/native.
  rm -f "$PKG/etc/xdg/autostart/pulseaudio.desktop"

  if [ -f "$PKG/etc/pulse/client.conf" ]; then
    if grep -q '^[#;][[:space:]]*autospawn[[:space:]]*=' "$PKG/etc/pulse/client.conf"; then
      sed -i 's/^[#;][[:space:]]*autospawn[[:space:]]*=.*/autospawn = no/' \
        "$PKG/etc/pulse/client.conf" || return 1
    elif ! grep -q '^[[:space:]]*autospawn[[:space:]]*=' "$PKG/etc/pulse/client.conf"; then
      printf '\nautospawn = no\n' >> "$PKG/etc/pulse/client.conf" || return 1
    fi
  fi
}
