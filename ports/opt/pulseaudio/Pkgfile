# Description: PulseAudio is a cross-platform, networked sound server
# URL: https://www.freedesktop.org/wiki/Software/PulseAudio/
# Maintainer: Brian Madonna email bmadonnaster@gmail.com
# Depends on: libsndfile
# Optional: avahi bluez5 doxygen fftw gtk3 libsamplerate sbc valgrind jack libasyncns lirc orc soxr tdb webrtc audioprocessing

name=pulseaudio
version=17.0
release=2
source=(https://ftp.debian.org/debian/pool/main/p/pulseaudio/pulseaudio_$version+dfsg1.orig.tar.xz)
renames=(pulseaudio-$version.tar.xz)

pkg_build() {
  mkdir build &&
cd    build &&

meson setup --prefix=/usr       \
            --buildtype=release \
            -Ddatabase=gdbm     \
            -Ddoxygen=false     \
            -Dbluez5=disabled   \
            ..                  &&
ninja || return 1
  DESTDIR="$PKG" ninja install || return 1
#rm -fv $PKG/etc/dbus-1/system.d/pulseaudio-system.conf
}
