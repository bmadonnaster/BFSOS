# Description: D-Bus service that performs user authentication for Accounts-SSO clients
# URL: https://gitlab.com/accounts-sso/signond/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: qt6

name=signond
version=8.61
release=1
_commit=c8ad98249af541514ff7a81634d3295e712f1a39
source=(https://gitlab.com/nicolasfella/$name/-/archive/$_commit/$name-$_commit.tar.gz)

pkg_build() {
    "$QT6DIR/bin/qmake" PREFIX=/usr LIBDIR=/usr/lib CONFIG+=rtti CONFIG+=release || return 1
    make -j${JOBS:-1} || return 1
    make INSTALL_ROOT="$PKG" install || return 1
    rm -rf "$PKG/usr/share/doc" || return 1
}
