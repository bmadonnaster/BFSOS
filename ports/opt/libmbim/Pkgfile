name=libmbim
version=1.26.4
release=1
source=(https://www.freedesktop.org/software/$name/$name-$version.tar.xz)

build() {
	cd $name-$version

	./configure --prefix=/usr --disable-static &&
make
	make DESTDIR=$PKG install
}
