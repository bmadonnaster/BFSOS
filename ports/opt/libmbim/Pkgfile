# Description: GLib-based library for talking to WWAN modems using the Mobile Broadband Interface Model (MBIM) protocol.
# URL: https://gitlab.freedesktop.org/mobile-broadband/libmbim
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: glib meson ninja
# Optional: gobject-introspection gtk-doc help2man

name=libmbim
version=1.34.0
release=1
source=(https://gitlab.freedesktop.org/mobile-broadband/libmbim/-/archive/$version/libmbim-$version.tar.gz)

pkg_build() {
    meson setup build \
        --prefix=/usr \
        --buildtype=release \
        -Dgtk_doc=false \
        -Dman=false || return 1

    meson compile -C build -j "${JOBS:-1}" || return 1

    DESTDIR="$PKG" \
        meson install -C build || return 1
}
