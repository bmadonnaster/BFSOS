name=oxygen-icons5
version=5.109.0
release=1
source=(https://download.kde.org/stable/frameworks/5.109/oxygen-icons5-$version.tar.xz)

build() {
	cd $name-$version
sed -i '/( oxygen/ s/)/scalable )/' CMakeLists.txt
mkdir build &&
cd    build &&

cmake -DCMAKE_INSTALL_PREFIX=/usr -Wno-dev ..

	make DESTDIR=$PKG install
}
