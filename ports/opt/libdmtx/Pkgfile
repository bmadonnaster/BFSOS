# Description: Library for reading and writing Data Matrix barcodes
# URL: https://github.com/dmtx/libdmtx
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>

name=libdmtx
version=0.7.8
release=1
source=(https://github.com/dmtx/$name/archive/refs/tags/v$version.tar.gz)

pkg_build() {

    autoreconf -fi &&
    ./configure --prefix=/usr &&
    make &&
    make DESTDIR=$PKG install
}
