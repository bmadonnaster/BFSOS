name=libsamplerate
version=0.2.2
release=1
source=(https://github.com/libsndfile/$name/releases/download/$version/$name-$version.tar.xz)

build() {
	cd $name-$version

	./configure --prefix=/usr    \
            --disable-static \
            --docdir=/usr/share/doc/$name-$version &&
make
	make DESTDIR=$PKG install
}
