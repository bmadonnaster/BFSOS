name=libssh2
version=1.11.1
release=1
source=(https://www.libssh2.org/download/$name-$version.tar.gz)

build() {
  cd $name-$version

  ./configure --prefix=/usr \
    --disable-static
  make
  make DESTDIR=$PKG install
}
