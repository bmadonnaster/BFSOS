# Description: Utilities and library for managing the Linux kernel key retention facility.
# URL: https://git.kernel.org/pub/scm/linux/kernel/git/dhowells/keyutils.git/
# Maintainer: Brian Madonna email bmadonnaster@gmail.com
# Optional: lsb-tools

name=keyutils
version=1.6.3
release=1

source=(
    https://git.kernel.org/pub/scm/linux/kernel/git/dhowells/keyutils.git/snapshot/$name-$version.tar.gz
)

build_opt=(
    NO_ARLIB=1
    BINDIR=/usr/bin
    SBINDIR=/usr/sbin
    LIBDIR=/usr/lib
    USRLIBDIR=/usr/lib
    INCLUDEDIR=/usr/include
    PKGCONFIGDIR=/usr/lib/pkgconfig
)

pkg_build() {
    # Use BFS compiler flags instead of upstream's hard-coded debug flag.
    sed -i \
        "s|^CFLAGS := -g|CFLAGS := $CFLAGS|" \
        Makefile

    make "${build_opt[@]}"

    make \
        DESTDIR="$PKG" \
        "${build_opt[@]}" \
        install

    chmod 0644 \
        "$PKG/usr/lib/pkgconfig/libkeyutils.pc"

    rm -rf "$PKG/usr/share/man"
}
