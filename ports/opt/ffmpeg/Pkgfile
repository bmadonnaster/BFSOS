# Description: Audio/video recording, conversion and streaming framework
# URL: https://ffmpeg.org/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: alsa-lib fdk-aac freetype lame libaom libass libva libvorbis libvpx opus sdl2 x264 x265
# Optional: dav1d libdrm libwebp openjpeg2 pulseaudio samba speex v4l-utils vulkan-loader

name=ffmpeg
version=9.0.1
release=2
source=(
    https://ffmpeg.org/releases/ffmpeg-$version.tar.xz
    https://www.linuxfromscratch.org/patches/blfs/svn/ffmpeg-$version-chromium_method-1.patch
)

pkg_build() {
    ./configure --prefix=/usr \
        --enable-gpl \
        --enable-version3 \
        --enable-nonfree \
        --disable-static \
        --enable-shared \
        --disable-debug \
        --enable-libaom \
        --enable-libass \
        --enable-libfdk-aac \
        --enable-libfreetype \
        --enable-libmp3lame \
        --enable-libopus \
        --enable-libvorbis \
        --enable-libvpx \
        --enable-libx264 \
        --enable-libx265 \
        --enable-openssl \
        --ignore-tests=enhanced-flv-av1,enhanced-flv-multitrack

    make -j "${JOBS:-1}"
    gcc tools/qt-faststart.c -o tools/qt-faststart
    make DESTDIR="$PKG" install
    install -Dm755 tools/qt-faststart "$PKG/usr/bin/qt-faststart"
}
