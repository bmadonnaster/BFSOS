# Description: Audio/video recording, conversion and streaming framework
# URL: https://ffmpeg.org/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: alsa-lib fdk-aac freetype lame libaom libass libva libvdpau libvorbis libvpx opus sdl2 x264 x265
# Optional: dav1d libdrm libwebp openjpeg2 pulseaudio samba speex v4l-utils vulkan-loader

name=ffmpeg
version=9.0.2
release=1

# BFSOS vendored patch provenance: ffmpeg-9.0.2-chromium_method-1.patch <- https://www.linuxfromscratch.org/patches/blfs/svn/ffmpeg-9.0.2-chromium_method-1.patch
source=(
  https://ffmpeg.org/releases/ffmpeg-$version.tar.xz
  ffmpeg-9.0.2-chromium_method-1.patch
)

pkg_build() {
  ./configure \
    --prefix=/usr \
    --enable-gpl \
    --enable-version3 \
    --enable-nonfree \
    --disable-static \
    --enable-shared \
    --disable-debug \
    --enable-libaom \
    --enable-libass \
    --enable-libfdk-aac \
    --enable-libfreetype \
    --enable-libmp3lame \
    --enable-libopus \
    --enable-libvorbis \
    --enable-libvpx \
    --enable-libx264 \
    --enable-libx265 \
    --enable-openssl \
    --enable-vdpau \
    --ignore-tests=enhanced-flv-av1,enhanced-flv-multitrack || return 1

  make -j "${JOBS:-1}" || return 1

  gcc tools/qt-faststart.c \
    -o tools/qt-faststart || return 1

  make DESTDIR="$PKG" install || return 1

  install -Dm755 \
    tools/qt-faststart \
    "$PKG/usr/bin/qt-faststart" || return 1
}
