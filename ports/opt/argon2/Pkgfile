# Description: Reference implementation of the Argon2 password hashing and key derivation algorithm.
# URL: https://github.com/P-H-C/phc-winner-argon2
# Maintainer: Brian Madonna email bmadonnaster@gmail.com
# Depends on:

name=argon2
version=20190702
release=1

source=(
    https://github.com/P-H-C/phc-winner-argon2/archive/refs/tags/$version.tar.gz
)

build_opt=(
    PREFIX=/usr
    LIBDIR=/usr/lib
)

pkg_build() {
    make "${build_opt[@]}"

    make \
        DESTDIR="$PKG" \
        "${build_opt[@]}" \
        install

    rm -f "$PKG/usr/lib/"*.la
}
