# Description: A callback framework for C++.
# URL: https://libsigcplusplus.github.io/libsigcplusplus/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: mm-common

name=libsigc++2
version=2.12.1
release=2
source=(https://download.gnome.org/sources/libsigc++/${version%.*}/libsigc++-$version.tar.xz)

pkg_build() {
  mkdir bld && cd bld

  meson setup .. \
    --prefix=/usr \
    --buildtype=release \
    -D build-documentation=false \
    -D b_lto=true \
    -D b_pie=true

  ninja -j ${JOBS:-1}
  DESTDIR=$PKG ninja install

  find $PKG \( -type f -a -perm -g+w \) -exec chmod g-w '{}' +
}
