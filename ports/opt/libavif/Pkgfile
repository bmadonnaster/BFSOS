# Description: AV1 Image File Format library
# URL: https://github.com/AOMediaCodec/libavif
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: cmake ninja libaom dav1d svt-av1 gdk-pixbuf

name=libavif
version=1.4.2
release=2
source=(https://github.com/AOMediaCodec/${name}/archive/v${version}/${name}-${version}.tar.gz)

pkg_build() {
    cmake -S . -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_BUILD_TYPE=Release \
        -DAVIF_CODEC_AOM=SYSTEM \
        -DAVIF_CODEC_DAV1D=SYSTEM \
        -DAVIF_CODEC_SVT=SYSTEM \
        -DAVIF_BUILD_GDK_PIXBUF=ON \
        -DAVIF_LIBYUV=OFF || return 1
    ninja -C build || return 1
    DESTDIR="$PKG" ninja -C build install || return 1
}
