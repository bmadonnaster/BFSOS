# Description: SOcket CAT - netcat-like utility with many enhancements
# URL: http://www.dest-unreach.org/socat
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: openssl readline

name=socat
version=1.8.1.3
release=1
source=(
    http://www.dest-unreach.org/socat/download/$name-$version.tar.gz
    https://www.linuxfromscratch.org/slfs/view/dev/download/socat/socat-$version-openssl4_fixes-1.patch
)

pkg_build() {
    ./configure --prefix=/usr || return 1
    make -j${JOBS:-1} || return 1
    make DESTDIR="$PKG" install || return 1
}
