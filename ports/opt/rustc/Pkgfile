# Description: Rust compiler and Cargo toolchain
# URL: https://www.rust-lang.org/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: cmake curl llvm python3
# Optional: git libssh2

name=rustc
version=1.97.1
release=2
source=(https://static.rust-lang.org/dist/rustc-$version-src.tar.xz)

build() {
    cd rustc-$version-src
    local prefix="/opt/rustc-$version"

    cat > bootstrap.toml <<EOF
change-id = 140732

[llvm]
link-shared = true

[build]
docs = false
locked-deps = true
tools = ["cargo", "clippy", "rustdoc", "rustfmt"]
target = ["x86_64-unknown-linux-gnu"]

[install]
prefix = "$prefix"
docdir = "share/doc/rustc-$version"

[rust]
channel = "stable"
lld = false
lto = "thin"
codegen-units = 1

[target.x86_64-unknown-linux-gnu]
cc = "/usr/bin/gcc"
cxx = "/usr/bin/g++"
ar = "/usr/bin/gcc-ar"
ranlib = "/usr/bin/gcc-ranlib"
llvm-config = "/usr/bin/llvm-config"
EOF

    if [ -f /usr/lib32/libc.so.6 ]; then
        sed -i 's/target = \["x86_64-unknown-linux-gnu"\]/target = ["x86_64-unknown-linux-gnu", "i686-unknown-linux-gnu"]/' bootstrap.toml
        cat >> bootstrap.toml <<'EOF'

[target.i686-unknown-linux-gnu]
cc = "/usr/bin/gcc -m32"
cxx = "/usr/bin/g++ -m32"
ar = "/usr/bin/gcc-ar"
ranlib = "/usr/bin/gcc-ranlib"
EOF
    fi

    python3 x.py build
    DESTDIR="$PKG" python3 x.py install

    ln -sfn "rustc-$version" "$PKG/opt/rustc"
}
