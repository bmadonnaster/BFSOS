# Description: Core database of common MIME types
# URL: https://freedesktop.org/Software/shared-mime-info
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: glib libxml2
# Optional: xmlto

name=shared-mime-info
version=2.5.1
release=3
source=(
    https://gitlab.freedesktop.org/xdg/shared-mime-info/-/archive/$version/shared-mime-info-$version.tar.gz
    https://anduin.linuxfromscratch.org/BLFS/xdgmime/xdgmime.tar.xz
)

pkg_build() {
    if [ -d "$SRC/xdgmime" ]; then
        cp -a "$SRC/xdgmime" .
        make -C xdgmime
    fi
    meson setup build --prefix=/usr --buildtype=release -Dupdate-mimedb=true
    meson compile -C build -j "${JOBS:-1}"
    DESTDIR="$PKG" meson install -C build
}
