name=libpcap
version=1.10.4
release=1
source=(https://www.tcpdump.org/release/$name-$version.tar.gz)

build() {
	cd $name-$version

	./configure --prefix=/usr &&
make
sed -i '/INSTALL_DATA.*libpcap.a\|RANLIB.*libpcap.a/ s/^/#/' Makefile
	make DESTDIR=$PKG install
}
