name=valgrind
version=3.24.0
release=1
source=(https://sourceware.org/pub/$name/$name-$version.tar.bz2)

build() {
  cd $name-$version
 sed -i 's|/doc/valgrind||' docs/Makefile.in &&

./configure --prefix=/usr \
            --datadir=/usr/share/doc/valgrind-$version &&
make
  make DESTDIR=$PKG install
}
