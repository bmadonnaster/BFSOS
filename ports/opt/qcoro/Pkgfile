name=qcoro
version=0.13.0
release=3
source=(https://github.com/danvratil/qcoro/archive/v$version/$name-$version.tar.gz)

build_opt="-DUSE_QT_VERSION=6 \
-DBUILD_TESTING=OFF \
-DQCORO_BUILD_EXAMPLES=OFF \
-DBUILD_SHARED_LIBS=ON"
