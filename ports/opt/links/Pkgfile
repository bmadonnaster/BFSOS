# Description: Text and graphics mode WWW browser
# URL:         http://links.twibright.com/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on:  openssl libevent

name=links
version=2.30
release=3
source=(
    http://links.twibright.com/download/$name-$version.tar.bz2
    links-2.30-gcc16-const-fix.patch
)

pkg_build() {

	./configure --prefix=/usr --mandir=/usr/share/man
	make
	make DESTDIR=$PKG install
install -v -d -m755 $PKG/usr/share/doc/links-2.29 &&
install -v -m644 doc/links_cal/* KEYS BRAILLE_HOWTO \
    $PKG/usr/share/doc/links-2.29
}
