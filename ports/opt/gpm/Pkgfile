# Description: Mouse server for the Linux virtual console
# URL: https://www.nico.schottelius.org/software/gpm/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on:

name=gpm
version=1.20.7
release=2

source=(
    https://anduin.linuxfromscratch.org/BLFS/gpm/$name-$version.tar.bz2
    https://www.linuxfromscratch.org/patches/blfs/svn/gpm-1.20.7-consolidated-1.patch
    https://www.linuxfromscratch.org/patches/blfs/svn/gpm-1.20.7-gcc15_fixes-1.patch
)

build_opt="--prefix=/usr
           --sysconfdir=/etc"

pre_build() {
    ./autogen.sh
}

post_build() {
    rm -f "$PKG/usr/lib/libgpm.a"

    ln -sfn \
        libgpm.so.2.1.0 \
        "$PKG/usr/lib/libgpm.so"

    install -d -m 0755 \
        "$PKG/etc"

    install -m 0644 \
        conf/gpm-root.conf \
        "$PKG/etc/gpm-root.conf"

    install -d -m 0755 \
        "$PKG/usr/share/doc/$name-$version/support"

    install -m 0644 \
        doc/support/* \
        "$PKG/usr/share/doc/$name-$version/support/"

    install -m 0644 \
        doc/FAQ \
        doc/HACK_GPM \
        doc/README* \
        "$PKG/usr/share/doc/$name-$version/"

    install -d -m 0755 \
        "$PKG/usr/lib/systemd/system"

    cat > "$PKG/usr/lib/systemd/system/gpm.service" <<'EOF'
[Unit]
Description=General Purpose Mouse daemon
Documentation=man:gpm(8)
After=systemd-udev-settle.service
ConditionPathExists=/dev/input/mice

[Service]
Type=forking
ExecStart=/usr/sbin/gpm -m /dev/input/mice -t imps2
PIDFile=/run/gpm.pid

[Install]
WantedBy=multi-user.target
EOF
}
