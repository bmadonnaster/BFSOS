# Description: Provides a way to load and enumerate PKCS #11 modules.
# URL: https://p11-glue.github.io/p11-glue/p11-kit.html
# Maintainer: Brian Madonna email bmadonnaster@gmail.com
# Depends on: libtasn1 make-ca
# Optional: libffi nss

name=p11-kit
version=0.26.4
release=1

source=(
    https://github.com/p11-glue/$name/releases/download/$version/$name-$version.tar.xz
)

build_opt=(
    --prefix=/usr
    --libdir=/usr/lib
    --libexecdir=/usr/libexec
    --sysconfdir=/etc
    --buildtype=release
    -Dtrust_module=enabled
    -Dtrust_paths=/etc/pki/anchors:/usr/share/pki/anchors
    -Dsystemd=disabled
    -Dbash_completion=enabled
    -Dzsh_completion=disabled
    -Dgtk_doc=false
    -Dman=false
    -Dnls=true
    -Dtest=false
    -Dpost_install_test=false
)

pkg_build() {
    meson setup \
        p11-build \
        "${build_opt[@]}"

    ninja -C p11-build

    DESTDIR="$PKG" \
        ninja -C p11-build install
}

post_build() {
    local compat_script="$PKG/usr/libexec/p11-kit/trust-extract-compat"

    # Replace upstream's compatibility helper with the BFS make-ca workflow.
    install -Dm755 /dev/stdin "$compat_script" <<'EOF'
#!/bin/sh
set -e

# Copy locally-added and removed trust anchors into the make-ca layout.
/usr/libexec/make-ca/copy-trust-modifications

# Rebuild the system trust stores.
/usr/sbin/make-ca -r
EOF

    # Debian-style compatibility command used by some packages.
    mkdir -p "$PKG/usr/bin"
    ln -sfn \
        ../libexec/p11-kit/trust-extract-compat \
        "$PKG/usr/bin/update-ca-certificates"

    # Allow NSS consumers to use the p11-kit trust module.
    mkdir -p "$PKG/usr/lib"
    ln -sfn \
        ./pkcs11/p11-kit-trust.so \
        "$PKG/usr/lib/libnssckbi.so"

    # Remove libtool archive files if any are installed.
    find "$PKG" -type f -name '*.la' -delete

    rm -rf \
        "$PKG/usr/share/doc" \
        "$PKG/usr/share/gtk-doc"
}
