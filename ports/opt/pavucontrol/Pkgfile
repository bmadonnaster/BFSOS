# Description: GTK volume control for PulseAudio-compatible sound servers
# URL: https://freedesktop.org/software/pulseaudio/pavucontrol/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: gtkmm json-glib libsigc++ pulseaudio
# Optional: libcanberra lynx

name=pavucontrol
version=6.2
release=2

source=(
    https://www.freedesktop.org/software/pulseaudio/pavucontrol/$name-$version.tar.xz
)

build_opt=(
    -Dlynx=disabled
)

pre_build() {
    if prt-get isinst libcanberra >/dev/null 2>&1; then
        build_opt+=( -Daudio-feedback=enabled )
    else
        build_opt+=( -Daudio-feedback=disabled )
    fi
}
