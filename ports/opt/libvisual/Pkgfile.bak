# Description: Libvisual Audio Visualization
# URL: https://github.com/Libvisual/libvisual
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: sdl12-compat

name=libvisual
version=plugins-0.4.2
release=1

source=(
  https://github.com/Libvisual/libvisual/releases/download/$name-$version/$name-$version.tar.bz2
)

pkg_build() {
  ./configure \
    --prefix=/usr \
    --enable-extra-optimization \
    --disable-examples \
    --disable-nls || return 1

  make -j "${JOBS:-1}" || return 1
  make DESTDIR="$PKG" install || return 1
}
