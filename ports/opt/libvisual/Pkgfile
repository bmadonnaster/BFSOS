# Description: Libvisual audio visualization framework
# URL: https://github.com/Libvisual/libvisual
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on:

name=libvisual
version=0.4.2
release=2

source=(
    https://github.com/Libvisual/libvisual/releases/download/libvisual-$version/libvisual-$version.tar.bz2
)

pkg_build() {
    ./configure \
        --prefix=/usr \
        --libdir=/usr/lib \
        --enable-extra-optimization \
        --disable-examples \
        --disable-nls || return 1

    make -j "${JOBS:-1}" || return 1
    make DESTDIR="$PKG" install || return 1
}
