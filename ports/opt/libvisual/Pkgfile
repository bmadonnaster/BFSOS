name=libvisual
version=0.4.2
release=1
source=(https://github.com/Libvisual/libvisual/releases/download/$name-$version/$name-$version.tar.bz2)

build() {
  cd $name-$version

  ./configure \
    --prefix=/usr \
    --enable-extra-optimization \
    --disable-examples \
    --disable-nls

  make
  make DESTDIR=$PKG install
}
