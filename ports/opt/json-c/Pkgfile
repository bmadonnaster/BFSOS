name=json-c
version=0.17
release=1
source=(https://s3.amazonaws.com/json-c_releases/releases/json-c-$version.tar.gz)

build() {
	cd $name-$version

	mkdir build &&
	cd    build &&

cmake -DCMAKE_INSTALL_PREFIX=/usr \
      -DCMAKE_BUILD_TYPE=Release \
      -DBUILD_STATIC_LIBS=OFF    \
      .. &&
make
doxygen doc/Doxyfile
	make DESTDIR=$PKG install
}
