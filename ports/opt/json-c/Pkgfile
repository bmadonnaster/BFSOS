# Description: JSON-C implements a reference-counted JSON object model and parser for C.
# URL: https://github.com/json-c/json-c
# Maintainer: Brian Madonna email bmadonnaster@gmail.com
# Depons on: cmake

name=json-c
version=0.19
release=1

source=(
    https://github.com/json-c/json-c/archive/refs/tags/json-c-$version-20260627.tar.gz
)

build_opt=(
    -DCMAKE_INSTALL_PREFIX=/usr
    -DCMAKE_INSTALL_LIBDIR=lib
    -DCMAKE_BUILD_TYPE=Release
    -DBUILD_SHARED_LIBS=ON
    -DBUILD_STATIC_LIBS=OFF
    -DBUILD_TESTING=OFF
    -DDISABLE_WERROR=ON
)

pkg_build() {
    cmake \
        -S . \
        -B build \
        "${build_opt[@]}"

    cmake --build build

    DESTDIR="$PKG" cmake --install build

    rm -rf "$PKG/usr/share/doc"
}
