# Description: Ruby interpreter
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: libyaml graphviz rustc valgrind

name=ruby
version=4.0.9
release=1
source=(https://cache.ruby-lang.org/pub/${name}/4.0/${name}-${version}.tar.xz)
build_opt="-prefix=/usr
            --disable-rpath
            --enable-shared
            --with-valgrind
            --without-baseruby
            ac_cv_func_qsort_r=no
            --docdir=/usr/share/doc/$name-$version"
