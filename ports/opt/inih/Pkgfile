name=inih
version=58
release=1
source=(https://github.com/benhoyt/inih/archive/r$version/$name-r$version.tar.gz)

build() {
	cd $name-r$version

	mkdir build &&
	cd    build &&

meson setup --prefix=/usr --buildtype=release .. &&
ninja
	DESTDIR=$PKG ninja install
}
