# Description: Fast JSON parser and generator for C++
# URL: https://github.com/Tencent/rapidjson
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: cmake

name=rapidjson
version=2025.08.25
release=1
source=(https://github.com/Tencent/rapidjson/archive/refs/heads/master.tar.gz)

build_opt="-DCMAKE_INSTALL_PREFIX=/usr
           -DCMAKE_BUILD_TYPE=Release
           -DRAPIDJSON_BUILD_DOC=OFF
           -DRAPIDJSON_BUILD_EXAMPLES=OFF
           -DRAPIDJSON_BUILD_TESTS=OFF
           -DCMAKE_POLICY_VERSION_MINIMUM=3.5"
