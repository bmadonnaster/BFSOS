# Description: Hierarchical, reference counted memory pool system with destructors
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: 

name=talloc
version=2.5.0
release=1
source=(https://www.samba.org/ftp/${name}/${name}-${version}.tar.gz)
post_build() {
    # Samba already owns the Python talloc binding.
    # Prevent duplicate package ownership.
    find "$PKG/usr/lib" \
        -path '*/site-packages/talloc.cpython-*.so' \
        -type f -delete
}
