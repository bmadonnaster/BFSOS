name=libdvdnav
version=6.1.1
release=1
source=(https://download.videolan.org/pub/videolan/$name/$version/$name-$version.tar.bz2)

build() {
	cd $name-$version

	./configure --prefix=/usr    \
            --disable-static \
            --docdir=/usr/share/doc/libdvdnav-$version &&
make


	make DESTDIR=$PKG install
}
