name=neon
version=0.33.0
release=1
source=(https://notroj.github.io/$name/$name-$version.tar.gz)

pkg_build() {


	./configure --prefix=/usr    \
            --with-ssl       \
            --enable-shared  \
            --disable-static &&
make

	make DESTDIR=$PKG install
}
