# Description: Qt 5 WebEngine module
# URL: https://doc.qt.io/qt-5/qtwebengine-index.html
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: qt5 bison flex gperf nodejs nss pciutils python3 python3-html5lib
# Optional: alsa-lib pulseaudio

name=qtwebengine5
version=5.15.19
release=1

source=(
    https://download.qt.io/archive/qt/5.15/$version/submodules/qtwebengine-everywhere-opensource-src-$version.tar.xz
    https://deb.debian.org/debian/pool/main/q/qtwebengine-opensource-src/qtwebengine-opensource-src_5.15.19+dfsg2-6.debian.tar.xz
)

renames=(
    SKIP
    qtwebengine-debian-patches.xzblob
)

apply_qtwebengine5_compat_patches() {
    local patchroot pfile

    rm -rf "$SRC/qtwebengine-debian"
    mkdir -p "$SRC/qtwebengine-debian" || return 1

    tar -xJf "$SRC/qtwebengine-debian-patches.xzblob" \
        -C "$SRC/qtwebengine-debian" || return 1

    patchroot="$SRC/qtwebengine-debian/debian/patches"
    for pfile in \
        python3.13-pipes.patch \
        build-with-c++17.patch \
        ninja-1.12.patch \
        gcc-15.patch \
        icu-78.patch \
        glibc-2.43.patch
    do
        if [ ! -f "$patchroot/$pfile" ]; then
            echo "qtwebengine5: required compatibility patch missing: $pfile" >&2
            return 1
        fi
        echo "qtwebengine5: applying compatibility patch $pfile"
        patch -Np1 < "$patchroot/$pfile" || return 1
    done
}

pkg_build() {
    export QT5DIR=/opt/qt5
    export PATH="$QT5DIR/bin:$PATH"
    export PKG_CONFIG_PATH="$QT5DIR/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"

    [ -x "$QT5DIR/bin/qmake" ] || {
        echo "qtwebengine5: $QT5DIR/bin/qmake is required" >&2
        return 1
    }

    apply_qtwebengine5_compat_patches || return 1

    "$QT5DIR/bin/qmake" . || return 1
    make -j "${JOBS:-1}" || return 1
    make -j1 INSTALL_ROOT="$PKG" install || return 1

    find "$PKG$QT5DIR" -name '*.prl' \
        -exec sed -i '/^QMAKE_PRL_BUILD_DIR/d' {} \; || return 1
}
