# Description: Frei0r is a minimalistic plugin API for video effects. Note that the 0 in the name is a zero, not a capital letter o.
# URL:         https://files.dyne.org/frei0r/
# Maintainer: Brian Madonna email bmadonnaster@gmail.com
# Depends on:  gavl
# Optional: doxygen opencv

name=frei0r-plugins
version=3.2.3
release=2
source=(https://github.com/dyne/frei0r/archive/refs/tags/v$version.tar.gz)

pkg_build() {

	mkdir -vp build &&
cd        build &&

cmake -DCMAKE_INSTALL_PREFIX=/usr \
      -DCMAKE_BUILD_TYPE=Release  \
      -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
      -Wno-dev ..                 &&


make
	make DESTDIR=$PKG install
}
