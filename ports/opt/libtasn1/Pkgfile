# Description: Highly portable C library for encoding and decoding DER/BER data using ASN.1 schemas.
# URL: https://www.gnu.org/software/libtasn1/
# Maintainer: Brian Madonna email bmadonnaster@gmail.com
# Optional: gtk-doc valgrind

name=libtasn1
version=4.21.0
release=1

source=(
    https://ftp.gnu.org/gnu/libtasn1/$name-$version.tar.gz
)

post_build() {
    rm -f "$PKG/usr/share/info/dir"

    find "$PKG" -type f -name '*.la' -delete
}
