# Description: SMB/CIFS client mount helpers and utilities
# URL: https://wiki.samba.org/index.php/LinuxCIFS_utils
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: talloc
# Optional: keyutils krb5 libcap-ng linux-pam python3-docutils samba

name=cifs-utils
version=7.8
release=1
source=(https://www.samba.org/ftp/linux-cifs/cifs-utils/cifs-utils-$version.tar.bz2)

build_opt="--disable-pam"

pre_build() {
    # Upstream requires autoreconf with modern GCC/autotools combinations.
    autoreconf -fiv || return 1
}
