name=libatasmart
version=0.19
release=1
source=(https://0pointer.de/public/$name-$version.tar.xz)

build() {
	cd $name-$version

	./configure --prefix=/usr --disable-static &&
make

	make docdir=/usr/share/doc/$name-$version DESTDIR=$PKG install
}
