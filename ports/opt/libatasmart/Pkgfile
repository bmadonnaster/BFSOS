# Description: The libatasmart package is a disk reporting library. It only supports a subset of the ATA S.M.A.R.T. functionality.
# URL:          https://0pointer.de/public/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on:

name=libatasmart
version=0.19
release=1
source=(${name}-${version}.tar.xz::https://deb.debian.org/debian/pool/main/liba/libatasmart/libatasmart_${version}.orig.tar.xz)

pkg_build() {

	./configure --prefix=/usr --disable-static &&
make

	make docdir=/usr/share/doc/$name-$version DESTDIR=$PKG install
}
