name=mlt
version=7.32.0
release=1
source=(https://github.com/mltframework/$name/releases/download/v$version/$name-$version.tar.gz)
pkg_build () {
mkdir build &&
cd    build &&

cmake -D CMAKE_INSTALL_PREFIX=/usr \
      -D CMAKE_BUILD_TYPE=Release  \
      -D MOD_QT=OFF                \
      -D MOD_QT6=ON                \
      -W no-dev .. &&
make 
make install
}
