# Description: LLVM linker
# URL: https://lld.llvm.org/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: llvm

name=lld
version=23.1.1
release=2
source=(https://github.com/llvm/llvm-project/releases/download/llvmorg-$version/llvm-project-$version.src.tar.xz)

build_type=cmake_build
srcdir=llvm-project-$version.src/lld

build_opt=(
    -DLLVM_INCLUDE_TESTS=OFF
    -DLLVM_INCLUDE_EXAMPLES=OFF
    -DLLVM_INCLUDE_BENCHMARKS=OFF
)
