# Description: reimplementation of the SIL Graphite text processing engine.
# URL: https://github.com/silnrsi/graphite
# Maintainer: Brian Madonna email bmadonnaster@gmail.com
# Depends on: freetype cmake
# Optional: asciidoc dblatex doxygen graphviz

name=graphite2
version=1.3.14
release=2
source=(https://github.com/silnrsi/graphite/releases/download/$version/$name-$version.tgz
        graphite2-1.3.14-gcc16-cstdint.patch)

pkg_build() {
  sed -i '/cmptest/d' tests/CMakeLists.txt

 	mkdir build &&
	cd    build &&

cmake -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_POLICY_VERSION_MINIMUM=3.5 .. &&
make


 make DESTDIR=$PKG install
}
