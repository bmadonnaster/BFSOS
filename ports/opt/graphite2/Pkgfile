# Description: reimplementation of the SIL Graphite text processing engine.
# URL: https://github.com/silnrsi/graphite
# Maintainer: Brian Madonna email bmadonnaster@gmail.com
# Depends on: freetype cmake
# Optional: asciidoc dblatex doxygen graphviz

name=graphite2
version=1.3.14
release=3
source=(https://github.com/silnrsi/graphite/releases/download/$version/$name-$version.tgz)

pkg_build() {
    # Current BLFS compatibility fixes for CMake 4 and modern GCC.
    sed -i '/cmake_policy(SET CMP0012 NEW)/d' CMakeLists.txt
    sed -i 's/PythonInterp/Python3/' CMakeLists.txt
    find . -name CMakeLists.txt \
        -exec sed -i 's/VERSION 2\.8\.0 FATAL_ERROR/VERSION 4.0.0/' {} +

    sed -i '/Font.h/i #include <cstdint>' \
        tests/featuremap/featuremaptest.cpp

    # Avoid tests requiring optional FontTools during package build.
    sed -i '/cmptest/d' tests/CMakeLists.txt

    cmake -S . -B build \
        -DCMAKE_INSTALL_PREFIX=/usr

    cmake --build build

    DESTDIR="$PKG" cmake --install build
}
