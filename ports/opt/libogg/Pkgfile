name=libogg
version=1.3.5
release=1
source=(https://downloads.xiph.org/releases/ogg/$name-$version.tar.xz)

build() {
  cd $name-$version

  ./configure --prefix=/usr    \
            --disable-static \
            --docdir=/usr/share/doc/$name-$version &&
make
  make DESTDIR=$PKG install


}
