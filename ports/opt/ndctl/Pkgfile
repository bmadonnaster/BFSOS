# Description: Utility library for managing the libnvdimm and CXL subsystems in the Linux kernel
# URL: https://github.com/pmem/ndctl
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: iniparser json-c keyutils meson ninja libtraceevent
# Optional: libtracefs bash-completion asciidoctor

name=ndctl
version=85
release=1
source=(https://github.com/pmem/ndctl/archive/refs/tags/v$version.tar.gz)
renames=(ndctl-$version.tar.gz)

pkg_build() {
    local tracefs_opt="disabled"

    if prt-get isinst libtracefs >/dev/null 2>&1; then
        tracefs_opt="enabled"
    fi

    meson setup build \
        --prefix=/usr \
        --buildtype=plain \
        --wrap-mode=nodownload \
        -Db_lto=false \
        -Db_pie=true \
        -Dversion-tag="$version" \
        -Dasciidoctor=disabled \
        -Ddocs=disabled \
        -Dsystemd=enabled \
        -Dlibtracefs="$tracefs_opt" || return 1

    meson compile -C build -j "${JOBS:-1}" || return 1

    DESTDIR="$PKG" \
        meson install -C build || return 1

    if ! prt-get isinst bash-completion >/dev/null 2>&1; then
        rm -rf "$PKG/usr/share/bash-completion"
    fi
}
