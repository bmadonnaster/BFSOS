#!/bin/sh
# Apply BFSOS's system-wide user-unit defaults so both existing and newly
# created users inherit working PipeWire/PipeWire-Pulse/WirePlumber audio.
if command -v systemctl >/dev/null 2>&1; then
    systemctl --global preset pipewire.socket pipewire-pulse.socket wireplumber.service || exit $?
fi
exit 0
