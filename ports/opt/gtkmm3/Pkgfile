# Description: A C++ wrapper for GTK3+
# URL: https://www.gtkmm.org/en/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: atkmm cairomm-1.0 glibmm-2.4 gtk3 pangomm

name=gtkmm3
version=3.24.11
release=3
source=(https://download.gnome.org/sources/gtkmm/${version%.*}/gtkmm-$version.tar.xz)

pkg_build() {
  meson setup gtkmm-$version build \
    --prefix=/usr \
    --sysconfdir=/etc \
    --buildtype=plain \
    --wrap-mode nodownload \
    -D b_lto=true \
    -D b_pie=true \
    -D build-demos=false \
    -D build-tests=false
  meson compile -C build
  DESTDIR=$PKG meson install -C build
}
