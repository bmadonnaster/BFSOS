# Description: RPC program number to universal address mapper
# URL: https://sourceforge.net/projects/rpcbind/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: libtirpc systemd

name=rpcbind
version=1.2.9
release=1
source=(https://downloads.sourceforge.net/project/rpcbind/rpcbind/$version/rpcbind-$version.tar.bz2)

build_opt="--with-systemdsystemunitdir=/usr/lib/systemd/system --enable-warmstarts"

post_build() {
    install -d "$PKG/var/lib/rpcbind" || return 1
}
