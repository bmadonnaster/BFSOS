# Description: C++ barcode image processing library
# URL: https://github.com/zxing-cpp/zxing-cpp
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: cmake

name=zxing-cpp
version=3.1.1
release=2
source=(https://github.com/zxing-cpp/zxing-cpp/releases/download/v$version/zxing-cpp-$version.tar.gz)

build_opt="-DCMAKE_INSTALL_PREFIX=/usr
           -DCMAKE_BUILD_TYPE=Release
           -DZXING_C_API=OFF
           -DZXING_EXAMPLES=OFF
           -DZXING_EXAMPLES_QT=OFF
           -DZXING_BLACKBOX_TESTS=OFF
           -DZXING_UNIT_TESTS=OFF
           -DZXING_PYTHON_MODULE=OFF
           -DZXING_READERS=ON
           -DZXING_WRITERS=BOTH"
