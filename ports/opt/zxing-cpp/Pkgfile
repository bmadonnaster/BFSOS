# Description: C++ barcode image processing library
# URL: https://github.com/zxing-cpp/zxing-cpp
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: cmake

name=zxing-cpp
version=3.1.1
release=1
source=(https://github.com/zxing-cpp/zxing-cpp/releases/download/v$version/zxing-cpp-$version.tar.gz)

build_opt="-DCMAKE_INSTALL_PREFIX=/usr
           -DCMAKE_BUILD_TYPE=Release
           -DBUILD_EXAMPLES=OFF
           -DBUILD_BLACKBOX_TESTS=OFF
           -DZXING_EXAMPLES=OFF
           -DZXING_READERS=ON
           -DZXING_WRITERS=BOTH"
