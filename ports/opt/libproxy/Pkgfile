# Description: Automatic proxy configuration management library
# URL: https://libproxy.github.io/libproxy/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: curl duktape glib meson ninja gsettings-desktop-schemas

name=libproxy
version=0.5.12
release=3
source=(https://github.com/libproxy/libproxy/archive/refs/tags/$version.tar.gz)

pkg_build() {
    meson setup build \
        --prefix=/usr \
        --buildtype=release \
        -Dtests=false \
        -Ddocs=false || return 1
    meson compile -C build || return 1
    DESTDIR="$PKG" meson install -C build || return 1
}
