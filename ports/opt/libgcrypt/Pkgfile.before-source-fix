# Description: General-purpose cryptographic library used by GnuPG and other applications.
# URL: https://www.gnupg.org/software/libgcrypt/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: libgpg-error

name=libgcrypt
version=1.12.3
release=1

source=(
    https://mirrors.dotsrc.org/gcrypt/libgcrypt/$name-$version.tar.bz2
)

build_opt=(
    --prefix=/usr
)

pkg_build() {
    ./configure "${build_opt[@]}"

    make
    make DESTDIR="$PKG" install

    # BFS does not package GNU info pages.
    rm -rf "$PKG/usr/share/info"
}
