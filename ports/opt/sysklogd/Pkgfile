# Description: Kernel and system logging daemons
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
name=sysklogd
version=2.8.0
release=1
source=(https://github.com/troglobit/sysklogd/releases/download/v$version/sysklogd-$version.tar.gz
	sysklogd.run)
sv=($name.run)
build_opt="--without-logger"

post_build() {
	install -Dm644 syslog.conf $PKG/etc/syslog.conf
}
