# Description: XML to PO and back again
# URL: https://itstool.org/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: docbook-xml python3-lxml

name=itstool
version=2.0.7
release=4
source=(https://github.com/itstool/itstool/archive/$version/$name-$version.tar.gz
  itstool-2.0.7-lxml-1.patch)


pkg_build() {
  PYTHON=/usr/bin/python3 \
  ./autogen.sh --prefix=/usr
  make
  make DESTDIR=$PKG install
}
