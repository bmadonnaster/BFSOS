name=libass
version=0.17.3
release=1
source=(https://github.com/$name/$name/releases/download/$version/$name-$version.tar.gz)

build() {
  cd $name-$version
  	./configure --prefix=/usr --disable-static &&
	make
  make DESTDIR=$PKG install
}
