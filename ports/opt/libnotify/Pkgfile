# Description: Desktop notification library
# URL: https://gitlab.gnome.org/GNOME/libnotify
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: gdk-pixbuf
# Optional: gtk4 gobject-introspection gi-docgen xmlto notification-daemon xfce4-notifyd lxqt-notificationd

name=libnotify
version=0.8.9
release=1
source=(https://download.gnome.org/sources/$name/0.8/$name-$version.tar.xz)

pkg_build() {
  meson setup build . \
      --prefix=/usr \
      --buildtype=release \
      -Dgtk_doc=false \
      -Dman=false \
      -Dtests=false || return 1

  meson compile -C build -j "${JOBS:-1}" || return 1
  DESTDIR="$PKG" meson install -C build || return 1

  if [ -e "$PKG/usr/share/doc/$name" ]; then
    rm -rf "$PKG/usr/share/doc/$name-$version"
    mv -v "$PKG/usr/share/doc/$name" "$PKG/usr/share/doc/$name-$version" || return 1
  fi
}
