# Description: C++ and Python library of 2D/3D vector, matrix, math, and utility classes
# URL: https://github.com/AcademySoftwareFoundation/Imath
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: cmake

name=imath
version=3.2.3
release=1
source=(https://github.com/AcademySoftwareFoundation/Imath/archive/refs/tags/v$version.tar.gz)

build_opt="-DCMAKE_INSTALL_PREFIX=/usr
           -DCMAKE_BUILD_TYPE=Release
           -DBUILD_TESTING=OFF
           -DIMATH_INSTALL_PKG_CONFIG=ON"
