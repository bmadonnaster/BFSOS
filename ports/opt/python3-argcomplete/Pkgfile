# Description: Bash and Zsh tab completion for Python argparse
# URL: https://github.com/kislyuk/argcomplete
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: python3 python3-hatchling python3-hatch-vcs

name=python3-argcomplete
version=3.7.1
release=1

source=(https://files.pythonhosted.org/packages/source/a/argcomplete/argcomplete-$version.tar.gz)

pkg_build() {
    python3 -m pip wheel \
        --no-deps \
        --no-build-isolation \
        . -w dist || return 1

    python3 -m pip install \
        --no-deps \
        --no-index \
        --no-cache-dir \
        --root="$PKG" \
        --prefix=/usr \
        dist/*.whl || return 1
}
