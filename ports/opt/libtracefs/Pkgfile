# Description: Linux kernel trace file system library
# URL: https://git.kernel.org/pub/scm/libs/libtrace/libtracefs.git/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: libtraceevent meson ninja
# Optional: asciidoc xmlto

name=libtracefs
version=1.8.3
release=1
source=(https://git.kernel.org/pub/scm/libs/libtrace/libtracefs.git/snapshot/libtracefs-$version.tar.gz)

pkg_build() {
    local doc_opt="-Ddoc=false"

    if prt-get isinst asciidoc >/dev/null 2>&1 &&
       prt-get isinst xmlto >/dev/null 2>&1; then
        doc_opt="-Ddoc=true"
    fi

    meson setup build \
        --prefix=/usr \
        --buildtype=plain \
        --wrap-mode=nodownload \
        -Db_lto=true \
        -Db_pie=true \
        "$doc_opt" || return 1

    meson compile -C build -j "${JOBS:-1}" || return 1

    DESTDIR="$PKG" \
        meson install -C build || return 1

    rm -rf "$PKG/usr/share/doc"
}
