# Description: Sandboxed and extensible image loading framework used by modern GNOME applications
# URL: https://gitlab.gnome.org/GNOME/glycin
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: bubblewrap fontconfig glib lcms2 libseccomp libjxl librsvg rustc
# Optional: libheif vala python3-gi_docgen gtk4

name=glycin
version=2.1.5
release=1
source=(https://download.gnome.org/sources/$name/${version%.*}/$name-$version.tar.xz)

pkg_build() {
    # Current glycin needs this bootstrap fix when no older system libglycin
    # is available yet. This mirrors the current BLFS bootstrap workaround.
    sed -e "s/get_option('libglycin-gtk4')/(& or get_option('glycin-thumbnailer'))/" \
        -i meson.build || return 1

    meson setup build . \
        --prefix=/usr \
        --buildtype=release \
        --wrap-mode=nodownload \
        -Dlibglycin-gtk4=false \
        -Dtests=false \
        -Dcapi_docs=false \
        -Dglycin-loaders=glycin-image-rs,glycin-jxl,glycin-svg \
        || return 1

    meson compile -C build -j "${JOBS:-1}" || return 1
    DESTDIR="$PKG" meson install -C build || return 1
}
