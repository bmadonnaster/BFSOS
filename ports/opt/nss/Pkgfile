# Depends on: nspr sqlite zlib

name=nss
version=3.127
release=4
source=(https://archive.mozilla.org/pub/security/nss/releases/NSS_${version//./_}_RTM/src/nss-$version.tar.gz
        nss-3.54-standalone-2.patch
        nss-config.in
        nss.pc.in
        nss-softokn.pc.in
        nss-util.pc.in)

pkg_build() {
    cd nss || return 1

    make         BUILD_OPT=1         NSPR_INCLUDE_DIR=/usr/include/nspr         USE_SYSTEM_ZLIB=1         ZLIB_LIBS=-lz         NSS_ENABLE_WERROR=0         USE_64=1         NSS_USE_SYSTEM_SQLITE=1 || return 1

    cd ../dist || return 1

    mkdir -p         "$PKG/usr/lib"         "$PKG/usr/bin"         "$PKG/usr/lib/pkgconfig"         "$PKG/usr/include/nss" || return 1

    install -v -m755 Linux*/lib/*.so "$PKG/usr/lib" || return 1
    install -v -m644 Linux*/lib/*.chk "$PKG/usr/lib" || return 1

    cp -v -RL public/nss/* "$PKG/usr/include/nss" || return 1
    cp -v -RL private/nss/* "$PKG/usr/include/nss" || return 1

    install -v -m755 Linux*/bin/certutil "$PKG/usr/bin" || return 1
    install -v -m755 Linux*/bin/nss-config "$PKG/usr/bin" || return 1
    install -v -m755 Linux*/bin/pk12util "$PKG/usr/bin" || return 1

    install -v -m644 Linux*/lib/pkgconfig/nss.pc         "$PKG/usr/lib/pkgconfig" || return 1
}
