# Description: Toolkit for managing virtualization hosts
# URL: https://libvirt.org/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: json-c dbus dnsmasq glib gnutls libcap-ng libnl libpcap libseccomp libssh2 libxml2 libxslt nftables parted polkit qemu readline systemd yajl

name=libvirt
version=12.7.0
release=3
source=(
    https://download.libvirt.org/libvirt-$version.tar.xz
    default-network.xml
)

# Upstream recommends -Dsystem=true for distro/vendor layouts. Explicitly
# require the drivers BFSOS needs so a missing dependency fails at configure.
build_opt=(
    -Dsystem=true
    -Ddriver_libvirtd=enabled
    -Ddriver_qemu=enabled
    -Ddriver_network=enabled
    -Ddriver_secrets=enabled
    -Dstorage_dir=enabled
    -Dstorage_fs=enabled
    -Dstorage_disk=enabled
    -Dstorage_lvm=enabled
    -Dstorage_scsi=enabled
    -Dtests=disabled
)

post_build() {
    # Ship a deterministic default NAT network instead of relying on an
    # upstream sample file being present in a particular release.
    install -Dm644 "$SRC/default-network.xml"         "$PKG/etc/libvirt/qemu/networks/default.xml" || return 1
    install -d "$PKG/etc/libvirt/qemu/networks/autostart" || return 1
    ln -sf ../default.xml         "$PKG/etc/libvirt/qemu/networks/autostart/default.xml" || return 1
}
