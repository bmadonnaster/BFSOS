# Description: Editorial timeline interchange format and API
# URL: https://github.com/AcademySoftwareFoundation/OpenTimelineIO
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: imath rapidjson

name=opentimelineio
version=0.18.1
release=4
source=(https://github.com/AcademySoftwareFoundation/OpenTimelineIO/archive/refs/tags/v$version.tar.gz)

pkg_build() {
    cmake -B build -S . \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_BUILD_TYPE=Release \
        -DOTIO_CXX_INSTALL=ON \
        -DOTIO_PYTHON_INSTALL=OFF \
        -DOTIO_FIND_IMATH=ON \
        -DOTIO_FIND_RAPIDJSON=ON \
        -DOTIO_AUTOMATIC_SUBMODULES=OFF \
        -DOTIO_DEPENDENCIES_INSTALL=OFF \
        -DBUILD_TESTING=OFF || return 1

    cmake --build build -j${JOBS:-1} || return 1
    DESTDIR="$PKG" cmake --install build || return 1
}
