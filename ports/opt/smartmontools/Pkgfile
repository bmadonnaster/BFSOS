name=smartmontools
version=7.4
release=1
source=(https://downloads.sourceforge.net/$name/$name-$version.tar.gz)

build() {
	cd $name-$version

	./configure --prefix=/usr           \
            --sysconfdir=/etc       \
            --docdir=/usr/share/doc/$name-$version &&
make
	make DESTDIR=$PKG install
}
