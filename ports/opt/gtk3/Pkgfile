# Description: A multi-platform toolkit for creating graphical user interfaces
# URL: https://www.gtk.org/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: at-spi2-core gdk-pixbuf libepoxy pango libxkbcommon
# Optional: colord cups wayland-protocols

name=gtk3
version=3.24.52
release=4

source=(
  https://download.gnome.org/sources/gtk/3.24/gtk-$version.tar.xz
)

build_opt=(
  -Dman=true
  -Dbroadway_backend=true
  -Dtests=false
  -Dinstalled_tests=false
)

pre_build() {
  if ! prt-get isinst colord >/dev/null 2>&1; then
    build_opt+=(
      -Dcolord=no
    )
  fi

  if prt-get isinst libxkbcommon >/dev/null 2>&1 &&
     prt-get isinst wayland-protocols >/dev/null 2>&1; then
    build_opt+=(
      -Dwayland_backend=true
    )
  else
    build_opt+=(
      -Dwayland_backend=false
    )
  fi
}
