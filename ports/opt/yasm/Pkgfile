name=yasm
version=1.3.0
release=2
source=(https://www.tortall.net/projects/yasm/releases/$name-$version.tar.gz)

build () {
	cd $name-$version
	sed -i 's#) ytasm.*#)#' Makefile.in &&
	./configure --prefix=/usr

	make
	make DESTDIR=$PKG install
}
