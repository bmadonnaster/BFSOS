# Description: APR-util provides a number of helpful abstractions on top of APR
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: apr

name=apr-util
version=1.6.5
release=2
source=(https://archive.apache.org/dist/apr/${name}-${version}.tar.bz2)
build_opt="--prefix=/usr
            --with-apr=/usr
            --with-gdbm=/usr
            --with-openssl=/usr
            --with-crypto"
