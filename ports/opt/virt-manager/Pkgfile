# Description: Graphical virtual machine manager for libvirt
# URL: https://virt-manager.org/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: gtk3 gtk-vnc libisoburn libosinfo libvirt libvirt-glib libvirt-python python3 python3-argcomplete python3-cairo python3-gobject python3-requests vte
# Optional: gtksourceview4 spice-gtk

name=virt-manager
version=5.1.0
release=3
source=(https://github.com/virt-manager/virt-manager/archive/refs/tags/v$version.tar.gz)

# BFSOS currently ships the VNC console path as the guaranteed baseline.
# SPICE remains optional until the complete SPICE dependency stack is present.
build_opt=(
    -Dtests=disabled
    -Dupdate-icon-cache=false
    -Dcompile-schemas=false
    -Ddefault-graphics=vnc
    -Ddefault-hvs="['qemu']"
)
