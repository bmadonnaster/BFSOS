name=gparted
version=1.5.0
release=1
source=(https://downloads.sourceforge.net/gparted/$name-$version.tar.gz)

build() {
	cd $name-$version

	./configure --prefix=/usr    \
            --disable-doc    \
            --disable-static &&
	make DESTDIR=$PKG install
}
