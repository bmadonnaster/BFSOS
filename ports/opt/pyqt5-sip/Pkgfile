# Description: The SIP extension module for PyQt5
# URL:         https://pypi.org/project/PyQt5-sip/
# Maintainer:  Brian Madonna <bmadonnaster@gmail.com>
# Depends on:  python3 python3-build python3-installer python3-setuptools python3-wheel

name=pyqt5-sip
version=12.19.0
release=1
source=(https://files.pythonhosted.org/packages/source/p/pyqt5_sip/pyqt5_sip-$version.tar.gz)

pkg_build() {
    python3 -m build --wheel --no-isolation || return 1
    python3 -m installer --compile-bytecode 2 --destdir="$PKG" dist/*.whl || return 1
}
