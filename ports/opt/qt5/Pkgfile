# Description: Qt 5 compatibility framework (QtWebEngine packaged separately)
# URL: https://www.qt.io/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: alsa-lib bison dbus double-conversion flex glib gperf harfbuzz icu libinput libjpeg-turbo libmng libpng libtiff libwebp libxkbcommon mesa mtdev ninja openssl python3 sqlite xorg-libs xcb-util xcb-util-renderutil xcb-util-image xcb-util-keysyms xcb-util-wm xcb-util-cursor
# Optional: bluez cups gst-plugins-base gst-plugins-good gtk3 ibus mariadb pulseaudio unixodbc wayland-protocols
keep_static=1
name=qt5
version=5.15.19
release=12
# Keep Debian's small quilt metadata archives as opaque build inputs.  BFSOS
# uses the official complete Qt source archive, but Debian currently carries
# compatibility fixes needed by modern OpenSSL/GCC/ICU/glibc.  QtWebEngine is
# intentionally excluded here and is packaged by qtwebengine5.
source=(
    https://download.qt.io/archive/qt/5.15/$version/single/qt-everywhere-opensource-src-$version.tar.xz
    https://deb.debian.org/debian/pool/main/q/qtbase-opensource-src/qtbase-opensource-src_5.15.19+dfsg-4.debian.tar.xz
    https://deb.debian.org/debian/pool/main/q/qtlocation-opensource-src/qtlocation-opensource-src_5.15.19+dfsg-2.debian.tar.xz
    qtlocation-rapidjson-gcc16.patch.manual
)

# BFSOS pkgmk uses a parallel renames array instead of filename::URL syntax.
# Keep the Debian archives opaque so pkgmk does not unpack their debian/
# directories into the main source tree.
renames=(
    SKIP
    qtbase-debian-patches.xzblob
    qtlocation-debian-patches.xzblob
    SKIP
)

apply_qt5_compat_patches() {
    local patchroot pfile

    rm -rf "$SRC/qtbase-debian" "$SRC/qtlocation-debian"
    mkdir -p "$SRC/qtbase-debian" "$SRC/qtlocation-debian"

    tar -xJf "$SRC/qtbase-debian-patches.xzblob" \
        -C "$SRC/qtbase-debian" || return 1

    tar -xJf "$SRC/qtlocation-debian-patches.xzblob" \
        -C "$SRC/qtlocation-debian" || return 1

    # Apply the QtBase OpenSSL compatibility backports in Debian series order.
    # These are explicit so a changed/missing Debian patch fails immediately.
    patchroot="$SRC/qtbase-debian/debian/patches"
    for pfile in \
        openssl3.diff \
        asn1_time_to_tm.diff \
        openssl4.diff
    do
        if [ ! -f "$patchroot/$pfile" ]; then
            echo "qt5: required QtBase compatibility patch missing: $pfile" >&2
            return 1
        fi
        echo "qt5: applying QtBase compatibility patch $pfile"
        patch -d qtbase -Np1 < "$patchroot/$pfile" || return 1
    done

    # QtLocation 5.15 bundles an old Mapbox GL Native snapshot. Debian carries
    # the compatibility fixes needed by modern compilers/ICU. Apply the
    # relevant non-platform-specific patches in Debian series order.
    patchroot="$SRC/qtlocation-debian/debian/patches"
    for pfile in \
        mapboxgl_thread_portability.diff \
        gcc_13.diff \
        fix_appendChildNode_call.diff \
        opengl.diff \
        c++17.diff
    do
        if [ ! -f "$patchroot/$pfile" ]; then
            echo "qt5: required QtLocation compatibility patch missing: $pfile" >&2
            return 1
        fi
        echo "qt5: applying QtLocation compatibility patch $pfile"
        patch -d qtlocation -Np1 < "$patchroot/$pfile" || return 1
    done

    # GCC 16 rejects RapidJSON 1.1.0's impossible assignment operator because
    # GenericStringRef::length is const.  Keep this local compatibility patch
    # opaque to the automatic patch extension and apply it at the QtLocation
    # subtree explicitly.
    if [ ! -f "$SRC/qtlocation-rapidjson-gcc16.patch.manual" ]; then
        echo "qt5: required local QtLocation RapidJSON compatibility patch missing" >&2
        return 1
    fi
    echo "qt5: applying QtLocation RapidJSON GCC 16 compatibility patch"
    patch -d qtlocation -Np1 < "$SRC/qtlocation-rapidjson-gcc16.patch.manual" || return 1

}

pkg_build() {
    export QT5PREFIX=/opt/qt5

    apply_qt5_compat_patches || return 1

    ./configure \
        -prefix "$QT5PREFIX" \
        -sysconfdir /etc/xdg \
        -confirm-license \
        -opensource \
        -release \
        -dbus-linked \
        -openssl-linked \
        -system-harfbuzz \
        -system-sqlite \
        -skip qtwebengine \
        -nomake examples \
        -no-rpath \
        -journald || return 1

    make -j "${JOBS:-1}" || return 1
    make -j1 INSTALL_ROOT="$PKG" install || return 1

    find "$PKG$QT5PREFIX" -name '*.prl' -exec sed -i '/^QMAKE_PRL_BUILD_DIR/d' {} \;

    install -d "$PKG/etc/profile.d" "$PKG/etc/ld.so.conf.d"
    cat > "$PKG/etc/profile.d/qt5.sh" <<'EOF'
QT5DIR=/opt/qt5
pathappend "$QT5DIR/bin" PATH
pathappend "$QT5DIR/lib/pkgconfig" PKG_CONFIG_PATH
export QT5DIR
EOF
    printf '%s\n' '/opt/qt5/lib' > "$PKG/etc/ld.so.conf.d/qt5.conf"
    install -d "$PKG/usr/bin" || return 1
    for file in moc uic rcc qmake lconvert lrelease lupdate; do
        ln -sfn "/opt/qt5/bin/$file" "$PKG/usr/bin/$file-qt5" || return 1
    done
}
