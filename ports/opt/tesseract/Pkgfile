# Description: OCR engine used by KDE Spectacle text recognition
# URL: https://github.com/tesseract-ocr/tesseract
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: curl leptonica libarchive

name=tesseract
version=5.5.3
release=3

source=(
https://github.com/tesseract-ocr/tesseract/archive/refs/tags/$version.tar.gz
https://github.com/tesseract-ocr/tessdata_fast/raw/main/eng.traineddata
https://github.com/tesseract-ocr/tessdata_fast/raw/main/osd.traineddata
)

build_opt="-DBUILD_SHARED_LIBS=ON
-DBUILD_TRAINING_TOOLS=OFF
-DBUILD_TESTS=OFF"

post_build() {
        install -d "$PKG/usr/share/tessdata"
        install -m644 "$SRC/eng.traineddata" "$PKG/usr/share/tessdata/"
        install -m644 "$SRC/osd.traineddata" "$PKG/usr/share/tessdata/"
}
