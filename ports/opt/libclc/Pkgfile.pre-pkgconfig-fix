# Depends on: llvm ninja spirv-llvm-translator

name=libclc
version=23.1.1
release=2
source=(https://github.com/llvm/llvm-project/releases/download/llvmorg-$version/llvm-project-$version.src.tar.xz)

pkg_build() {
    rm -rf build

    cmake -S llvm -B build \
        -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_BUILD_TYPE=Release \
        -DLLVM_ENABLE_PROJECTS=clang \
        -DLLVM_RUNTIME_TARGETS="spirv32-unknown-unknown;spirv64-unknown-unknown" \
        -DRUNTIMES_spirv32-unknown-unknown_LLVM_ENABLE_RUNTIMES=libclc \
        -DRUNTIMES_spirv64-unknown-unknown_LLVM_ENABLE_RUNTIMES=libclc \
        || return 1

    ninja -C build -j "${JOBS:-1}" \
        runtimes-spirv32-unknown-unknown \
        runtimes-spirv64-unknown-unknown \
        || return 1

    DESTDIR="$PKG" \
        cmake -P build/runtimes/cmake_install.cmake \
        || return 1
}
