# Description: Python 3 bindings for Qt 5
# URL: https://www.riverbankcomputing.com/software/pyqt/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: python3-build python3-installer python3-pyqt-builder python3-sip qt5

name=python3-pyqt5
version=5.15.11
release=1
source=(https://files.pythonhosted.org/packages/source/P/PyQt5/PyQt5-$version.tar.gz)

pkg_build() {
    # Use the system Qt5 rather than PyPI's bundled Qt wheel.
    PATH=/opt/qt5/bin:$PATH \
      python3 -m build --wheel --skip-dependency-check --no-isolation || return 1
    python3 -m installer --compile-bytecode 2 --destdir="$PKG" dist/*.whl || return 1
}
