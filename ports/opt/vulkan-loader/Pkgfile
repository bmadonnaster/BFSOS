# Description: Vulkan ICD loader
# URL: https://github.com/KhronosGroup/Vulkan-Loader
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: cmake ninja vulkan-headers wayland xorg-libs

name=vulkan-loader
version=1.4.357.0
release=3
source=(https://github.com/KhronosGroup/Vulkan-Loader/archive/refs/tags/vulkan-sdk-${version}.tar.gz)

pkg_build() {
    cmake -S . -B build \
        -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_SKIP_RPATH=TRUE \
        -DBUILD_TESTS=OFF || return 1

    cmake --build build -j "${JOBS:-1}" || return 1

    DESTDIR="$PKG" cmake --install build || return 1

    # Vulkan-Headers is the canonical owner of the API headers, registry,
    # vk_video headers, and VulkanHeaders CMake package metadata.  The Loader
    # package must not duplicate files supplied by vulkan-headers.
    rm -rf \
        "$PKG/usr/include/vulkan" \
        "$PKG/usr/include/vk_video" \
        "$PKG/usr/share/cmake/VulkanHeaders" \
        "$PKG/usr/share/vulkan/registry"

    # BFSOS does not retain libtool archives.
    find "$PKG" -type f -name '*.la' -delete
}
