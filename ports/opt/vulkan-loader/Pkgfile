# Description: Vulkan ICD loader
# URL: https://github.com/KhronosGroup/Vulkan-Loader
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: cmake ninja vulkan-headers wayland xorg-libs

name=vulkan-loader
version=1.4.357.0
release=5
source=(https://github.com/KhronosGroup/Vulkan-Loader/archive/refs/tags/vulkan-sdk-${version}.tar.gz)
renames=(vulkan-loader-${version}.tar.gz)

pkg_build() {
    cmake -S . -B build \
        -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_SKIP_RPATH=TRUE || return 1

    cmake --build build -j "${JOBS:-1}" || return 1

    DESTDIR="$PKG" cmake --install build || return 1

    if ! find "$PKG/usr/lib" -maxdepth 1 \
        \( -name 'libvulkan.so' -o -name 'libvulkan.so.*' \) \
        -print -quit | grep -q .; then
        echo "vulkan-loader: libvulkan.so was not staged" >&2
        return 1
    fi
}
