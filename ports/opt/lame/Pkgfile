# Description: MP3 encoder
# URL:         http://lame.sourceforge.net/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on:
# Optional: dmalloc electric fence libsndfile nasm

name=lame
version=4.0
release=2
source=(http://downloads.sourceforge.net/project/$name/$name/$version/$name-$version.tar.gz
        lame-4.0-id3-utf16.patch
        lame-4.0-export-pinfo.patch)

pkg_build() {
    ./configure --prefix=/usr --enable-mp3rtp --disable-static &&
make

    make DESTDIR=$PKG pkghtmldir=/usr/share/doc/$name-$version install
}
