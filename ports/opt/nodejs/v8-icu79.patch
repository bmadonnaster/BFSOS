+const hasUnicode18 = '\u{1DF95}'.toUpperCase() === 'SS';
+
+// Exercise literals, ranges, backreferences, lookbehinds, and class strings
+// with the same case pairs.
 const pairs = [
   ['a', 'A', true, true],
   ['k', '\u212a', false, true],
@@ -12,6 +19,8 @@ const pairs = [
   ['i', '\u0130', false, false],
