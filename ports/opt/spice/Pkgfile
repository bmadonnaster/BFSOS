# Description: SPICE remote display server library
# URL: https://www.spice-space.org/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: cyrus-sasl glib libjpeg-turbo lz4 openssl opus pixman python3-pyparsing spice-protocol zlib

name=spice
version=0.16.0
release=1
source=(https://www.spice-space.org/download/releases/spice-server/spice-$version.tar.bz2)

build_opt=(
    -Dgstreamer=no
    -Dlz4=true
    -Dsasl=true
    -Dopus=enabled
    -Dsmartcard=disabled
    -Dmanual=false
    -Dtests=false
)
