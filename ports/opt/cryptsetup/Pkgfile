# Description: Cryptsetup configures encrypted block devices using dm-crypt and LUKS.
# URL: https://gitlab.com/cryptsetup/cryptsetup
# Maintainer: Brian Madonna email bmadonnaster@gmail.com
# Depends on: argon2 json-c keyutils libgcrypt
# Optional: libpwquality passwdqc

name=cryptsetup
version=2.8.7
release=1

source=(
    https://www.kernel.org/pub/linux/utils/cryptsetup/v2.8/$name-$version.tar.xz
)

build_opt=(
    --prefix=/usr
    --sbindir=/usr/bin
    --libdir=/usr/lib
    --sysconfdir=/etc
    --localstatedir=/var
    --runstatedir=/run
    --with-crypto_backend=gcrypt
    --disable-ssh-token
    --disable-asciidoc
)

pkg_build() {
    ./configure "${build_opt[@]}"

    make

    make DESTDIR="$PKG" install

    # Remove libtool archive files.
    find "$PKG" -type f -name '*.la' -delete

    # BFS does not currently package upstream documentation.
    rm -rf \
        "$PKG/usr/share/doc" \
        "$PKG/usr/share/man"

    # Remove generated GNU info index.
    rm -f "$PKG/usr/share/info/dir"
}
