# Description: Low-level audio/video support library used by multimedia applications
# URL: https://github.com/bplaum/gavl
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: gnutls libdrm libglvnd libva nettle libpng
# Optional: doxygen

name=gavl
version=2.0.1
release=1
source=(https://github.com/bplaum/gavl/archive/refs/tags/v$version.tar.gz)

pkg_build() {
    autoreconf -fi

    ./configure \
        --prefix=/usr \
        --disable-static \
        --enable-shared \
        --without-doxygen \
        --with-cpuflags=none

    make -j${JOBS:-1}
    make DESTDIR="$PKG" install
}
