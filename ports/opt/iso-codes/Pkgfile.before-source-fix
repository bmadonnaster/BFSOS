# Description: ISO Country/Language/Currency codes
# URL: https://salsa.debian.org/iso-codes-team/iso-codes
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: gettext python3 meson

name=iso-codes
version=4.20.1
release=5
source=(https://salsa.debian.org/iso-codes-team/iso-codes/-/archive/v$version/iso-codes-v$version.tar.gz)

pkg_build() {
    meson setup build . \
        --prefix=/usr \
        --buildtype=release \
        --wrap-mode=nodownload &&

    meson compile -C build -j ${JOBS:-1} &&

    DESTDIR="$PKG" meson install -C build &&

    rm -rf "$PKG/usr/share/locale"
}
