# Description: Network-related giomodules for glib
# URL: https://git.gnome.org/browse/glib-networking/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: gnutls gsettings-desktop-schemas
# Optional : make-ca

name=glib-networking
version=2.90.0
release=1
source=(https://download.gnome.org/sources/$name/2.90/$name-$version.tar.xz)

pkg_build() {

mkdir build &&
cd    build &&

meson setup            \
   --prefix=/usr       \
   --buildtype=release \
   -Dlibproxy=disabled \
   .. &&
ninja

  DESTDIR=$PKG ninja install
}
