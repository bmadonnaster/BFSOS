name=slang
version=2.3.3
release=1
source=(https://www.jedsoft.org/releases/$name/$name-$version.tar.bz2)

build() {
	cd $name-$version

	./configure --prefix=/usr \
            --sysconfdir=/etc \
            --with-readline=gnu &&
make -j1
	make DESTDIR=$PKG install_doc_dir=/usr/share/doc/$name-$version   \
     SLSH_DOC_DIR=/usr/share/doc/$name-$version/slsh \
     install
}
