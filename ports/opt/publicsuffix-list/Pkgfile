# Description: Cross-vendor public domain suffix database
# URL: https://github.com/publicsuffix/list
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>

name=publicsuffix-list
version=20260910
release=1
source=(public_suffix_list-$version.dat::https://publicsuffix.org/list/public_suffix_list.dat)


pkg_build() {

  install -D -m 644 -t $PKG/usr/share/publicsuffix \
    public_suffix_list-$version.dat

  ln -s public_suffix_list-$version.dat $PKG/usr/share/publicsuffix/effective_tld_names.dat
  ln -s public_suffix_list-$version.dat $PKG/usr/share/publicsuffix/public_suffix_list.dat
}
