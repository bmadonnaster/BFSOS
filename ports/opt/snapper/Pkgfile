# Description: Filesystem snapshot management tool for Btrfs
# URL: https://github.com/openSUSE/snapper
# Maintainer: Brian Madonna email bmadonnaster@gmail.com
# Depends on: acl btrfs-progs dbus json-c libxml2 util-linux zlib
# Optional: linux-pam

name=snapper
version=0.13.1
release=1

source=(https://github.com/openSUSE/snapper/archive/refs/tags/v$version.tar.gz)
#snapper-boost-system-header-only.patch)

build_opt=(
    --sysconfdir=/etc
    --disable-static
    --disable-pam
    --disable-zypp
    --disable-doc
    --disable-bcachefs
    --disable-ext4
    --disable-lvm
    --enable-btrfs
    --enable-xattrs
    --enable-systemd
)

pkg_build() {
    autoreconf -fi

    ./configure "${build_opt[@]}"

    make
    make DESTDIR="$PKG" install
}

post_build() {
    find "$PKG" -type f -name '*.la' -delete

    rm -rf \
        "$PKG/usr/share/doc" \
        "$PKG/usr/share/info"
}
