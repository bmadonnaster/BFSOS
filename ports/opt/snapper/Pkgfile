# Description: Filesystem snapshot management tool for Btrfs
# URL: https://github.com/openSUSE/snapper
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: acl boost btrfs-progs dbus json-c libxml2 util-linux zlib
# Optional: linux-pam

name=snapper
version=0.13.1
release=2

source=(https://github.com/openSUSE/snapper/archive/refs/tags/v$version.tar.gz)
#snapper-boost-system-header-only.patch)

build_opt=(
    --sysconfdir=/etc
    --disable-static
    --disable-pam
    --disable-zypp
    --disable-doc
    --disable-bcachefs
    --disable-ext4
    --disable-lvm
    --enable-btrfs
    --enable-xattrs
    --enable-systemd
)

pkg_build() {
    autoreconf -fi || return 1

    ./configure "${build_opt[@]}" || return 1

    make -j${JOBS:-1} || return 1
    make DESTDIR="$PKG" install || return 1
}

post_build() {
    find "$PKG" -type f -name '*.la' -delete

    rm -rf \
        "$PKG/usr/share/doc" \
        "$PKG/usr/share/info"
}
