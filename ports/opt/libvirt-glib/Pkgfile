# Description: GLib and GObject bindings for libvirt
# URL: https://libvirt.org/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: glib gobject-introspection libvirt libxml2 vala

name=libvirt-glib
version=5.0.0
release=1
source=(https://download.libvirt.org/glib/libvirt-glib-$version.tar.xz)

build_opt=(
    -Ddocs=disabled
    -Dtests=disabled
    -Dintrospection=enabled
    -Dvapi=enabled
)
