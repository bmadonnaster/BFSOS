name=libsass
version=3.6.5
release=1
source=(https://github.com/sass/$name/archive/$version/$name-$version.tar.gz)
build() {
	cd $name-$version
	autoreconf -fi
	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install
}
