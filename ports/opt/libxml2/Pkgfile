# Description: Libraries and utilities used for parsing XML files.
# URL: https://gitlab.gnome.org/GNOME/libxml2
# Maintainer: Brian Madonna email bmadonnaster@gmail.com
# Depends on:

name=libxml2
version=2.15.3
release=1

source=(
    https://download.gnome.org/sources/libxml2/${version%.*}/$name-$version.tar.xz
)

build_opt=(
    --prefix=/usr
    --sysconfdir=/etc
    --with-history
    --without-python
    --without-docbook
    --disable-static
)

pkg_build() {
    ./configure "${build_opt[@]}"
    make
    make DESTDIR="$PKG" install
}

post_build() {
    find "$PKG" -type f -name '*.la' -delete

    rm -rf \
        "$PKG/usr/share/doc" \
        "$PKG/usr/share/info"
}
