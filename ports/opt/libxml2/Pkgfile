# Description: Libraries and utilities used for parsing XML files.
# URL: https://gitlab.gnome.org/GNOME/libxml2
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: doxygen

name=libxml2
version=2.15.4
release=4

source=(
    https://download.gnome.org/sources/libxml2/${version%.*}/$name-$version.tar.xz
)

build_opt=(
    --prefix=/usr
    --sysconfdir=/etc
    --with-history
    --with-python=yes
    --disable-static
)

pkg_build() {
    ./configure "${build_opt[@]}" || return 1
    make || return 1
    make DESTDIR="$PKG" install || return 1
}

post_build() {
    find "$PKG" -type f -name '*.la' -delete

    rm -rf \
        "$PKG/usr/share/doc" \
        "$PKG/usr/share/info"
}
