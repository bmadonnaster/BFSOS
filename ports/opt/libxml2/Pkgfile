name=libxml2
version=2.13.7
release=1
source=(https://download.gnome.org/sources/libxml2/2.13/$name-$version.tar.xz)

build() {
	cd $name-$version

	./configure --prefix=/usr           \
            --sysconfdir=/etc       \
            --enable-static        \
            --with-history          \
            PYTHON=/usr/bin/python3 \
            --docdir=/usr/share/doc/$name-$version &&
	make
	make DESTDIR=$PKG install
}
