name=flac
version=1.4.3
release=1
source=(https://github.com/xiph/flac/releases/download/$version/flac-$version.tar.xz)

build() {
   cd $name-$version

   ./configure --prefix=/usr                                \
            --disable-thorough-tests                     \
            --docdir=/usr/share/doc/$name-$version          &&
make
  DESTDIR=$PKG make install
}
