# Depends on: rustc llvm

name=rust-bindgen
version=0.73.2
release=1
source=(https://github.com/rust-lang/${name}/archive/refs/tags/v${version}.tar.gz)

pkg_build() {
    prt-get isinst sccache && export RUSTC_WRAPPER=/usr/bin/sccache

    mkdir -p "$PKGMK_SOURCE_DIR/rust"

    cargo build \
        --release \
        --manifest-path Cargo.toml || return 1

    install -Dm755 \
        target/release/bindgen \
        "$PKG/usr/bin/bindgen" || return 1
}
