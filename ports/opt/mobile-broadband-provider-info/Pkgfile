# Description: Mobile broadband settings for various service providers
# URL:         https://github.com/GNOME/mobile-broadband-provider-info
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on:

name=mobile-broadband-provider-info
version=20251101
release=1
source=(https://download.gnome.org/sources/mobile-broadband-provider-info/20240407/mobile-broadband-provider-info-20240407.tar.xz)

pkg_build() {
    meson setup _meson_build \
        --prefix=/usr \
        --buildtype=release || return 1

    meson compile -C _meson_build || return 1

    DESTDIR="$PKG" \
        meson install -C _meson_build || return 1
}
