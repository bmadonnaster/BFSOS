# Description: Qt 6 WS-Discovery client library based on KDSoap
# URL: https://invent.kde.org/libraries/kdsoap-ws-discovery-client
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: extra-cmake-modules kdsoap qt6

name=kdsoap-ws-discovery-client
version=0.4.0
release=2
source=(https://deb.debian.org/debian/pool/main/k/$name/${name}_${version}.orig.tar.xz)

pkg_build() {
    cmake -B build -S . \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_PREFIX_PATH="/opt/qt6;/opt/kf6" \
        -DQT_MAJOR_VERSION=6 \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_TESTING=OFF \
        -Wno-author || return 1

    cmake --build build -j${JOBS:-1} || return 1
    DESTDIR="$PKG" cmake --install build || return 1
}
