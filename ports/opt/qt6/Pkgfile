# Description: Qt 6 framework (base/modules excluding QtWebEngine)
# URL: https://www.qt.io/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: alsa-lib bison cmake cups dbus double-conversion ffmpeg flex glib gperf gst-plugins-base gst-plugins-good harfbuzz icu libinput libjpeg-turbo libmng libpng libtiff libwebp libxkbcommon mesa mtdev ninja openssl pciutils python3 rust-bindgen rustc sqlite xorg-libs xcb-util xcb-util-renderutil xcb-util-image xcb-util-keysyms xcb-util-wm
# Optional: bluez gtk3 ibus libproxy mariadb pulseaudio unixodbc wayland-protocols

name=qt6
version=6.11.2
release=7
source=(https://download.qt.io/official_releases/qt/6.11/$version/single/qt-everywhere-src-$version.tar.xz)
keep_static=1

pkg_build() {
    export QT6PREFIX=/opt/qt6

    # Configure/build tools must run outside pkgmk staging; staging is applied
    # only to the final install below.
    unset DESTDIR
    unset DEST_DIR
    unset INSTALLROOT
    unset install_root
    unset INSTALL_ROOT

    # QtWebEngine is packaged separately so ordinary Qt rebuilds do not rebuild
    # Chromium. qtopcua is currently incompatible with OpenSSL 4; qt3d and
    # qtquick3dphysics remain intentionally excluded.
    rm -rf qtwebengine qt3d qtquick3dphysics qtopcua

    ./configure \
        -prefix "$QT6PREFIX" \
        -release \
        -sysconfdir /etc/xdg \
        -dbus-linked \
        -openssl-linked \
        -system-sqlite \
        -nomake examples \
        -no-rpath \
        -no-sbom \
        -journald || return 1

    ninja -j "${JOBS:-1}" || return 1

    DESTDIR="$PKG" ninja install || return 1

    find "$PKG$QT6PREFIX" \
        -name '*.prl' \
        -exec sed -i '/^QMAKE_PRL_BUILD_DIR/d' {} \;

    install -d \
        "$PKG/etc/profile.d" \
        "$PKG/etc/ld.so.conf.d"

    cat > "$PKG/etc/profile.d/qt6.sh" <<'EOF_PROFILE'
QT6DIR=/opt/qt6
pathappend "$QT6DIR/bin" PATH
pathappend "$QT6DIR/lib/pkgconfig" PKG_CONFIG_PATH
export QT6DIR
EOF_PROFILE

    printf '%s\n' '/opt/qt6/lib' \
        > "$PKG/etc/ld.so.conf.d/qt6.conf"
}
