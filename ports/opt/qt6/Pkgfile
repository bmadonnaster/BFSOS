# Description: Qt 6 framework, monolithic BFSOS build including QtWebEngine
# URL: https://www.qt.io/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: alsa-lib cups dbus double-conversion ffmpeg glib gst-plugins-base gst-plugins-good harfbuzz icu libinput libjpeg-turbo libmng libpng libtiff libwebp libxkbcommon mesa mtdev nodejs nss pciutils rust-bindgen sqlite xorg-libs
# Optional: bluez gtk3 ibus libproxy mariadb pulseaudio unixodbc wayland-protocols

name=qt6
version=6.11.2
release=2
source=(https://download.qt.io/archive/qt/6.11/$version/single/qt-everywhere-src-$version.tar.xz)

build() {
    cd qt-everywhere-src-$version
    export QT6PREFIX=/opt/qt6

    # Keep Qt as one coherent package. qtopcua is currently incompatible with
    # OpenSSL 4; qt3d/qtquick3dphysics remain intentionally excluded as in BLFS.
    rm -rf qt3d qtquick3dphysics qtopcua

    ./configure \
        -prefix "$QT6PREFIX" \
        -release \
        -sysconfdir /etc/xdg \
        -dbus-linked \
        -openssl-linked \
        -system-sqlite \
        -nomake examples \
        -no-rpath \
        -no-sbom \
        -journald

    ninja -j "${JOBS:-1}"
    DESTDIR="$PKG" ninja install

    find "$PKG$QT6PREFIX" -name '*.prl' -exec sed -i '/^QMAKE_PRL_BUILD_DIR/d' {} \;

    install -d "$PKG/etc/profile.d" "$PKG/etc/ld.so.conf.d"
    cat > "$PKG/etc/profile.d/qt6.sh" <<'EOF'
QT6DIR=/opt/qt6
pathappend "$QT6DIR/bin" PATH
pathappend "$QT6DIR/lib/pkgconfig" PKG_CONFIG_PATH
export QT6DIR
EOF
    printf '%s\n' '/opt/qt6/lib' > "$PKG/etc/ld.so.conf.d/qt6.conf"
}
