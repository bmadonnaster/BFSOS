# Description: Small fast portable speech synthesis engine
# URL: https://github.com/festvox/flite
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: alsa-lib

name=flite
version=2.2
release=1
source=(https://github.com/festvox/flite/archive/refs/tags/v$version.tar.gz)

pkg_build() {
    ./configure \
        --prefix=/usr \
        --enable-shared \
        --with-audio=alsa || return 1

    # Flite has historically had parallel-build ordering problems.
    make -j1 || return 1

    make DESTDIR="$PKG" install || return 1
}
