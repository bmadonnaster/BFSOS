# Description: D-Bus GLib bindings
# URL: https://freedesktop.org/wiki/Software/DBusBindings
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: dbus glib
# Optional: gtk-doc

name=dbus-glib
version=0.114
release=3
source=(https://ftp.debian.org/debian/pool/main/d/dbus-glib/dbus-glib_${version}.orig.tar.gz)

pkg_build() {

	prt-get isinst bash-completion || PKGMK_DBUSGLIB+=' --enable-bash-completion=no'

	./configure --prefix=/usr     \
            --sysconfdir=/etc \
            --disable-static &&
make
	make DESTDIR=$PKG install
}
