# Description: Device Tree Compiler and libfdt
# URL: https://git.kernel.org/pub/scm/utils/dtc/dtc.git/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: flex bison

name=dtc
version=1.8.1
release=1
source=(https://www.kernel.org/pub/software/utils/dtc/dtc-$version.tar.xz)

build_opt=(
    PREFIX=/usr
    LIBDIR=/usr/lib
)

pkg_build() {
    make "${build_opt[@]}" || return 1

    make \
        DESTDIR="$PKG" \
        "${build_opt[@]}" \
        install || return 1
}
