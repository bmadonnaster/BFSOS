name=polkit
version=126
release=1
source=(https://github.com/$name-org/$name/archive/$version/$name-$version.tar.gz)

pkg_build() {
 

 mkdir build &&
cd    build &&

meson setup ..                   \
      --prefix=/usr              \
      -D introspection=true	\
      --buildtype=release        \
      -D man=true                \
      -D session_tracking=logind \
      -D tests=false
ninja
  DESTDIR=$PKG ninja install


  rm -rf $PKG/usr/share/locale
}
