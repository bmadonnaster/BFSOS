name=libqmi
version=1.30.8
release=1
source=(https://www.freedesktop.org/software/$name/$name-$version.tar.xz)

build() {
	cd $name-$version

	PYTHON=python3 ./configure --prefix=/usr --disable-static &&
make
	make DESTDIR=$PKG install
}
