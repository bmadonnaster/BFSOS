# Description: DVD reading library.
# URL: https://www.videolan.org/developers/libdvdnav.html
# Maintainer: Brian Madonna email bmadonnaster@gmail.com
# Depends on: libdvdcss

name=libdvdread
version=7.1.1
release=2
source=(https://download.videolan.org/pub/videolan/$name/$version/$name-$version.tar.bz2)

pkg_build() {

	./configure --prefix=/usr    \
            --disable-static \
            --docdir=/usr/share/doc/libdvdread-$version &&
make
	make DESTDIR=$PKG install
}
