# Description: DVD reading library.
# URL: https://www.videolan.org/developers/libdvdnav.html
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: libdvdcss

name=libdvdread
version=7.1.1
release=4
source=(https://download.videolan.org/pub/videolan/libdvdread/$version/libdvdread-$version.tar.xz)

pkg_build() {
    meson setup build . \
        --prefix=/usr \
        --buildtype=release \
        --wrap-mode=nodownload \
        --default-library=shared &&

    meson compile -C build -j ${JOBS:-1} &&

    DESTDIR="$PKG" meson install -C build
}
