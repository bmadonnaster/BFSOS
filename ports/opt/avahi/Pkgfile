# Description: Multicast DNS/DNS-SD service discovery stack
# URL: https://github.com/avahi/avahi
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: glib gobject-introspection gtk3 libdaemon
# Optional: dbus-python libevent doxygen xmltoman qt5

name=avahi
version=0.9-rc5
release=3

source=(
    https://github.com/avahi/avahi/archive/v$version/avahi-$version.tar.gz
    https://www.linuxfromscratch.org/patches/blfs/svn/avahi-$version-ipv6_race_condition_fix-1.patch
)

build_opt="\
    --disable-static \
    --disable-libevent \
    --disable-mono \
    --disable-monodoc \
    --disable-python \
    --disable-qt3 \
    --disable-qt4 \
    --disable-manpages \
    --enable-core-docs \
    --with-distro=none"

pre_build() {
    autoreconf -fiv || return 1

    if prt-get isinst qt5 >/dev/null 2>&1; then
        build_opt="$build_opt --enable-qt5"
    else
        build_opt="$build_opt --disable-qt5"
    fi
}
