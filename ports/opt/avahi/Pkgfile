# Description: Multicast DNS/DNS-SD service discovery stack
# URL: https://github.com/avahi/avahi
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: glib gobject-introspection gtk3 libdaemon
# Optional: dbus-python libevent doxygen xmltoman

name=avahi
version=0.9-rc5
release=2

source=(
  https://github.com/avahi/avahi/archive/v$version/avahi-$version.tar.gz
  https://www.linuxfromscratch.org/patches/blfs/svn/avahi-$version-ipv6_race_condition_fix-1.patch
)

build_opt=(
  --disable-static
  --disable-libevent
  --disable-mono
  --disable-monodoc
  --disable-python
  --disable-qt3
  --disable-qt4
  --disable-qt5
  --enable-core-docs
  --disable-manpages
  --with-distro=none
)

pre_build() {
  autoreconf -fiv
}
