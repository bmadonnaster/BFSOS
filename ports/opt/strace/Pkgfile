# Description: Diagnostic, debugging and instructional Linux syscall tracer
# URL: https://strace.io/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>

name=strace
version=7.2
release=1
source=(https://strace.io/files/$version/$name-$version.tar.xz)

pkg_build() {
  ./configure \
    --prefix=/usr \
    --disable-mpers \
    --disable-gcc-Werror || return 1

  make -j ${JOBS:-1} || return 1
  make DESTDIR="$PKG" install || return 1
}
