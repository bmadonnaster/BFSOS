# Description: An image loading library for GTK+
# URL: https://wiki.gnome.org/Projects/GdkPixbuf
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: gobject-introspection libpng libtiff shared-mime-info
# Optional: docutils librsvg libtiff gobject-introspection gi-docgen libavif webp-pixbuf-loader
name=gdk-pixbuf
version=2.44.8
release=1
source=(https://download.gnome.org/sources/gdk-pixbuf/2.44/gdk-pixbuf-$version.tar.xz)

pkg_build() {
	meson setup build . \
		--prefix=/usr \
		--buildtype=plain \
		--wrap-mode nodownload \
		-D b_lto=true \
		-D b_pie=true \
		-D tests=false \
		-D installed_tests=false \
		-D man=false \
		-D glycin=disabled -D others=enabled &&

	meson compile -C build -j ${JOBS:-1}
	DESTDIR=$PKG meson install  -C build
}
