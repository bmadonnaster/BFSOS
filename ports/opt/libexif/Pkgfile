name=libexif
version=0.6.25
release=1
source=(https://github.com/$name/$name/releases/download/v$version/$name-$version.tar.bz2)

build () {
	cd $name-$version

	./configure --prefix=/usr    \
            --disable-static \
            --with-doc-dir=/usr/share/doc/$name-$version &&
make
	make DESTDIR=$PKG install
}
