name=liburcu
version=0.14.1
release=1
source=(https://lttng.org/files/urcu/userspace-rcu-$version.tar.bz2)

build() {
	cd userspace-rcu-$version

	./configure --prefix=/usr    \
            --disable-static \
            --docdir=/usr/share/doc/$name-$version &&
make
	make DESTDIR=$PKG install
}
