name=gpgme
version=1.24.0
release=1
source=(https://mirrors.dotsrc.org/gcrypt/$name/$name-$version.tar.bz2)

pkg_build() {

	mkdir build &&
cd    build &&

../configure --prefix=/usr --disable-gpg-test &&
make PYTHONS=
	make DESTDIR=$PKG install PYTHONS=
rm -rf $PKG/usr/share/info/
}
