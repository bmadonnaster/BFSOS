# Description: Open-source Chromium web browser
# URL: https://www.chromium.org/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: alsa-lib at-spi2-core brotli cairo cups dbus expat flac fontconfig freetype glib gtk3 harfbuzz icu libdrm libevent libffi libjpeg-turbo libpng libva libwebp libxkbcommon libxml2 libxslt llvm mesa minizip nspr nss openh264 opus pango pciutils pulseaudio systemd zlib zstd gn lld ninja nodejs python3 rust-bindgen rustc
# Optional: pipewire qt6 gnome-keyring

name=chromium
version=153.0.8010.36
release=1
build_work=disk
source=(https://commondatastorage.googleapis.com/chromium-browser-official/chromium-$version.tar.xz)

# Custom build required: Chromium is generated by GN and compiled/staged from
# Ninja targets; the generic extension cannot represent this orchestration.
build_opt=(
    'is_official_build=true'
    'is_debug=false'
    'symbol_level=0'
    'blink_symbol_level=0'
    'chrome_pgo_phase=0'
    'use_sysroot=false'
    'use_system_libffi=true'
    'use_system_libjpeg=true'
    'use_system_libpng=true'
    'use_system_zlib=true'
    'use_system_libevent=true'
    'use_system_freetype=true'
    'use_system_harfbuzz=true'
    'use_system_libdrm=true'
    'use_system_minizip=true'
    'use_system_libwebp=true'
    'use_system_openh264=true'
    'use_system_libxml=true'
    'use_system_libxslt=true'
    'use_system_icu=true'
    'use_system_libvpx=false'
    'use_kerberos=false'
    'proprietary_codecs=true'
    'ffmpeg_branding="Chrome"'
    'use_pulseaudio=true'
    'use_vaapi=true'
    'ozone_auto_platforms=true'
    'ozone_platform_wayland=true'
    'ozone_platform_x11=true'
    'enable_nacl=false'
    'enable_widevine=false'
    'is_clang=true'
    'use_lld=true'
)

pkg_build() {
    local gn_args
    printf -v gn_args '%s ' "${build_opt[@]}"
    mkdir -p out/Release || return 1
    gn gen out/Release --args="$gn_args" || return 1
    ninja -C out/Release chrome chrome_sandbox chromedriver || return 1

    install -d "$PKG/usr/lib/chromium" "$PKG/usr/bin" \
        "$PKG/usr/share/applications" "$PKG/usr/share/icons/hicolor/256x256/apps" || return 1
    install -m755 out/Release/chrome "$PKG/usr/lib/chromium/chromium" || return 1
    install -m4755 out/Release/chrome_sandbox "$PKG/usr/lib/chromium/chrome-sandbox" || return 1
    install -m755 out/Release/chromedriver "$PKG/usr/lib/chromium/chromedriver" || return 1

    for f in icudtl.dat resources.pak chrome_100_percent.pak chrome_200_percent.pak snapshot_blob.bin v8_context_snapshot.bin; do
        [ ! -e "out/Release/$f" ] || cp -a "out/Release/$f" "$PKG/usr/lib/chromium/" || return 1
    done
    for d in locales resources; do
        [ ! -e "out/Release/$d" ] || cp -a "out/Release/$d" "$PKG/usr/lib/chromium/" || return 1
    done

    cat > "$PKG/usr/bin/chromium" <<'WRAP'
#!/bin/sh
exec /usr/lib/chromium/chromium "$@"
WRAP
    chmod 755 "$PKG/usr/bin/chromium"

    cat > "$PKG/usr/share/applications/chromium.desktop" <<'DESKTOP'
[Desktop Entry]
Name=Chromium
Comment=Access the Internet
Exec=chromium %U
Terminal=false
Type=Application
Icon=chromium
Categories=Network;WebBrowser;
MimeType=text/html;x-scheme-handler/http;x-scheme-handler/https;
StartupNotify=true
DESKTOP

    if [ -f out/Release/product_logo_256.png ]; then
        install -m644 out/Release/product_logo_256.png \
            "$PKG/usr/share/icons/hicolor/256x256/apps/chromium.png"
    fi
}
