# Description: All-in-one voice and text chat for gamers
# URL: https://discord.com/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: alsa-lib gtk3 libnotify libX11 libXcomposite libXcursor libXdamage libXext libXfixes libXi libXrandr libXrender libXScrnSaver libXtst nspr nss

name=discord
version=1.0.158
release=3
source=(https://dl.discordapp.net/apps/linux/$version/$name-$version.tar.gz)

pkg_build() {
    install -d "$PKG/opt/discord"
    cp -a . "$PKG/opt/discord/"

    install -d "$PKG/usr/bin"

    cat > "$PKG/usr/bin/discord" <<'SCRIPT'
#!/bin/sh
exec /opt/discord/Discord "$@"
SCRIPT

    chmod 755 "$PKG/usr/bin/discord"

    install -d "$PKG/usr/share/applications"
    install -m 644 discord.desktop \
        "$PKG/usr/share/applications/discord.desktop"

    sed -i \
        's|^Exec=.*|Exec=/usr/bin/discord %U|' \
        "$PKG/usr/share/applications/discord.desktop"

    install -d "$PKG/usr/share/pixmaps"
    ln -s /opt/discord/discord.png \
        "$PKG/usr/share/pixmaps/discord.png"
}
