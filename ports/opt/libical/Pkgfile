# Description: The libical package contains an implementation of the iCalendar protocols and data formats.
# URL:         https://github.com/libical
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on:  cmake gobject-introspection vala
# Optional: db doxygen graphviz gtk-doc icu pygobject

name=libical
version=4.0.5
release=3

source=(
  https://github.com/$name/$name/releases/download/v$version/$name-$version.tar.gz
)

build_opt=(
  -DCMAKE_INSTALL_PREFIX=/usr
  -DCMAKE_BUILD_TYPE=Release
  -DLIBICAL_STATIC=NO
  -DLIBICAL_BUILD_DOCS=false
  -DLIBICAL_GOBJECT_INTROSPECTION=true
  -DLIBICAL_GLIB_VAPI=true
  -DLIBICAL_JAVA_BINDINGS=OFF
)

pkg_build() {
  cmake -S . -B build "${build_opt[@]}"

  cmake --build build -j1

  DESTDIR="$PKG" cmake --install build
}
