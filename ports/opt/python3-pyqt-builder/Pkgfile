# Description: PEP 517 build backend for PyQt projects
# URL: https://www.riverbankcomputing.com/software/pyqt/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: python3-build python3-installer python3-packaging python3-setuptools python3-sip python3-wheel

name=python3-pyqt-builder
version=1.20.0
release=1
source=(https://files.pythonhosted.org/packages/source/p/pyqt-builder/pyqt_builder-$version.tar.gz)

pkg_build() {
    python3 -m build --wheel --skip-dependency-check --no-isolation || return 1
    python3 -m installer --compile-bytecode 2 --destdir="$PKG" dist/*.whl || return 1
}
