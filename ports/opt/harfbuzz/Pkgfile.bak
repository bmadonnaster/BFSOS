# Description: An OpenType text shaping engine
# URL: https://github.com/harfbuzz/harfbuzz
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: cairo gobject-introspection graphite2
# Optional: chafa icu

name=harfbuzz
version=14.4.0
release=1
source=(https://github.com/harfbuzz/harfbuzz/releases/download/$version/$name-$version.tar.xz)

pkg_build() {
    meson setup build . \
        --prefix=/usr \
        --buildtype=release \
        -Dgraphite2=enabled || return $?
    meson compile -C build -j "${JOBS:-1}" || return $?
    DESTDIR="$PKG" meson install -C build || return $?
}
