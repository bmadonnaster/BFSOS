# Description: An OpenType text shaping engine
# URL: https://github.com/harfbuzz/harfbuzz
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: cairo gobject-introspection graphite2 icu
# Optional: chafa

name=harfbuzz
version=14.4.0
release=2
source=(https://github.com/harfbuzz/harfbuzz/releases/download/$version/$name-$version.tar.xz)

pkg_build() {
    meson setup build . \
        --prefix=/usr \
        --buildtype=release \
        -Dgraphite2=enabled \
        -Dicu=enabled \
        -Dtests=disabled || return 1

    meson compile -C build -j "${JOBS:-1}" || return 1
    DESTDIR="$PKG" meson install -C build || return 1
}
