# Description: Free peer-reviewed portable C++ source libraries.
# URL: https://www.boost.org/
# Maintainer: Brian Madonna email bmadonnaster@gmail.com
# Depends on: bzip2 zstd
# Optional: icu

name=boost
version=1.91.0
release=1

source=(
    https://archives.boost.io/release/$version/source/boost_1_91_0.tar.bz2
)

pkg_build() {
    local -a b2_options=()

    # Disable ICU-backed Boost.Locale support when ICU is unavailable.
    if ! prt-get isinst icu >/dev/null 2>&1; then
        b2_options+=(
            --disable-icu
            boost.locale.icu=off
        )
    fi

    ./bootstrap.sh \
        --with-toolset=gcc

    ./b2 install \
        "${b2_options[@]}" \
        --with-system \
        --with-filesystem \
        --with-thread \
        --prefix="$PKG/usr" \
        --layout=system \
        -j "${JOBS:-1}" \
        variant=release \
        debug-symbols=off \
        threading=multi \
        runtime-link=shared \
        link=shared \
        toolset=gcc \
        "cflags=$CPPFLAGS $CFLAGS -fPIC" \
        "cxxflags=$CPPFLAGS $CXXFLAGS -fPIC" \
        "linkflags=$LDFLAGS"
}

post_build() {
    find "$PKG" -type f -name '*.la' -delete

    rm -rf \
        "$PKG/usr/share/doc" \
        "$PKG/usr/share/info"
}
