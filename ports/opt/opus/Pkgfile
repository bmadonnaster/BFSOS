name=opus
version=1.5.2
release=2
source=(https://downloads.xiph.org/releases/opus/opus-$version.tar.gz)

build() {
  cd $name-$version
  mkdir build &&
cd    build &&

meson setup --prefix=/usr        \
            --buildtype=release  \
            -Ddocdir=/usr/share/doc/opus-1.4 &&
ninja
  DESTDIR=$PKG ninja install
}
