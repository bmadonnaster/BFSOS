# Description: GLib core library for passing menus over D-Bus
# URL: https://launchpad.net/libdbusmenu
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: glib json-glib

name=libdbusmenu-glib
version=18.10
release=1
source=(
  https://deb.debian.org/debian/pool/main/libd/libdbusmenu/libdbusmenu_18.10.20180917~bzr492+repack1.orig.tar.xz
  0001_no-deprecated-gnome-common-macros.patch
  0003_port-tools-dbusmenu-bench-to-py3.patch
  0004_prevent-test-json-from-failing.patch
)

pkg_build() {
  export HAVE_VALGRIND_TRUE='#'
  export HAVE_VALGRIND_FALSE=''

  patch -Np1 -i "$SRC/0001_no-deprecated-gnome-common-macros.patch" || return 1
  patch -Np1 -i "$SRC/0003_port-tools-dbusmenu-bench-to-py3.patch" || return 1
  patch -Np1 -i "$SRC/0004_prevent-test-json-from-failing.patch" || return 1

  sed -i 's/-Werror -Wno-error=deprecated-declarations//g' libdbusmenu-{glib,gtk}/Makefile.am || return 1
  sed -i 's/gtkdocize || exit 1//g' autogen.sh || return 1
  sed -i 's/--enable-gtk-doc//g' autogen.sh || return 1

  ./autogen.sh \
    --prefix=/usr \
    --sysconfdir=/etc \
    --libexecdir=/usr/lib/$name \
    --localstatedir=/var \
    --disable-dumper \
    --disable-tests \
    --disable-vala \
    --disable-nls \
    --disable-gtk \
    || return 1

  make -j"${JOBS:-1}" || return 1
  make DESTDIR="$PKG" -C libdbusmenu-glib install || return 1
  rm -rf "$PKG/usr/share/doc"
}
