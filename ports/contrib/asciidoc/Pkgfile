# Description: Text based document generation.
# URL: https://asciidoc.org/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: docbook-xsl-nons python3-build python3-installer

name=asciidoc
version=10.2.1
release=3
source=(https://github.com/$name-py/$name-py/archive/$version/$name-py-$version.tar.gz)

pkg_build() {
  PYTHON='/usr/bin/python3'
  autoconf || return 1
  ./configure --prefix=/usr --sysconfdir=/etc || return 1

  make -j"${JOBS:-1}" || return 1
  make DESTDIR="$PKG" install || return 1
}
