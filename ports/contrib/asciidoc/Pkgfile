# Description: Text based document generation.
# URL: https://asciidoc.org/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: docbook-xsl-nons python3-build python3-installer

name=asciidoc
version=10.2.1
release=2
source=(https://github.com/$name-py/$name-py/archive/$version/$name-py-$version.tar.gz)

pkg_build() {
  PYTHON='/usr/bin/python3'
  autoconf
  ./configure --prefix=/usr --sysconfdir=/usr/etc

  make
  make DESTDIR=$PKG install
}
