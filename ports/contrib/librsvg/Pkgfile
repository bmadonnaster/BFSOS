# Description: SVG rendering library with cairo backend
# URL: https://wiki.gnome.org/Projects/LibRsvg
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: cairo gdk-pixbuf  pango rustc vala cargo-c
# Optional: object-introspection vala docutils gi-docgen xorg-fonts
name=librsvg
version=2.63.0
release=3
source=(https://download.gnome.org/sources/$name/${version%.*}/$name-$version.tar.xz)

build_opt="-D docs=disabled -D tests=false -D pixbuf=enabled -D pixbuf-loader=enabled"

pre_build() {
  prt-get isinst sccache && export RUSTC_WRAPPER=/usr/bin/sccache
  mkdir -p "$PKGMK_SOURCE_DIR/rust" || return 1
  export CARGO_HOME="$PKGMK_SOURCE_DIR/rust"
  export CARGO_PROFILE_RELEASE_LTO=true
  export CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1
  prt-get isinst vala && build_opt+=' -D vala=enabled'
}
