# Description: SVG rendering library with cairo backend
# URL: https://wiki.gnome.org/Projects/LibRsvg
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: cairo gdk-pixbuf  pango rustc vala cargo-c
# Optional: object-introspection vala docutils gi-docgen xorg-fonts
name=librsvg
version=2.63.0
release=2
source=(https://download.gnome.org/sources/$name/${version%.*}/$name-$version.tar.xz)


pkg_build() {
  prt-get isinst sccache && export RUSTC_WRAPPER=/usr/bin/sccache
  [[ ! -e $PKGMK_SOURCE_DIR/rust ]] && mkdir -p $PKGMK_SOURCE_DIR/rust

  prt-get isinst vala && PKGMK_LIBRSVG+=' --enable-vala'

  export CARGO_PROFILE_RELEASE_LTO=true
  export CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1

  meson setup build . \
    --prefix=/usr \
    --buildtype=plain \
    --wrap-mode nodownload \
    -D b_lto=true \
    -D b_pie=true \
    -D docs=disabled \
    -D tests=false \
    -D pixbuf=enabled \
    -D pixbuf-loader=enabled || return 1
  meson compile -C build || return 1
  DESTDIR="$PKG" meson install -C build || return 1
}


