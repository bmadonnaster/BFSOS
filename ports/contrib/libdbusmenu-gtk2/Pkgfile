# Description: GTK2 library for passing menus over D-Bus
# URL: https://launchpad.net/libdbusmenu
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: gtk json-glib libdbusmenu-glib libXdamage

name=libdbusmenu-gtk2
version=18.10
release=6
source=(
  https://deb.debian.org/debian/pool/main/libd/libdbusmenu/libdbusmenu_18.10.20180917~bzr492+repack1.orig.tar.xz
  0001_no-deprecated-gnome-common-macros.patch
  0003_port-tools-dbusmenu-bench-to-py3.patch
  0004_prevent-test-json-from-failing.patch
)

build_opt="--prefix=/usr --sysconfdir=/etc --libexecdir=/usr/lib/libdbusmenu-gtk2 --localstatedir=/var --disable-dumper --disable-tests --disable-vala --disable-nls --with-gtk=2"

# Custom build required: only the GTK2 sublibrary is installed
pkg_build() {
  (
    set -e
  export HAVE_VALGRIND_TRUE='#'
  export HAVE_VALGRIND_FALSE=''

  sed -i 's/-Werror -Wno-error=deprecated-declarations//g' libdbusmenu-{glib,gtk}/Makefile.am || return 1
  sed -i 's/gtkdocize || exit 1//g' autogen.sh || return 1
  sed -i 's/--disable-gtk-doc//g' autogen.sh || return 1

  ./autogen.sh $build_opt || return 1

  make -j"${JOBS:-1}" || return 1
  make DESTDIR="$PKG" -C libdbusmenu-gtk install || return 1
  rm -rf "$PKG/usr/share/doc"
  )
}
