# Description: WINE with staging patches
# URL: https://wiki.winehq.org/Wine-Staging
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: alsa-lib-32 alsa-plugins-32 cups-32 fontconfig-32 freeglut-32 gnutls-32 gst-plugins-base-32 gstreamer-32 lcms2-32 libX11-32 libXcomposite-32 libXcursor-32 libXext-32 libXi-32 libXinerama-32 libXrandr-32 libXrender-32 libXxf86vm-32 libgcrypt-32 libpcap-32 libsdl2-32 libunwind-32 libusb-32 libva-32 mpg123-32 openal-32 pipewire-32 pulseaudio-32 vkd3d-32 vulkan-loader-32 wayland-32 mingw-w64-gcc

# GECKO_VERSION: 2.47.4
# MONO_VERSION:  11.3.0

name=wine-staging
version=11.17
release=4
keep_static=1
source=(https://dl.winehq.org/wine/source/11.x/wine-$version.tar.xz \
    https://github.com/$name/$name/archive/v$version/$name-$version.tar.gz \
    https://dl.winehq.org/wine/wine-gecko/2.47.4/wine-gecko-2.47.4-x86.msi \
    https://dl.winehq.org/wine/wine-gecko/2.47.4/wine-gecko-2.47.4-x86_64.msi \
    https://dl.winehq.org/wine/wine-mono/11.3.0/wine-mono-11.3.0-x86.msi)

build_opt="--prefix=/usr --libdir=/usr/lib --enable-win64 --enable-archs=i386,x86_64"

# Custom build required: staging patch application and Wine multi-architecture configure flow
pkg_build() {
  (
    set -e
    "$SRC/wine-staging-$version/staging/patchinstall.py" \
        DESTDIR="$SRC/wine-$version" --all -W server-Stored_ACLs || return 1

    export CPPFLAGS="${CPPFLAGS/-D_FORTIFY_SOURCE=2/} -D_FORTIFY_SOURCE=0"

    install -d "$SRC/wine64" || return 1
    cd "$SRC/wine64" || return 1
    "$SRC/wine-$version/configure" $build_opt || return 1
    make depend || return 1
    make -j"${JOBS:-1}" || return 1
    make DESTDIR="$PKG" install || return 1

    install -d "$PKG/usr/share/wine/gecko" "$PKG/usr/share/wine/mono" || return 1

    install -t "$PKG/usr/share/wine/gecko/" \
        "$SRC/wine-gecko-2.47.4-x86.msi" \
        "$SRC/wine-gecko-2.47.4-x86_64.msi" || return 1

    install "$SRC/wine-mono-11.3.0-x86.msi" "$PKG/usr/share/wine/mono/" || return 1

    rm -rf "$PKG"/usr/share/man/??.UTF-8

    install -d "$PKG/etc/revdep.d" || return 1
    printf '%s\n' '/usr/lib/wine/x86_64-unix' > "$PKG/etc/revdep.d/$name" || return 1
  )
}
