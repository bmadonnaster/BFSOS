name=mpg123-32
version=1.33.0
release=1
source=(https://www.mpg123.de/download/${name%-*}-$version.tar.bz2)

build() {
  cd ${name%-*}-$version
  ./configure --prefix=/usr \
      --host=i686-pc-linux-gnu      \
    --libdir=/usr/lib32 \
    --host=i686-pc-linux-gnu

  make
  make DESTDIR=$PKG install

  rm -r $PKG/usr/{bin,include,share/man,share}
}
