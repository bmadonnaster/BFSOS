# Description: Commandline MP3 player
# URL: https://www.mpg123.de
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: alsa-lib-32 mpg123 openal-32
# Optional: flac-32 lame-32 libsdl2-32 pulseaudio-32

name=mpg123-32
version=1.33.7
release=2
source=(https://www.mpg123.de/download/${name%-*}-$version.tar.bz2)

pkg_build() {
  ./configure --prefix=/usr \
    --libdir=/usr/lib32 \
    --host="${BFS_MULTILIB_HOST:-i686-pc-linux-gnu}" || return 1

  make -j"${JOBS:-1}" || return 1
  make DESTDIR="$PKG" install || return 1

  rm -rf "$PKG/usr/bin" "$PKG/usr/include" "$PKG/usr/share"
}
