# Description: CUPS - Common UNIX Printing System
# URL: https://www.cups.org
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: avahi-32 cups libusb-32 zlib-32
# Optional: dbus-32 gnutls-32

name=cups-32
version=2.4.19
release=4
source=(https://github.com/OpenPrinting/cups/releases/download/v$version/${name%-*}-$version-source.tar.gz)

# Custom build required: only the install-libs target belongs in the compat package
pkg_build() {
  (
    set -e
	PKGMK_CUPS=' --with-tls=openssl'
	prt-get isinst gnutls-32 && PKGMK_CUPS=' --with-tls=gnutls'


	CC=gcc CXX=g++ \
	./configure \
		--prefix=/usr $PKGMK_CUPS \
		--sysconfdir=/etc \
		--libdir=/usr/lib32 \
		--localstatedir=/var \
		--with-docdir=/usr/share/cups/doc \
		--with-logdir=/var/log/cups \
		--with-cups-user=daemon \
		--with-cups-group=lp \
		--with-languages="" \
		--without-{java,perl,php,python} \
		--without-rcdir \
		--without-pam  \
		--without-crypt \
		--with-optim="$CFLAGS" \
		--enable-acl \
		--disable-{pam,dbus,dnssd,systemd} \
		--without-systemd

	make libs
	make BUILDROOT=$PKG install-libs
  )
}
