name=libXcursor-32
version=1.2.3
release=1
source=(https://www.x.org/releases/individual/lib/libXcursor-$version.tar.xz)

pkg_build() {
	cd libXcursor-$version

	./configure \
		--prefix=/usr \
		--libdir=/usr/lib32

	make
	make DESTDIR=$PKG install

	rm -r $PKG/usr/{include,share/man}
	rmdir $PKG/usr/share
}
