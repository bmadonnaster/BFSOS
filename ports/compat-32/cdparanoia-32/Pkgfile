# Description: CDDA extraction tool with jitter correction
# URL:         https://xiph.org/paranoia/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: cdparanoia

name=cdparanoia-32
version=10.2
release=4
PKGMK_AUTO_PATCH=no
source=(https://downloads.xiph.org/releases/cdparanoia/cdparanoia-III-$version.src.tgz
	cdparanoia-10.2-463009.patch
	cdparanoia-10.2-endian.patch
	cdparanoia-10.2-install.patch
	cdparanoia-10.2-format-security.patch
	cdparanoia-use-proper-gnu-config-files.patch
	cdparanoia-10.2-ldflags.patch
	cdparanoia-10.2-add-pkgconfig.patch)

pkg_build() {
	patch -p3 -i $SRC/cdparanoia-10.2-463009.patch || return 1
	patch -p1 -i $SRC/cdparanoia-10.2-endian.patch || return 1
	patch -p1 -i $SRC/cdparanoia-10.2-install.patch || return 1
	patch -p1 -i $SRC/cdparanoia-10.2-format-security.patch || return 1
	patch -p1 -i $SRC/cdparanoia-use-proper-gnu-config-files.patch || return 1
	patch -p1 -i $SRC/cdparanoia-10.2-ldflags.patch || return 1
	patch -p1 -i $SRC/cdparanoia-10.2-add-pkgconfig.patch || return 1
	autoreconf -ifv || return 1

	./configure \
		--prefix=/usr \
		--libdir=/usr/lib32 \
		--host="${BFS_MULTILIB_HOST:-i686-pc-linux-gnu}" || return 1

	make -j1 || return 1
	make DESTDIR="$PKG" install || return 1

	rm -rf "$PKG/usr/bin" "$PKG/usr/include" "$PKG/usr/share"
}
