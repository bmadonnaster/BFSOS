# Description: S-Lang programmer's library
# URL: http://www.jedsoft.org/slang/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: jq-32 libpcre-32 libpng-32 slang
# Optional: oniguruma

name=slang-32
version=2.3.3
release=2
source=(https://www.jedsoft.org/releases/${name%-*}/${name%-*}-$version.tar.bz2)

build_opt="--host=${BFS_MULTILIB_HOST:-i686-pc-linux-gnu} --prefix=/usr --libdir=/usr/lib32"

# Custom build required: upstream requires install-all and serialized build handling
pkg_build() {
  (
    set -e
	./configure $build_opt

	make -j1
	make -j1 DESTDIR=$PKG install-all
	rm -r $PKG/usr/{bin,etc,share,include}
  )
}
