# Description: A message bus system
# URL: https://freedesktop.org/wiki/Software/dbus
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: dbus expat-32 libX11-32

name=dbus-32
version=1.16.2
release=5
source=(https://dbus.freedesktop.org/releases/dbus/dbus-$version.tar.xz)

build_opt="--libexecdir=lib32/dbus -D dbus_daemondir=/usr/sbin -D dbus_user=messagebus -D runtime_dir=/run -D system_pid_file=/run/dbus/pid -D system_socket=/run/dbus/system_bus_socket"

pre_build() {
        _bfs_require_compat32_extension 2 || return 0
	export PKG_CONFIG_LIBDIR='/usr/lib32/pkgconfig:/usr/share/pkgconfig'
}

post_build() {

	rm -rf "$PKG/var" "$PKG/run" "$PKG/usr/bin" "$PKG/usr/include" "$PKG/usr/share" "$PKG/etc"
}
