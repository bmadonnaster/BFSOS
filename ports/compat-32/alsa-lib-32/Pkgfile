# Description: ALSA libraries
# URL: http://www.alsa-project.org
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: alsa-lib

name=alsa-lib-32
version=1.2.16.1
release=2
source=(https://www.alsa-project.org/files/pub/lib/alsa-lib-$version.tar.bz2)

build_opt="--disable-python"

post_build() {

    rm -r $PKG/usr/{bin,include,share}
}

pre_build() {
        _bfs_require_compat32_extension 2 || return $?
}
