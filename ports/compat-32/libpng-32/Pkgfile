# Description: Library of PNG support functions
# URL: http://www.libpng.org/pub/png/libpng.html
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: libpng zlib-32

name=libpng-32
version=1.6.59
_base=${version:0:3}
_base=${_base/./}
release=1
source=(https://downloads.sourceforge.net/libpng/libpng-$version.tar.xz)


post_build() {

	rm -r $PKG/usr/{bin,include,share/man}
}

pre_build() {
        _bfs_require_compat32_extension 2 || return $?
}
