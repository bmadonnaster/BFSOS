name=libogg-32
version=1.3.6
release=1
source=(https://downloads.xiph.org/releases/ogg/libogg-$version.tar.xz)

pkg_build() {
    ./configure     --prefix=/usr --libdir=/usr/lib32
    make
    make DESTDIR=$PKG install

    rm -r $PKG/usr/{include,share}
}
