# Description: Packet capture library
# URL: https://www.tcpdump.org
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: libpcap libusb-32

name=libpcap-32
version=1.11.0
release=1
source=(https://www.tcpdump.org/release/libpcap-$version.tar.gz)

build_opt="--disable-dbus --without-libnl"

post_build() {

	rm -r $PKG/usr/{bin,include,share/man,share}
}

pre_build() {
        _bfs_require_compat32_extension 2 || return $?
}
