# Description: SDL, Simple DirectMedia Layer
# URL: http://www.libsdl.org
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: alsa-lib-32 glib-32 mesa-32

name=libsdl-32
version=1.2.15
release=6
source=(http://www.libsdl.org/release/SDL-$version.tar.gz
        gcc15-xext-prototypes.patch)

build_opt="--mandir=/usr/man --program-suffix=-32 --enable-alsa"

pre_build() {
        _bfs_require_compat32_extension 2 || return 0
  export PKG_CONFIG_PATH='/usr/lib32/pkgconfig:/usr/share/pkgconfig'
}

post_build() {
  rm -r $PKG/usr/{include,man,share}

  # --program-suffix=-32 is being ignored
  mv $PKG/usr/bin/sdl-config $PKG/usr/bin/sdl-config-32
}
