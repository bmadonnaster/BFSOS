name=alsa-plugins-32
version=1.2.12
release=1
source=(ftp://ftp.alsa-project.org/pub/plugins/alsa-plugins-${version}.tar.bz2)

build() {
	cd alsa-plugins-${version}

	./configure \
		--prefix=/usr \
		--libdir=/usr/lib32 \
		--sysconfdir=/etc

	make
	make DESTDIR=$PKG install

	rm -r $PKG/{etc,usr/share}
}
