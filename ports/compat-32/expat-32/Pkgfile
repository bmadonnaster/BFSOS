# Description: A fast, non-validating, stream-oriented XML parsing library
# URL: https://libexpat.github.io/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: expat

name=expat-32
version=2.9.0
release=1
source=(https://github.com/libexpat/libexpat/releases/download/R_${version//./_}/expat-$version.tar.xz)


post_build() {

	rm -r $PKG/usr/{bin,include,share/doc,share/man}
	rmdir $PKG/usr/share
}

pre_build() {
        _bfs_require_compat32_extension 2 || return $?
}
