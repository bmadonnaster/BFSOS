name=libXext-32
version=1.3.6
release=1
source=(https://www.x.org/releases/individual/lib/libXext-$version.tar.xz)

pkg_build () {
	./configure --prefix=/usr --libdir=/usr/lib32

	make
	make DESTDIR=$PKG install

	rm -r $PKG/usr/{include,share/man,share/doc}
}
