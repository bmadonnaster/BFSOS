# Description: a lightweight C library that eases the writing of UNIX daemons
# URL: http://0pointer.de/lennart/projects/libdaemon/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: libdaemon

name=libdaemon-32
version=0.14
release=2
source=(http://0pointer.de/lennart/projects/${name%-*}/${name%-*}-$version.tar.gz)

build_opt="--disable-lynx"

post_build() {

	rm -r $PKG/usr/{include,share}
}

pre_build() {
        _bfs_require_compat32_extension 2 || return $?
}
