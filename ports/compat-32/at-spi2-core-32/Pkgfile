# Description: Protocol definitions and daemon for D-Bus at-spi
# URL: https://gitlab.gnome.org/GNOME/at-spi2-core
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: at-spi2-core dbus-32 glib-32 libXi-32 libXtst-32 libxml2-32

name=at-spi2-core-32
version=2.60.6
release=3
source=(https://download.gnome.org/sources/at-spi2-core/${version:0:4}/at-spi2-core-$version.tar.xz)

build_opt="--sysconfdir=/usr/etc --libexecdir=/usr/lib32/at-spi2 -D introspection=disabled"

post_build() {

	rm -r $PKG/usr/{include,etc,share,lib}
}

pre_build() {
        _bfs_require_compat32_extension 2 || return $?
}
