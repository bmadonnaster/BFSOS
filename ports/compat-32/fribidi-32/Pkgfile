name=fribidi-32
version=1.0.16
release=1
source=(https://github.com/${name%-*}/${name%-*}/releases/download/v$version/${name%-*}-$version.tar.xz)

build() {
	meson setup ${name%-*}-$version build \
		-D prefix=/usr \
		--libdir=/usr/lib32 \
		--buildtype=plain \
		-D docs=false
	meson compile -C build
	DESTDIR=$PKG meson install -C build

	rm -r $PKG/usr/{bin,include}
}
