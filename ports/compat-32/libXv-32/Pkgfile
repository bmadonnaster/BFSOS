name=libXv-32
version=1.0.12
release=1
source=(https://www.x.org/releases/individual/lib/libXv-$version.tar.xz)

build() {
	cd libXv-$version

	./configure --prefix=/usr --libdir=/usr/lib32

	make
	make DESTDIR=$PKG install

	rm -r $PKG/usr/{include,share/man,share}
}
