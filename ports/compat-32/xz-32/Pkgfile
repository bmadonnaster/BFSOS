name=xz-32
version=5.8.0
release=1
source=(https://github.com/tukaani-project/xz/releases/download/v$version/xz-$version.tar.gz)

build() {
	cd xz-$version

	autoreconf -vfi
	./configure \
	 --host=i686-pc-linux-gnu      \
		--prefix=/usr \
		--libdir=/usr/lib32 \
		--enable-threads \
		--enable-werror \
		--disable-doc \
		--disable-nls

	make
	make DESTDIR=$PKG install

	rm -r $PKG/usr/{bin,include,share}
}
