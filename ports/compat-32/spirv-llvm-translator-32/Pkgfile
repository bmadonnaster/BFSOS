# Description: Bidirectional translation between LLVM IR and SPIR-V (32-bit compatibility libraries)
# URL: https://github.com/KhronosGroup/SPIRV-LLVM-Translator
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: libxml2-32 llvm-32 spirv-headers spirv-tools-32 spirv-llvm-translator

name=spirv-llvm-translator-32
version=23.1.3
release=1

headers_commit=cb42dec3830d3ac67fa449ecdc0c0f73d5e74498

source=(
    https://github.com/KhronosGroup/SPIRV-LLVM-Translator/archive/v${version}/SPIRV-LLVM-Translator-${version}.tar.gz
    https://github.com/KhronosGroup/SPIRV-Headers/archive/${headers_commit}/SPIRV-Headers-${headers_commit}.tar.gz
)

pkg_build() {
        (
        set -e

        # pkgmk stays in src/ when multiple source directories exist.
        if [ ! -f CMakeLists.txt ]; then
            cd "SPIRV-LLVM-Translator-${version}" || exit 1
        fi

        headers_dir="$(pwd)/../SPIRV-Headers-${headers_commit}"

        if [ ! -f "$headers_dir/include/spirv/unified1/spirv.hpp" ]; then
            echo "ERROR: Pinned SPIR-V Headers not found: $headers_dir" >&2
            exit 1
        fi

        rm -rf build

        cmake -S . -B build \
            -G Ninja \
            -DCMAKE_INSTALL_PREFIX=/usr \
            -DCMAKE_INSTALL_LIBDIR=lib32 \
            -DCMAKE_BUILD_TYPE=Release \
            -DCMAKE_C_FLAGS_RELEASE="$CFLAGS" \
            -DCMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
            -DBUILD_SHARED_LIBS=ON \
            -DCMAKE_SKIP_INSTALL_RPATH=ON \
            -DLLVM_LINK_LLVM_DYLIB=ON \
            -DLLVM_BUILD_LLVM_DYLIB=ON \
            -DLLVM_EXTERNAL_SPIRV_HEADERS_SOURCE_DIR="$headers_dir" \
            -DCMAKE_PREFIX_PATH=/usr/lib32/cmake

        cmake --build build -j "${JOBS:-1}"

        DESTDIR="$PKG" cmake --install build

        rm -rf \
            "$PKG/usr/bin" \
            "$PKG/usr/include"

        if [ -d "$PKG/usr/lib" ]; then
            echo "ERROR: 32-bit package installed files into /usr/lib" >&2
            exit 1
        fi
    )
}
