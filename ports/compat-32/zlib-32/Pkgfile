# Description: A compression/decompression Library
# URL: https://www.zlib.net/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>

name=zlib-32
version=1.3.2
release=2
source=(https://www.zlib.net/zlib-$version.tar.gz)
keep_static=1

build_opt="--prefix=/usr --libdir=/usr/lib32"

# Custom build required: zlib configure does not accept the generic Autoconf option set
pkg_build() {
  (
    set -e
	./configure $build_opt

	make
	make DESTDIR=$PKG install

	ln -sf ../../lib32/libz.so.$version $PKG/usr/lib32/libz.so
	rm -rf $PKG/lib32/libz.so

	rm -r $PKG/usr/{include,share/man,share}
  )
}
