# Description: Network configuration tool
# URL: https://wiki.gnome.org/Projects/NetworkManager/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: curl-32 dbus-glib-32 jansson-32 libndp-32 libpsl-32 networkmanager nss-32

name=libnm-32
version=1.58.1
release=7
source=(https://gitlab.freedesktop.org/NetworkManager/NetworkManager/-/releases/$version/downloads/NetworkManager-$version.tar.xz)

# Custom build required: NetworkManager library-only feature selection is conditional
build_opt="--libexecdir=/usr/lib/networkmanager \
-Dcrypto=nss \
-Ddbus_conf_dir=/usr/share/dbus-1/system.d \
-Dudev_dir=/lib/udev \
-Dintrospection=false \
-Dsession_tracking=no \
-Dlibaudit=no \
-Dbluez5_dun=false \
-Dconcheck=false \
-Dclat=false \
-Dnbft=false \
-Debpf=false \
-Diwd=false \
-Dmodem_manager=false \
-Dnm_cloud_setup=false \
-Dnmcli=false \
-Dnmtui=false \
-Dovs=false \
-Dppp=false \
-Dteamdctl=false \
-Dtests=no \
-Dmore_asserts=no \
-Dmore_logging=false \
-Dqt=false \
-Dsystemdsystemunitdir=no \
-Dsystemd_journal=false \
-Dselinux=false \
-Dsuspend_resume=consolekit \
-Dpolkit=false"

pre_build() {
    _bfs_require_compat32_extension 2
}

post_build() {
    rm -rf "$PKG/usr/bin" \
           "$PKG/usr/include" \
           "$PKG/usr/sbin" \
           "$PKG/usr/share" \
           "$PKG/usr/lib" \
           "$PKG/etc" \
           "$PKG/lib" \
           "$PKG/var"
}

