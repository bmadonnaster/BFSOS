# Description: The Oil Runtime Compiler.
# URL: https://gstreamer.freedesktop.org/projects/orc.html
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: orc

name=orc-32
version=0.4.43
release=2
source=(https://gstreamer.freedesktop.org/src/orc/orc-$version.tar.xz)

pkg_build() {
  meson setup build . --cross-file lib32 \
    --prefix=/usr \
    --libdir=/usr/lib32 \
    --buildtype=plain \
    --wrap-mode nodownload \
    -D b_lto=true \
    -D b_pie=true \
    -D benchmarks=disabled \
    -D examples=disabled \
    -D gtk_doc=disabled \
    -D tests=disabled

  meson compile -C build -j ${JOBS:-1}
  DESTDIR=$PKG meson install -C build

  rm -r $PKG/usr/{bin,include}
}
