# Description: The Oil Runtime Compiler.
# URL: https://gstreamer.freedesktop.org/projects/orc.html
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: orc

name=orc-32
version=0.4.44
release=2
source=(https://gstreamer.freedesktop.org/src/orc/orc-$version.tar.xz)

build_opt="-D benchmarks=disabled -D examples=disabled -D hotdoc=disabled -D tests=disabled"

post_build() {

  rm -rf $PKG/usr/{bin,include}
}

pre_build() {
        _bfs_require_compat32_extension 2 || return $?
}
