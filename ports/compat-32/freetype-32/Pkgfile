# Description: A free and portable TrueType font rendering engine
# URL: https://www.freetype.org/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: bzip2-32 freetype libpng-32

name=freetype-32
version=2.14.3
release=1
source=(https://sourceforge.net/projects/freetype/files/freetype2/$version/freetype-$version.tar.xz
        cross-file.txt)

pkg_build() {
        meson setup . build \
                --cross-file cross-file.txt \
                --prefix=/usr \
                --libdir=/usr/lib32 \
                --buildtype=plain \
                --wrap-mode=nodownload \
                -D b_lto=true \
                -D b_pie=true \
                -D default_library=shared || return 1

        meson compile -C build -j "${JOBS:-1}" || return 1

        DESTDIR="$PKG" meson install -C build || return 1

        rm -rf \
                "$PKG/usr/include" \
                "$PKG/usr/share/aclocal"
}
