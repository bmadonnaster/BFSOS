# Description: A free and portable TrueType font rendering engine
# URL: https://www.freetype.org/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: bzip2-32 freetype libpng-32

name=freetype-32
version=2.14.3
release=3
source=(https://sourceforge.net/projects/freetype/files/freetype2/$version/freetype-$version.tar.xz)

build_opt="-D default_library=shared"

post_build() {

        rm -rf "$PKG/usr/include" "$PKG/usr/share/aclocal"
}

pre_build() {
        _bfs_require_compat32_extension 2 || return $?
}
