name=libvorbis-32
version=1.3.7
release=1
source=(https://downloads.xiph.org/releases/vorbis/${name%-*}-$version.tar.xz)

build() {
	cd ${name%-*}-$version

	./configure \
	        --host=i686-pc-linux-gnu \
		--prefix=/usr \
		--libdir=/usr/lib32

	make
	make DESTDIR=$PKG install

	rm -r $PKG/usr/{include,share}
}
