# Description: The GL Vendor-Neutral Dispatch library
# URL: https://github.com/NVIDIA/libglvnd
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: libglvnd libX11-32 libXext-32

name=libglvnd-32
version=1.7.0
release=3
source=(https://github.com/NVIDIA/${name%-32}/archive/v$version/${name%-32}-$version.tar.gz)

build_opt="--disable-headers"

pre_build() {
        _bfs_require_compat32_extension 2 || return 0
	NOCONFIGURE=1 ./autogen.sh || return 1
}

post_build() {
	rm -r $PKG/usr/include
}
