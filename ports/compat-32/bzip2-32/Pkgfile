# Description: Very high-quality data compression program
# URL: http://www.bzip.org/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>

name=bzip2-32
version=1.0.8
release=3
source=(https://sourceware.org/pub/${name%-*}/${name%-*}-$version.tar.gz)

# Custom build required: upstream has separate shared/static Makefiles
pkg_build() {
  (
    set -e
        install -d "$PKG/usr/lib32"

        # pkgmk already enters the extracted source directory.
        # Start from clean objects so no native objects can leak into
        # the compat-32 library.
        make clean

        make -f Makefile-libbz2_so \
                CC="${CC:-gcc}" \
                CFLAGS="$CFLAGS -fPIC -D_FILE_OFFSET_BITS=64"

        rm -f libbz2.a
        make libbz2.a \
                CC="${CC:-gcc}" \
                CFLAGS="$CFLAGS"

        install -m 0644 \
                libbz2.so.$version \
                "$PKG/usr/lib32/"

        ln -s libbz2.so.$version \
                "$PKG/usr/lib32/libbz2.so"

        ln -s libbz2.so.$version \
                "$PKG/usr/lib32/libbz2.so.1.0"

        install -m 0644 \
                libbz2.a \
                "$PKG/usr/lib32/"
  )
}
