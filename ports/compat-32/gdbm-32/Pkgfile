name=gdbm-32
version=1.25
release=1
source=(https://ftp.gnu.org/gnu/${name%-*}/${name%-*}-$version.tar.gz)

build() {
	export CC="${CC:-gcc} ${CFLAGS}"
	export CFLAGS="$CFLAGS -fcommon"

	cd ${name%-*}-$version

	./configure --prefix=/usr \
		--libdir=/usr/lib32 \
		--enable-libgdbm-compat

	make
	make DESTDIR=$PKG install

	rm -r $PKG/usr/{bin,include,share}
}
