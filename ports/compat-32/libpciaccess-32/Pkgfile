# Description: Generic PCI access library
# URL: https://xorg.freedesktop.org
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: libpciaccess zlib-32
# Optional: hwdata

name=libpciaccess-32
version=0.19
release=3
source=(https://www.x.org/releases/individual/lib/libpciaccess-$version.tar.xz
cross-file.txt)

# Custom build required: package supplies a source-local Meson cross description
pkg_build() {
  (
    set -e
	prt-get isinst hwdata && PKGMK_LIBPCIA+=' -D pci-ids=hwdata'

	meson setup build . $PKGMK_LIBPCIA --cross-file ../cross-file.txt  \
		--prefix=/usr \
		--libdir=/usr/lib32 \
		--buildtype=plain \
		--wrap-mode nodownload \
		-D b_lto=false \
		-D b_pie=true \
		-D zlib=enabled
	meson compile -C build
	DESTDIR=$PKG meson install -C build

	rm -rf $PKG/usr/include
  )
}
