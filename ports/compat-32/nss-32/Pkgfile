# Description: Mozilla Network Security Services (32-bit ABI libraries)
# URL: https://firefox-source-docs.mozilla.org/security/nss/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: nspr-32 nss sqlite3-32 zlib-32

name=nss-32
version=3.129
release=1
source=(https://archive.mozilla.org/pub/security/nss/releases/NSS_${version//./_}_RTM/src/nss-$version.tar.gz
        nss-config.in nss.pc.in)

# Custom build required: Mozilla build system and manual library staging are required
pkg_build() {
  (
    set -e
    sed -i nss/coreconf/Linux.mk \
        -e 's|^CC.*=.*gcc$|#&|' \
        -e 's|^CCC.*=.*g++$|#&|'

    export NSPR_INCLUDE_DIR=/usr/include/nspr
    export NSPR_LIB_DIR=/usr/lib32
    export NSS_USE_SYSTEM_SQLITE=1
    export NSS_ENABLE_ECC=1
    export BUILD_OPT=1
    export XCFLAGS="$CFLAGS -Wno-error"
    export NSS_DISABLE_GTESTS=1

    make -j1 -C nss all || return 1

    install -d "$PKG/usr/bin" "$PKG/usr/lib32/pkgconfig" || return 1
    cd dist/*.OBJ/lib || return 1
    install -m755 *.so "$PKG/usr/lib32" || return 1
    install -m644 *.chk "$PKG/usr/lib32" || return 1
    test ! -e libcrmf.a || install -m644 libcrmf.a "$PKG/usr/lib32" || return 1

    install -m755 "$SRC/nss-config.in" "$PKG/usr/bin/nss-config-32" || return 1
    sed -i \
        -e "s/@VERSION@/$version/g" \
        -e 's|libdir=${exec_prefix}/lib$|libdir=${exec_prefix}/lib32|' \
        "$PKG/usr/bin/nss-config-32" || return 1

    nspr_version=$(pkg-config --modversion nspr) || return 1
    nss_libs='-L/usr/lib32 -lssl3 -lsmime3 -lnss3 -lnssutil3'
    nss_cflags='-I/usr/include/nss'
    sed "$SRC/nss.pc.in" \
        -e 's,%prefix%,/usr,g' \
        -e 's,%exec_prefix%,/usr,g' \
        -e 's,%libdir%,/usr/lib32,g' \
        -e 's,%includedir%,/usr/include/nss,g' \
        -e "s,%NSS_VERSION%,$version,g" \
        -e "s,%NSPR_VERSION%,$nspr_version,g" \
        -e "s,%FULL_NSS_LIBS%,$nss_libs,g" \
        -e "s,%FULL_NSS_CFLAGS%,$nss_cflags,g" \
        > "$PKG/usr/lib32/pkgconfig/nss.pc" || return 1

    # Native p11-kit owns the trust module; never ship a second 32-bit ckbi
    # database that can diverge from the system CA policy.
    rm -f "$PKG/usr/lib32/libnssckbi.so"
  )
}
