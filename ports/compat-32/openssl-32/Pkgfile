# Description: Secure Sockets Layer and Transport Layer Security tools
# URL: https://www.openssl.org/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: zlib-32

name=openssl-32
version=4.0.2
release=2
source=(https://github.com/openssl/openssl/releases/download/openssl-$version/openssl-$version.tar.gz)

# Custom build required: OpenSSL uses its Configure target and install_sw
pkg_build() {
  (
    set -e
	./Configure --prefix=/usr \
		--libdir=/usr/lib32 \
		--openssldir=/etc/ssl \
		shared \
		threads \
		zlib \
		shared no-ssl3-method linux-elf \
		disable-tests \

	sed -i "s|-O3|$CFLAGS|" Makefile

	make depend
	make
	make -j1 DESTDIR=$PKG install_sw

	find $PKG -name "*fips*" -delete
	rm -r $PKG/usr/{include,bin}
  )
}
