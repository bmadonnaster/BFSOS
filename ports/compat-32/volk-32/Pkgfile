# Description: Meta loader for Vulkan API
# URL: https://github.com/zeux/volk
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: vulkan-loader-32 volk

name=volk-32
version=1.4.357.0
_version=vulkan-sdk-$version
release=3
source=(https://github.com/zeux/volk/archive/$_version/volk-$version.tar.gz)

build_opt="-D VOLK_INSTALL=True -Wno-dev"

post_build() {

  rm -r $PKG/usr/include
}

pre_build() {
        _bfs_require_compat32_extension 2 || return $?
}
