name=mtdev-32
version=1.1.7
release=1
source=(https://bitmath.org/code/mtdev/mtdev-$version.tar.bz2)

pkg_build() {

	./configure \
	    --host=i686-pc-linux-gnu      \
		--prefix=/usr \
		--libdir=/usr/lib32

	make
	make DESTDIR=$PKG install

	rm -r $PKG/usr/{bin,include}
}
