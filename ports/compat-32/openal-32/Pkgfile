# Description: Cross-platform 3D audio.
# URL: https://github.com/kcat/openal-soft
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: alsa-lib-32 openal

name=openal-32
version=1.25.2
release=3
source=(https://github.com/kcat/openal-soft/archive/$version/openal-soft-$version.tar.gz)

build_opt="-D ALSOFT_UTILS=OFF -D ALSOFT_EXAMPLES=OFF -D QT_QMAKE_EXECUTABLE=qmake-disabled"

post_build() {
  rm -rf "$PKG/usr/include" "$PKG/usr/share"
}

pre_build() {
        _bfs_require_compat32_extension 2 || return $?
}
