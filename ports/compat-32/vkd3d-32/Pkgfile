# Description: Direct3D 12 to Vulkan translation library By WineHQ.
# URL: https://github.com/d3d12/vkd3d
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: vkd3d spirv-tools-32 vulkan-loader-32 xcb-util-keysyms-32

name=vkd3d-32
version=2.1
release=3
source=(https://dl.winehq.org/vkd3d/source/${name%-*}-$version.tar.xz)

build_opt="--with-spirv-tools"

post_build() {
    mv $PKG/usr/bin/vkd3d-compiler{,-32}
    mv $PKG/usr/bin/vkd3d-dxbc{,-32}

    rm -r $PKG/usr/include
}

pre_build() {
        _bfs_require_compat32_extension 2 || return $?
}
