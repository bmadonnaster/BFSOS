# Description: Library for manipulation of TIFF (Tag Image File Format) images
# URL: http://www.simplesystems.org/libtiff/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: libjpeg-turbo-32 zlib-32

name=libtiff4-32
version=3.9.7
release=3
source=(http://download.osgeo.org/libtiff/tiff-$version.tar.gz
	libtiff4-soname.patch)

build_opt="--prefix=/usr --libdir=/usr/lib32"

# Custom build required: only the legacy libtiff subdirectory is installed
pkg_build() {
  (
    set -e
	./autogen.sh
	./configure $build_opt
	make
	make DESTDIR=$PKG -C libtiff install
	rm -rf $PKG/usr/{bin,include,lib32/libtiff{,xx}.{la,a,so},share}
  )
}
