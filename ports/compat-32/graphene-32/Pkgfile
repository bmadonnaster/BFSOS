# Description: A thin layer of graphic data types - 32-bit
# URL: https://ebassi.github.io/graphene/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: glib-32 graphene

name=graphene-32
version=1.10.8
release=4
source=(https://github.com/ebassi/graphene/archive/$version/graphene-$version.tar.gz)

build_opt="-Dgobject_types=true -Dintrospection=disabled -Dtests=false -Dinstalled_tests=false"

pre_build() {
    _bfs_require_compat32_extension 2 || return $?
}

post_build() {
    rm -rf "$PKG/usr/include"
}
