name=libtool-32
version=2.6.2
release=1
source=(https://ftp.gnu.org/gnu/${name%-*}/${name%-*}-$version.tar.xz)

pkg_build() {

	./configure \
		--prefix=/usr \
		--libdir=/usr/lib32

	make
	make DESTDIR=$PKG install

	rm -r $PKG/usr/{bin,include,share}
}
