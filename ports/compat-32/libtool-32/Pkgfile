name=libtool-32
version=2.6.2
release=2
source=(https://ftp.gnu.org/gnu/${name%-*}/${name%-*}-$version.tar.xz)


post_build() {

	rm -r $PKG/usr/{bin,include,share}
}

pre_build() {
        _bfs_require_compat32_extension 2 || return $?
}
