name=libXrandr-32
version=1.5.4
release=1
source=(https://www.x.org/releases/individual/lib/libXrandr-$version.tar.xz)

build() {
	cd libXrandr-$version

	./configure --prefix=/usr --libdir=/usr/lib32

	make
	make DESTDIR=$PKG install

	rm -r $PKG/usr/{include,share/man}
}
