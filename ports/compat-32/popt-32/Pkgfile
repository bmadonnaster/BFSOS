name=popt-32
version=1.19
release=1
source=(http://ftp.rpm.org/popt/releases/popt-1.x/popt-$version.tar.gz)

build() {
	cd ${name%-*}-$version

	./configure \
		--prefix=/usr \
		--libdir=/usr/lib32 \
		--disable-nls

	make
	make DESTDIR=$PKG pkgconfigdir='/usr/lib32/pkgconfig' install

	rm -r $PKG/usr/{share,include}
}
