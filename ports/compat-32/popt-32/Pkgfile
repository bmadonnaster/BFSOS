# Description: Commandline option parser
# URL: https://github.com/rpm-software-management/popt
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: popt

name=popt-32
version=1.19
release=2
source=(http://ftp.rpm.org/popt/releases/popt-1.x/popt-$version.tar.gz)

build_opt="--disable-nls"

post_build() {

	rm -r $PKG/usr/{share,include}
}

pre_build() {
        _bfs_require_compat32_extension 2 || return $?
}
