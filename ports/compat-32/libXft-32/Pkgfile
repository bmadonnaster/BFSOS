name=libXft-32
version=2.3.8
release=1
source=(https://www.x.org/releases/individual/lib/libXft-$version.tar.xz)

build() {
	cd libXft-$version

	./configure --prefix=/usr --libdir=/usr/lib32

	make
	make DESTDIR=$PKG install

	rm -r $PKG/usr/{include,share/man}
}
