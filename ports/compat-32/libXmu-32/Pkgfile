# Description: xorg lib libXmu
# URL: https://xorg.freedesktop.org
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: libXext-32 libXmu libXt-32

name=xorg-libxmu-32
version=1.3.1
release=2
source=(https://www.x.org/releases/individual/lib/libXmu-$version.tar.xz)

pkg_build() {

	./configure --prefix=/usr --libdir=/usr/lib32

	make
	make DESTDIR=$PKG install

	rm -r $PKG/usr/{include,share/doc}
}
