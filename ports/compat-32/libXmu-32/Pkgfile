name=xorg-libxmu-32
version=1.2.1
release=1
source=(https://www.x.org/releases/individual/lib/libXmu-$version.tar.xz)

build() {
	cd libXmu-$version

	./configure --prefix=/usr --libdir=/usr/lib32

	make
	make DESTDIR=$PKG install

	rm -r $PKG/usr/{include,share/doc}
}
