name=libXt-32
version=1.3.1
release=2
source=(https://www.x.org/releases/individual/lib/libXt-$version.tar.xz)

build() {
	cd libXt-$version

	./configure --prefix=/usr --libdir=/usr/lib32

	make
	make DESTDIR=$PKG install

	rm -r $PKG/usr/{include,share}
}
