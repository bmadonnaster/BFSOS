# Description: A multi-platform toolkit for creating graphical user interfaces
# URL: https://www.gtk.org/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: at-spi2-core-32 gdk-pixbuf-32 gtk pango-32 libXcomposite-32 libXcursor-32 libXinerama-32 libXrandr-32

name=gtk-32
version=2.24.33
release=4
source=(https://download.gnome.org/sources/gtk+/${version%.*}/gtk+-$version.tar.xz)

build_opt="--disable-cups"

pre_build() {
        _bfs_require_compat32_extension 2 || return 0
  export PKG_CONFIG_PATH="/usr/share/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
  CFLAGS+=" -Wno-error=implicit-int -Wno-error=incompatible-pointer-types"
  sed -e 's#l \(gtk-.*\).sgml#& -o \1#' \
    -i docs/{faq,tutorial}/Makefile.in || return 1
}

post_build() {
  mv "$PKG/usr/bin/gtk-query-immodules-2.0" "$PKG/usr/bin/gtk-query-immodules-2.0-32"
  rm -f "$PKG/usr/bin/gtk-builder-convert" "$PKG/usr/bin/gtk-demo" "$PKG/usr/bin/gtk-update-icon-cache"
  rm -rf "$PKG/etc" "$PKG/usr/include" "$PKG/usr/share"
}
