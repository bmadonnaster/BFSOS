# Description: DSP library derived from speex
# URL: https://www.speex.org/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on:

name=speexdsp-32
version=1.2.1
release=2
source=(https://ftp.osuosl.org/pub/xiph/releases/speex/speexdsp-$version.tar.gz)

# Custom build required: generated Makefile needs documentation pruning after configure
pkg_build() {
  (
    set -e
	./configure \
		--prefix=/usr \
		--libdir=/usr/lib32

	sed -i -e '/^SUBDIRS *=/s|\bdoc\b||' Makefile

	make
	make DESTDIR=$PKG install

	rm -r $PKG/usr/include
  )
}
