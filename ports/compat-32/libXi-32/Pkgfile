name=libXi-32
version=1.8.2
release=1
source=(https://www.x.org/releases/individual/lib/libXi-$version.tar.xz)

build() {
	cd libXi-$version

	./configure --prefix=/usr --libdir=/usr/lib32

	make
	make DESTDIR=$PKG install

	rm -r $PKG/usr/{include,share/man,share}
}
