name=libXinerama-32
version=1.1.5
release=1
source=(https://www.x.org/releases/individual/lib/libXinerama-$version.tar.xz)

build() {
	cd libXinerama-$version

	./configure --prefix=/usr --libdir=/usr/lib32

	make
	make DESTDIR=$PKG install

	rm -r $PKG/usr/{include,share/man,share}
}
