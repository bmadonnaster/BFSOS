name=attr-32
version=2.5.2
release=1
source=(http://download-mirror.savannah.gnu.org/releases/${name%-*}/${name%-*}-$version.tar.gz)

build() {
	cd ${name%-*}-$version

	./configure \
		--prefix=/usr \
		--bindir=/bin \
		--sysconfdir=/etc \
		--libdir=/usr/lib32

	make
	make DESTDIR=$PKG install

	rm -r $PKG/{bin,etc} $PKG/usr/{include,share}
}
