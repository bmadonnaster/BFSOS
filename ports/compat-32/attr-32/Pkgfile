# Description: Extented attributes library
# URL:         http://savannah.nongnu.org/projects/attr/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>

name=attr-32
version=2.6.0
release=2
source=(https://debian.netcologne.de/savannah/attr/attr-$version.tar.gz)

build_opt="--bindir=/bin"

post_build() {

	rm -r $PKG/{bin,etc} $PKG/usr/{include,share}
}

pre_build() {
        _bfs_require_compat32_extension 2 || return $?
}
