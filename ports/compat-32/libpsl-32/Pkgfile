# Description: Public Suffix List library.
# URL: https://github.com/rockdaboot/libpsl
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: libidn2-32 libpsl

name=libpsl-32
version=0.23.3
release=4
source=(https://github.com/rockdaboot/${name%-*}/releases/download/$version/${name%-*}-$version.tar.lz)

build_opt="-D runtime=libidn2 -D builtin=true -D psl_file=/usr/share/publicsuffix/effective_tld_names.dat -D psl_testfile=/usr/share/publicsuffix/test_psl.txt"

post_build() {

	rm -rf $PKG/usr/{bin,include,share}
}

pre_build() {
        _bfs_require_compat32_extension 2 || return $?
}
