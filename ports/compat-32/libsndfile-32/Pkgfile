# Description: Library for manipulating sound files.
# URL: http://www.mega-nerd.com/libsndfile
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: alsa-lib-32 flac-32 libogg-32 libsndfile libvorbis-32 opus-32

name=libsndfile-32
version=1.2.2
release=4
source=(https://github.com/libsndfile/libsndfile/releases/download/$version/libsndfile-$version.tar.xz)

# Custom build required: generated configuration requires package-local handling
pkg_build() {
  (
    set -e
	CFLAGS="$CFLAGS -std=gnu17" \
	./configure \
		--prefix=/usr \
		--libdir=/usr/lib32

	make || return 1
	make DESTDIR=$PKG install || return 1
	rm -r $PKG/usr/{bin,include,share/man,share}
  )
}
