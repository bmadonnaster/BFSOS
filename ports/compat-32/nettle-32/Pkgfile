name=nettle-32
version=3.10
release=1
source=(https://ftp.gnu.org/gnu/nettle/nettle-$version.tar.gz)

build() {
	cd nettle-$version

	./configure \
	    --host=i686-pc-linux-gnu      \
		--prefix=/usr \
		--libdir=/usr/lib32 \
		--disable-documentation

	make
	make DESTDIR=$PKG install

	rm -r $PKG/usr/{bin,include}
}
