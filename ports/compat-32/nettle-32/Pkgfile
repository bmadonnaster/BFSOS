# Description: Low-level cryptographic library
# URL: http://www.lysator.liu.se/~nisse/nettle/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: libgmp-32 nettle

name=nettle-32
version=4.0
release=2
source=(https://ftp.gnu.org/gnu/nettle/nettle-$version.tar.gz)

build_opt="--disable-documentation"

post_build() {

	rm -r $PKG/usr/{bin,include}
}

pre_build() {
        _bfs_require_compat32_extension 2 || return $?
}
