# Description: POSIX.1e capabilities library
# URL: https://sites.google.com/site/fullycapable/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: attr-32

name=libcap-32
version=2.78
release=3
source=(https://www.kernel.org/pub/linux/libs/security/linux-privs/libcap2/${name%-*}-$version.tar.xz)

# Custom build required: libcap installs only the libcap subdirectory and must
# override the upstream multilib install locations for its 32-bit payload.
pkg_build() {
    (
        set -e

        sed -i "/^CFLAGS/s/-O2/$CFLAGS/" Make.Rules

        make -C libcap \
            GOLANG=no \
            RAISE_SETFCAP=no \
            PKGCONFIGDIR=/usr/lib32/pkgconfig

        make -C libcap \
            GOLANG=no \
            RAISE_SETFCAP=no \
            DESTDIR="$PKG" \
            prefix=/usr \
            lib=lib32 \
            install

        rm -rf "$PKG/usr/include"
    )
}
