# Description: A general purpose cryptographic library based on GnuPG
# URL: https://www.gnupg.org/software/libgcrypt/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: libgcrypt libgpg-error-32

name=libgcrypt-32
version=1.12.4
release=3
source=(https://gnupg.org/ftp/gcrypt/libgcrypt/libgcrypt-$version.tar.bz2)

build_opt=(
    --disable-padlock-support
    --enable-static=yes
    --disable-asm
)

pre_build() {
    _bfs_require_compat32_extension 2 || return $?
    autoreconf -fi
}

post_build() {
    rm -rf "$PKG/usr/share" "$PKG/usr/include" "$PKG/usr/bin"
}
