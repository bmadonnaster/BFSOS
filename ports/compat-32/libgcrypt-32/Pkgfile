# Description: A general purpose cryptographic library based on GnuPG
# URL: https://www.gnupg.org/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: libgcrypt libgpg-error-32

name=libgcrypt-32
version=1.12.3
release=2
source=(https://mirrors.dotsrc.org/gcrypt/${name%-*}/${name%-*}-$version.tar.bz2)

build_opt="--disable-padlock-support --enable-static=yes --disable-asm"

pre_build() {
        _bfs_require_compat32_extension 2 || return 0
	autoreconf -fi
}

post_build() {

	rm -r $PKG/usr/{share,include,bin}
}
