name=libgcrypt-32
version=1.12.2
release=1
source=(https://mirrors.dotsrc.org/gcrypt/${name%-*}/${name%-*}-$version.tar.bz2)

pkg_build() {

	autoreconf -fi

	./configure \
	    --host=i686-pc-linux-gnu      \
		--prefix=/usr \
		--libdir=/usr/lib32 \
		--disable-padlock-support \
		--enable-static=yes \
		--disable-asm

	make
	make DESTDIR=$PKG install

	rm -r $PKG/usr/{share,include,bin}
}
