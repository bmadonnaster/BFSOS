# Description: An OpenType text shaping engine
# URL: https://www.freedesktop.org/wiki/Software/HarfBuzz
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: cairo-32 harfbuzz
# Optional: icu-32

name=harfbuzz-32
version=14.4.0
release=3
source=(https://github.com/harfbuzz/harfbuzz/releases/download/$version/${name%-*}-$version.tar.xz)

build_opt="-D benchmark=disabled -D docs=disabled -D graphite=disabled -D icu=disabled -D introspection=disabled"

pre_build() {
        _bfs_require_compat32_extension 2 || return 0
  prt-get isinst icu-32 >/dev/null && build_opt+=' -D icu=enabled'
}

post_build() {
  rm -rf "$PKG/usr/bin" "$PKG/usr/include"
}
