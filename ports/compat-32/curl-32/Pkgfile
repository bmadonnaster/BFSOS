# Description: A tool for transfering files with URL syntax
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# URL: https://curl.se/
# Depends on: curl openssl-32 zstd-32 brotli-32
# Optional:

name=curl-32
version=8.22.0
release=3
source=(https://curl.se/download/${name%-*}-$version.tar.xz)

build_opt="--enable-ipv6 --without-libidn2 --with-openssl --enable-threaded-resolver --without-libpsl --with-ca-bundle=/etc/ssl/cert.pem"

pre_build() {
        _bfs_require_compat32_extension 2 || return 0
  prt-get isinst brotli && ! prt-get isinst brotli-32 && printf "\e[031mbrotli is detected on your system, please run:
  prt-get depinst brotli-32
  before continuing with curl-32.\033[0m\n" &&
  exit 1

  return 0
}

post_build() {

  rm -r $PKG/usr/{bin,include,share/man,share}
}
