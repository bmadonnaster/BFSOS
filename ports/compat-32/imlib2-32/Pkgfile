name=imlib2-32
version=1.12.4
release=1
source=(https://downloads.sourceforge.net/project/enlightenment/imlib2-src/$version/imlib2-$version.tar.xz)

build() {
	cd imlib2-$version

	./configure --prefix=/usr \
		--libdir=/usr/lib32 \
		--x-libraries=/usr/lib32 \
		--enable-mmx \
		--disable-amd64
	make
	make DESTDIR=$PKG install

	rm -r $PKG/usr/{bin,include,share}
}
