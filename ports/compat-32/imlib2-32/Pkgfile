# Description: A fast image manipulation library
# URL: https://sourceforge.net/projects/enlightenment/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: freetype-32 imlib2 libjpeg-turbo-32 libpng-32 libtiff-32 libSM-32 libXext-32 zstd-32
# Optional: libid3tag-32 giflib-32 libwebp-32

name=imlib2-32
version=1.12.7
release=3
source=(https://downloads.sourceforge.net/project/enlightenment/imlib2-src/$version/imlib2-$version.tar.xz)

build_opt="--x-libraries=/usr/lib32 --enable-mmx --disable-amd64"

post_build() {

	rm -r $PKG/usr/{bin,include,share}
}

pre_build() {
        _bfs_require_compat32_extension 2 || return $?
}
