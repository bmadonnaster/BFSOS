# Description: A collection of utilities to handle ELF objects.
# URL: https://sourceware.org/elfutils/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: bzip2-32 xz-32 zlib-32

name=elfutils-32
version=0.195
release=2
source=(https://sourceware.org/${name%-*}/ftp/$version/${name%-*}-$version.tar.bz2)

build_opt="--program-prefix=eu- --disable-debuginfod --disable-libdebuginfod --disable-nls"

post_build() {

	rm -r $PKG/usr/{bin,include,share/man}
}

pre_build() {
        _bfs_require_compat32_extension 2 || return $?
}
