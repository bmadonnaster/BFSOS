name=libgpg-error-32
version=1.50
release=1
source=(https://mirrors.dotsrc.org/gcrypt/${name%-*}/${name%-*}-$version.tar.bz2)

build() {
	cd ${name%-*}-$version

	./configure \
	    --host=i686-pc-linux-gnu      \
		--prefix=/usr \
		--libdir=/usr/lib32 \
		--disable-nls \
		--enable-static

	make
	make DESTDIR=$PKG install

	rm -r $PKG/usr/{share,bin,include}
}
