# Description: Provides support for IETF Internationalized Domain Names (IDN).
# URL: https://www.gnu.org/software/libidn/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on:

name=libidn133-32
version=1.44
release=2
source=(https://ftp.gnu.org/gnu/libidn/libidn-$version.tar.gz)

# Legacy 32-bit ABI package. Only the runtime libidn shared library is kept.
pkg_build() {
    ./configure \
        --prefix=/usr \
        --libdir=/usr/lib32 \
        --disable-nls \
        --disable-static || return 1

    make -C gl -j"${JOBS:-1}" || return 1
    make -C lib/gl -j"${JOBS:-1}" || return 1
    make -C lib -j"${JOBS:-1}" || return 1

    make -C lib DESTDIR="$PKG" install || return 1

    # Runtime compatibility package only: keep versioned shared objects,
    # remove development files and metadata.
    rm -f \
        "$PKG/usr/lib32/libidn.so" \
        "$PKG/usr/lib32/libidn.la"

    rm -rf \
        "$PKG/usr/include" \
        "$PKG/usr/lib32/pkgconfig" \
        "$PKG/usr/share"
}
