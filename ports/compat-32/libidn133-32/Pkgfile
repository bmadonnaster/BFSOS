# Description: Provides support for IETF Internationalized Domain Names (IDN).
# URL: https://www.gnu.org/software/libidn/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on:

name=libidn133-32
version=1.33
release=3
source=(https://ftp.gnu.org/gnu/libidn/libidn-$version.tar.gz)

# Custom build required: legacy ABI package intentionally prunes development links
pkg_build() {
  (
    set -e
	./configure \
		--prefix=/usr \
		--libdir=/usr/lib32 \
		--disable-nls \
		--disable-static
	sed -i 's/^SUBDIRS = .*/SUBDIRS = gl lib\/gl lib/' Makefile
	make
	make DESTDIR=$PKG install
	rm -r $PKG/usr/{bin,include,lib32/{libidn.so,libidn.la,pkgconfig},share}
  )
}
