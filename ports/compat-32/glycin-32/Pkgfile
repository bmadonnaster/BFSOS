# Description: Sandboxed and extendable image loading - 32-bit
# URL: https://gitlab.gnome.org/GNOME/glycin
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: glycin libseccomp-32 fontconfig-32 lcms2-32 llvm-32 glib-32 rustc
# Optional: libheif-32 libjxl-32 librsvg-32

name=glycin-32
version=2.2.0
release=3

source=(
    https://gitlab.gnome.org/GNOME/glycin/-/archive/$version/glycin-$version.tar.bz2
    i686

)

build_opt="-Dglycin-loaders=true \
-Dtest_skip_install=false \
-Dtests=false \
-Dglycin-thumbnailer=false \
-Dvapi=false \
-Dlibglycin-gtk4=false \
-Dintrospection=false \
-Dcapi_docs=false"

# Custom build required: glycin-32 selects optional loader components at build
# time and uses its package-local i686 Meson cross file/lib32 staging layout.
pkg_build() {
    (
        set -e

        prt-get isinst sccache && export RUSTC_WRAPPER=/usr/bin/sccache
        export PKG_CONFIG_ALLOW_CROSS=1

        local loaders="glycin-image-rs"
        prt-get isinst libheif-32 && loaders+=",glycin-heif"
        prt-get isinst libjxl-32  && loaders+=",glycin-jxl"
        prt-get isinst librsvg-32 && loaders+=",glycin-svg"

        meson setup build . \
            --cross-file="$SRC/i686" \
            --prefix=/usr \
            --libdir=lib32 \
            --libexecdir=lib32/$name \
            --buildtype=plain \
            --wrap-mode=nodownload \
            -Db_lto=true \
            -Db_pie=true \
            $build_opt \
            -Dloaders="$loaders"

        meson compile -C build -j "${JOBS:-1}"
        DESTDIR="$PKG" meson install -C build
    )
}

post_build() {
    rm -rf "$PKG/usr/include" "$PKG/usr/share"
}
