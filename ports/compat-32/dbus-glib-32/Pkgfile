name=dbus-glib-32
version=0.114
release=1
source=(https://dbus.freedesktop.org/releases/${name%-*}/${name%-*}-$version.tar.gz)

pkg_build() {

	./configure \
		--prefix=/usr \
		--libdir=/usr/lib32 \
		--enable-bash-completion=no

	make
	make DESTDIR=$PKG install

	rm -r $PKG/usr/{bin,share,include}
}
