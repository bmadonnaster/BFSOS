# Description: Transport Independent RPC library
# URL: https://git.linux-nfs.org/?p=steved/libtirpc.git;a=summary
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: libtirpc

name=libtirpc-32
version=1.3.7
release=2
source=(https://downloads.sourceforge.net/project/${name%-*}/${name%-*}/$version/${name%-*}-$version.tar.bz2)

build_opt="--disable-gssapi"

post_build() {

	rm -r $PKG/etc $PKG/usr/{include,share}
}

pre_build() {
        _bfs_require_compat32_extension 2 || return $?
}
