# Description: Transport Independent RPC library
# URL: https://git.linux-nfs.org/?p=steved/libtirpc.git;a=summary
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: libtirpc

name=libtirpc-32
version=1.3.8
release=1
source=(libtirpc-$version.tar.bz2::https://sourceforge.net/projects/libtirpc/files/libtirpc/$version/libtirpc-$version.tar.bz2/download)

build_opt="--disable-gssapi"

post_build() {

	rm -r $PKG/etc $PKG/usr/{include,share}
}

pre_build() {
        _bfs_require_compat32_extension 2 || return $?
}
