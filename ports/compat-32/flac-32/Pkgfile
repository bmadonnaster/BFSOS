# Description: Free Lossless Audio Codec.
# URL: https://xiph.org/flac/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: libogg-32

name=flac-32
version=1.5.0
release=4
source=(https://downloads.xiph.org/releases/flac/flac-$version.tar.xz)

build_opt="-D BUILD_SHARED_LIBS=ON -D BUILD_EXAMPLES=OFF -D BUILD_TESTING=OFF -Wno-dev"
build_type=cmake_build

post_build() {

	rm -rf $PKG/usr/{bin,include,share/man}
	rm -rf $PKG/usr/share
}

pre_build() {
        _bfs_require_compat32_extension 2 || return $?
}
