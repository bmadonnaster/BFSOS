name=libXtst-32
version=1.2.5
release=1
source=(https://www.x.org/releases/individual/lib/libXtst-$version.tar.xz)

build() {
	cd libXtst-$version

	./configure --prefix=/usr --libdir=/usr/lib32

	make
	make DESTDIR=$PKG install

	rm -r $PKG/usr/{include,share/man,share/doc,share}
}
