# Description: Free library for arbitrary precision arithmetic
# URL: https://gmplib.org/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>

name=libgmp-32
version=6.3.0
release=3
source=(https://gmplib.org/download/gmp/gmp-$version.tar.xz)

# Custom build required: package-specific ABI cleanup follows the Autotools build
pkg_build() {
  (
    set -e
	CC="gcc -std=gnu17" \
	CXX="g++ -std=gnu++17" \
	./configure \
		--prefix=/usr \
		--libdir=/usr/lib32 \
		--enable-cxx \
		--build=i686-pc-linux-gnu

	make
	make DESTDIR=$PKG install

	mv $PKG/usr/include/gmp{,-32}.h
	rm $PKG/usr/include/gmpxx.h

	rm -r $PKG/usr/share
  )
}
