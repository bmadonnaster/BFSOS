name=libXdmcp-32
version=1.1.5
release=1
source=(https://www.x.org/releases/individual/lib/libXdmcp-$version.tar.xz)

pkg_build() {

	./configure     --host=i686-pc-linux-gnu --prefix=/usr --libdir=/usr/lib32

	make
	make DESTDIR=$PKG install

	rm -r $PKG/usr/{include,share/doc}
}
