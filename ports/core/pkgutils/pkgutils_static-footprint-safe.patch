 make_footprint() {
-	pkginfo --footprint $TARGET | \
+	# Propagate pkginfo failures through the pipeline (including SIGSEGV).
+	( set -o pipefail
+	  pkginfo --footprint "$TARGET" | \
 		sed "s|\tlib/modules/`uname -r`/|\tlib/modules/<kernel-version>/|g" | \
 		sort -k 3
+	)
 }
 
 check_md5sum() {
@@ -503,7 +506,12 @@
 	cd $PKGMK_ROOT
 
 	if [ -f $TARGET ]; then
-		make_footprint > $FILE.footprint
+		if ! make_footprint > "$FILE.footprint" || [ ! -s "$FILE.footprint" ]; then
+			error "Unable to generate package footprint; preserving existing metadata."
+			rm -f "$FILE.footprint"
+			BUILD_SUCCESSFUL="no"
+			return 1
+		fi
 		if [ -f $PKGMK_FOOTPRINT ]; then
 			sort -k 3 $PKGMK_FOOTPRINT > $FILE.footprint.orig
 			diff -w -t -U 0 $FILE.footprint.orig $FILE.footprint | \
@@ -689,9 +697,20 @@
 		exit 1
 	fi
 
-	check_file "$PKGMK_FOOTPRINT"
-	make_footprint > $PKGMK_FOOTPRINT
-	touch $TARGET
+	# Generate to a temporary file; never truncate the existing footprint
+	# when pkginfo crashes, fails, or returns an empty listing.
+	local FOOTPRINT_TMP="${PKGMK_FOOTPRINT}.bfsos-tmp.$$"
+	if ! make_footprint > "$FOOTPRINT_TMP" || [ ! -s "$FOOTPRINT_TMP" ]; then
+		rm -f "$FOOTPRINT_TMP"
+		error "Unable to generate package footprint; existing footprint unchanged."
+		exit 1
+	fi
+	if ! mv -f -- "$FOOTPRINT_TMP" "$PKGMK_FOOTPRINT"; then
+		rm -f "$FOOTPRINT_TMP"
+		error "Unable to replace package footprint."
+		exit 1
+	fi
+	touch "$TARGET"
 
 	info "Footprint updated."
 }
