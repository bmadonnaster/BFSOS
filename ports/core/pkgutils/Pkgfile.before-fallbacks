# Description: CRUX package management utilities with BFSOS pkgmk extensions
# URL: https://crux.nu/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>

name=pkgutils
version=5.40.12
release=20
source=(https://crux.nu/files/$name-$version.tar.xz
        pkgadd.conf
        pkgmk.conf
        extension
        bfs-pkgmk)

# CRUX pkgmk normally removes PKGMK_WORK_DIR itself.  BFSOS can place that
# path directly on tmpfs, so preserve an active mountpoint and clean only its
# contents.  Ordinary per-package child work directories are still removed.
harden_pkgmk_work_cleanup() {
        local target="$1" tmp="${1}.bfsos-new"
        awk '
        /^remove_work_dir\(\)[[:space:]]*\{/ {
                print "remove_work_dir() {"
                print "        [ -e \"$PKGMK_WORK_DIR\" ] || return 0"
                print "        if command -v mountpoint >/dev/null 2>&1 && mountpoint -q \"$PKGMK_WORK_DIR\"; then"
                print "                find \"$PKGMK_WORK_DIR\" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +"
                print "        else"
                print "                rm -rf -- \"$PKGMK_WORK_DIR\""
                print "        fi"
                print "}"
                skip=1
                next
        }
        skip && /^}/ { skip=0; next }
        !skip { print }
        ' "$target" > "$tmp" || return 1
        cat "$tmp" > "$target" || return 1
        rm -f "$tmp"
}

# r152: retire the r148 download_source wrapper experiment. Live sysup
# testing proved that rewriting the core function could leave pkgmk calling
# download_source() without defining it. Keep CRUX pkgmk download logic intact;
# validation must never rename/replace core pkgmk functions.
bootstrap_build() {
        # Select a UTF-8 C locale when the current environment provides one
        # (needed by libarchive for archives such as GCC), but retain a plain-C
        # fallback for early chroot phases where no UTF-8 locale exists yet.
        sed -i '/^export LC_ALL=C\.UTF-8$/c\
_bfs_utf8_locale=""\
_bfs_locale_cmd=""\
_bfs_pkgmk_path="$(readlink -f "$0" 2>/dev/null || printf "%s" "$0")"\
case "$_bfs_pkgmk_path" in\
    */tmp/lfs-tools/*) [ -x /tmp/lfs-tools/bin/locale ] && _bfs_locale_cmd=/tmp/lfs-tools/bin/locale ;;\
    *) [ -x /usr/bin/locale ] && _bfs_locale_cmd=/usr/bin/locale ;;\
esac\
[ -n "$_bfs_locale_cmd" ] || [ ! -x /usr/bin/locale ] || _bfs_locale_cmd=/usr/bin/locale\
[ -n "$_bfs_locale_cmd" ] || _bfs_locale_cmd="$(command -v locale 2>/dev/null || true)"\
for _bfs_locale in C.UTF-8 C.utf8; do\
    if [ -n "$_bfs_locale_cmd" ] && \
       "$_bfs_locale_cmd" -a 2>/dev/null | grep -Fxiq "$_bfs_locale" && \
       LC_ALL="$_bfs_locale" "$_bfs_locale_cmd" charmap 2>/dev/null | grep -Fxiq UTF-8; then\
        _bfs_utf8_locale="$_bfs_locale"\
        break\
    fi\
done\
if [ -n "$_bfs_utf8_locale" ]; then\
    export LC_ALL="$_bfs_utf8_locale"\
else\
    export LC_ALL=C\
fi\
unset _bfs_utf8_locale _bfs_locale _bfs_locale_cmd _bfs_pkgmk_path' pkgmk.in

        sed -i -e 's/ --static//' \
               -e 's/ -static//' Makefile

        make BINDIR=$TOOLS/bin MANDIR=$TOOLS/man ETCDIR=$TOOLS/etc install
        harden_pkgmk_work_cleanup "$TOOLS/bin/pkgmk"
}

post_build() {
        harden_pkgmk_work_cleanup "$PKG/usr/bin/pkgmk"

        # Final/installed pkgmk needs a UTF-8-capable C locale for archives
        # containing non-ASCII pathnames (notably GCC). Support both common
        # spellings and fall back to plain C only if neither exists.
        sed -i '/^export LC_ALL=C\.UTF-8$/c\
_bfs_utf8_locale=""\
_bfs_locale_cmd=""\
_bfs_pkgmk_path="$(readlink -f "$0" 2>/dev/null || printf "%s" "$0")"\
case "$_bfs_pkgmk_path" in\
    */tmp/lfs-tools/*) [ -x /tmp/lfs-tools/bin/locale ] && _bfs_locale_cmd=/tmp/lfs-tools/bin/locale ;;\
    *) [ -x /usr/bin/locale ] && _bfs_locale_cmd=/usr/bin/locale ;;\
esac\
[ -n "$_bfs_locale_cmd" ] || [ ! -x /usr/bin/locale ] || _bfs_locale_cmd=/usr/bin/locale\
[ -n "$_bfs_locale_cmd" ] || _bfs_locale_cmd="$(command -v locale 2>/dev/null || true)"\
for _bfs_locale in C.UTF-8 C.utf8; do\
    if [ -n "$_bfs_locale_cmd" ] && \
       "$_bfs_locale_cmd" -a 2>/dev/null | grep -Fxiq "$_bfs_locale" && \
       LC_ALL="$_bfs_locale" "$_bfs_locale_cmd" charmap 2>/dev/null | grep -Fxiq UTF-8; then\
        _bfs_utf8_locale="$_bfs_locale"\
        break\
    fi\
done\
if [ -n "$_bfs_utf8_locale" ]; then\
    export LC_ALL="$_bfs_utf8_locale"\
else\
    export LC_ALL=C\
fi\
unset _bfs_utf8_locale _bfs_locale _bfs_locale_cmd _bfs_pkgmk_path' "$PKG/usr/bin/pkgmk"

        # Store sources, packages, and normal pkgmk work in /var/cache/pkg.
        sed -i 's,^PKGMK_SOURCE_DIR=.*,PKGMK_SOURCE_DIR="/var/cache/pkg/sources",' "$PKG/usr/bin/pkgmk"
        sed -i 's,^PKGMK_PACKAGE_DIR=.*,PKGMK_PACKAGE_DIR="/var/cache/pkg/packages",' "$PKG/usr/bin/pkgmk"
        sed -i 's,^PKGMK_WORK_DIR=.*,PKGMK_WORK_DIR="/var/cache/pkg/build-work/pkgmk-$name",' "$PKG/usr/bin/pkgmk"

        # Keep the cache parent root-owned; only build-data directories
        # are writable by the dedicated pkgmk account (UID/GID 82).
        install -dm755 -o 0 -g 0 "$PKG/var/cache/pkg"

        install -dm775 -o 82 -g 82 \
                "$PKG/var/cache/pkg/sources" \
                "$PKG/var/cache/pkg/packages" \
                "$PKG/var/cache/pkg/build-work"

        install -dm775 -o 82 -g 82 "$PKG/var/cache/ccache"

        # Use xz as the default package compression mode.
        sed -i 's,^PKGMK_COMPRESSION_MODE=.*,PKGMK_COMPRESSION_MODE="xz",' "$PKG/usr/bin/pkgmk"

        # BFSOS currently ignores source signatures by default.
        sed -i 's,^PKGMK_IGNORE_SIGNATURE=.*,PKGMK_IGNORE_SIGNATURE="yes",' "$PKG/usr/bin/pkgmk"

        # BFSOS pkgmk extension.
        install -Dm644 "$SRC/extension" "$PKG/var/lib/pkgmk/extension"
        install -Dm755 "$SRC/bfs-pkgmk" "$PKG/usr/bin/bfs-pkgmk"
        install -dm755 -o 82 -g 82 "$PKG/var/lib/pkgmk"
        install -Dm664 /dev/null "$PKG/var/lib/pkgmk/build-times.log"
        chown 82:82 "$PKG/var/lib/pkgmk/build-times.log"

        # Configuration.
        install -m644 "$SRC/pkgadd.conf" "$PKG/etc/pkgadd.conf"
        install -m644 "$SRC/pkgmk.conf" "$PKG/etc/pkgmk.conf"
}
