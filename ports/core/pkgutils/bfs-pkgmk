#!/bin/sh
set -eu

start_epoch="$(date +%s)"
start_stamp="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
status=0

# pkgutils upgrades are self-hosting.  If a previous interrupted pkgadd -u
# removed the installed extension before replacement, restore it from the
# synced core port before invoking pkgmk.
if [ ! -r /var/lib/pkgmk/extension ] \
   && [ "$(id -u)" -eq 0 ] \
   && [ -r /usr/ports/core/pkgutils/extension ]; then
    install -d -m755 -o 0 -g 0 /var/lib/pkgmk
    install -m644 -o 0 -g 0 \
        /usr/ports/core/pkgutils/extension /var/lib/pkgmk/extension
    printf '%s\n' \
        'BFSOS pkgmk: restored missing /var/lib/pkgmk/extension from the core port' >&2
fi

# Fail early with a truthful diagnostic rather than treating alias::URL as a
# missing local file. Current BFSOS pkgmk does not implement URL aliases.
if [ -r ./Pkgfile ] && grep -Ev '^[[:space:]]*#' ./Pkgfile \
    | grep -Eq '[^[:space:]"()]+::https?://'; then
    printf '%s\n' 'BFSOS pkgmk: unsupported source alias filename::URL in Pkgfile; use a tested plain URL or repair the port' >&2
    exit 4
fi

# Determine ABI from the active ports collection.
# A compat-32 build must use PKGMK_ARCH=32, while native collections must
# never inherit that setting from an earlier dependency build.
case "$PWD/" in
    */compat-32/*)
        export PKGMK_ARCH=32
        ;;
    *)
        unset PKGMK_ARCH
        ;;
esac

# Select the build-work backend before pkgmk creates or extracts any work.
# An explicit environment override wins. Otherwise honor build_work= metadata,
# but redirect unsafe tmpfs choices and known-large builds to persistent disk.
bfs_backend_forced=0
[ -n "${BFS_PKG_BUILD_WORK:-}" ] && bfs_backend_forced=1
bfs_port_build_work=""
if [ "$bfs_backend_forced" -eq 0 ] && [ -r ./Pkgfile ]; then
    bfs_port_build_work="$(
        sed -n 's/^[[:space:]]*build_work[[:space:]]*=[[:space:]]*["'"'"']\{0,1\}\([^"'"'"'[:space:]#]*\).*/\1/p' ./Pkgfile | head -n1
    )"
    [ -n "$bfs_port_build_work" ] && BFS_PKG_BUILD_WORK="$bfs_port_build_work"
fi

bfs_pkg_name="$(sed -n 's/^[[:space:]]*name[[:space:]]*=[[:space:]]*["'"'"']\{0,1\}\([^"'"'"'[:space:]#]*\).*/\1/p' ./Pkgfile 2>/dev/null | head -n1)"
bfs_large=0
case "$bfs_pkg_name" in
    libreoffice|llvm|llvm-32|clang|clang-32|mesa|mesa-32|rustc|gcc|chromium|firefox|firefox-esr|webkitgtk*|qtwebengine*) bfs_large=1 ;;
esac

bfs_tmpfs_root="/var/cache/pkg/build-work"
bfs_min_gib="${BFS_TMPFS_MIN_FREE_GIB:-16}"
case "$bfs_min_gib" in *[!0-9]*|'') bfs_min_gib=16 ;; esac
bfs_min_kb=$((bfs_min_gib * 1024 * 1024))
bfs_tmpfs_free_kb="$(df -Pk "$bfs_tmpfs_root" 2>/dev/null | awk 'NR==2 {print $4}')"
case "$bfs_tmpfs_free_kb" in *[!0-9]*|'') bfs_tmpfs_free_kb=0 ;; esac

if [ "$bfs_backend_forced" -eq 0 ]; then
    if [ "$bfs_large" -eq 1 ]; then
        BFS_PKG_BUILD_WORK=disk
    elif [ "${BFS_PKG_BUILD_WORK:-tmpfs}" = tmpfs ] && [ "$bfs_tmpfs_free_kb" -lt "$bfs_min_kb" ]; then
        BFS_PKG_BUILD_WORK=disk
    else
        BFS_PKG_BUILD_WORK="${BFS_PKG_BUILD_WORK:-tmpfs}"
    fi
fi
case "${BFS_PKG_BUILD_WORK:-tmpfs}" in
    tmpfs|disk) export BFS_PKG_BUILD_WORK ;;
    *)
        printf 'BFSOS pkgmk: invalid build_work backend %s (expected tmpfs or disk)\n' \
            "$BFS_PKG_BUILD_WORK" >&2
        exit 2
        ;;
esac
if [ "$BFS_PKG_BUILD_WORK" = disk ]; then
    bfs_disk_root="${PKGMK_DISK_WORK_ROOT:-/var/cache/pkg/build-work-disk}"
    bfs_probe="$bfs_disk_root"
    while [ ! -e "$bfs_probe" ] && [ "$bfs_probe" != / ]; do bfs_probe="${bfs_probe%/*}"; [ -n "$bfs_probe" ] || bfs_probe=/; done
    bfs_fs="$(stat -f -c %T "$bfs_probe" 2>/dev/null || true)"
    case "$bfs_fs" in tmpfs|ramfs)
        printf 'BFSOS pkgmk: refusing disk backend because %s is %s\n' "$bfs_disk_root" "$bfs_fs" >&2
        exit 2 ;;
    esac
fi
unset bfs_port_build_work bfs_pkg_name bfs_large bfs_tmpfs_root bfs_min_gib bfs_min_kb bfs_tmpfs_free_kb bfs_backend_forced bfs_disk_root bfs_probe bfs_fs

# Maintain per-port download-cache ownership across direct sudo and prt-get.
# Never recurse into a source cache and never follow symlinks.  Existing
# directories with unexpected non-root/non-pkgmk owners are left untouched.
if [ "$(id -u)" -eq 0 ] && id pkgmk >/dev/null 2>&1 && [ -r ./Pkgfile ]; then
    bfs_cache_pkg="$(sed -n 's/^[[:space:]]*name=\([A-Za-z0-9+_.-]*\)[[:space:]]*$/\1/p' ./Pkgfile | head -n1)"
    if [ -n "$bfs_cache_pkg" ]; then
        bfs_cache_parent=/var/cache/pkg/sources
        bfs_cache_dir="$bfs_cache_parent/$bfs_cache_pkg"
        if [ -d "$bfs_cache_parent" ] && [ ! -L "$bfs_cache_parent" ] && [ ! -L "$bfs_cache_dir" ]; then
            if [ -d "$bfs_cache_dir" ]; then
                bfs_cache_owner="$(stat -c '%U' "$bfs_cache_dir" 2>/dev/null || true)"
                case "$bfs_cache_owner" in
                    root|pkgmk) chown pkgmk:pkgmk "$bfs_cache_dir" && chmod 775 "$bfs_cache_dir" ;;
                    *) printf 'BFSOS pkgmk: unsafe source-cache owner: %s\n' "$bfs_cache_dir" >&2; exit 126 ;;
                esac
            elif [ ! -e "$bfs_cache_dir" ]; then
                install -dm775 -o pkgmk -g pkgmk "$bfs_cache_dir" || exit 126
            fi
        fi
    fi
fi
unset bfs_cache_pkg bfs_cache_parent bfs_cache_dir bfs_cache_owner

# Resolve package-build parallelism before pkgmk sources pkgmk.conf.  Explicit
# BFS_PKG_BUILD_JOBS/JOBS is preserved, otherwise use every available logical
# CPU.  A simple top-level build_jobs=N is an intentional per-port upper cap.
bfs_jobs="${BFS_PKG_BUILD_JOBS:-${JOBS:-}}"
if [ -z "$bfs_jobs" ]; then
    bfs_jobs="$(nproc 2>/dev/null || getconf _NPROCESSORS_ONLN 2>/dev/null || printf 1)"
fi
case "$bfs_jobs" in *[!0-9]*|'') bfs_jobs=1 ;; esac
[ "$bfs_jobs" -gt 0 ] 2>/dev/null || bfs_jobs=1
if [ -r ./Pkgfile ]; then
    bfs_port_jobs="$(sed -n 's/^[[:space:]]*build_jobs[[:space:]]*=[[:space:]]*["'"'"']\{0,1\}\([0-9][0-9]*\).*/\1/p' ./Pkgfile | head -n1)"
    if [ -n "$bfs_port_jobs" ] && [ "$bfs_port_jobs" -lt "$bfs_jobs" ]; then
        bfs_jobs="$bfs_port_jobs"
    fi
fi
export JOBS="$bfs_jobs"
export MAKEFLAGS="-j$bfs_jobs"
export CMAKE_BUILD_PARALLEL_LEVEL="$bfs_jobs"
unset bfs_jobs bfs_port_jobs

human_elapsed() {
    total="${1:-0}"
    case "$total" in *[!0-9]*|'') total=0 ;; esac
    days=$((total / 86400))
    hours=$(((total % 86400) / 3600))
    minutes=$(((total % 3600) / 60))
    seconds=$((total % 60))
    if [ "$days" -gt 0 ]; then
        printf '%dd %dh %02dm %02ds' "$days" "$hours" "$minutes" "$seconds"
    elif [ "$hours" -gt 0 ]; then
        printf '%dh %02dm %02ds' "$hours" "$minutes" "$seconds"
    elif [ "$minutes" -gt 0 ]; then
        printf '%dm %02ds' "$minutes" "$seconds"
    else
        printf '%ds' "$seconds"
    fi
}

# Prefer a persistent pkgmk-owned history location.  Fall back to /tmp only
# during very early/bootstrap contexts where /var/lib/pkgmk is unavailable.
history_dir="/var/lib/pkgmk"
history_file="$history_dir/build-times.log"
if ! mkdir -p "$history_dir" 2>/dev/null; then
    history_file="/tmp/bfs-pkgmk-build-times.log"
fi

# pkgmk writes .md5sum/.footprint/.signature in its working port directory.
# Developer checkouts must remain developer-owned, while the actual build
# continues under the unprivileged pkgmk account. Stage a private copy when
# the invoking root process cannot give pkgmk write access to this directory.
bfs_port_dir="$PWD"
bfs_stage=""
if [ "$(id -u)" -eq 0 ] && command -v runuser >/dev/null 2>&1 && id pkgmk >/dev/null 2>&1; then
    if ! runuser -u pkgmk -- test -w "$bfs_port_dir"; then
        bfs_stage_parent="${PKGMK_DISK_WORK_ROOT:-/var/cache/pkg/build-work-disk}"
        if [ ! -d "$bfs_stage_parent" ]; then
            printf 'BFSOS pkgmk: missing staging root: %s\n' "$bfs_stage_parent" >&2
            exit 126
        fi
        bfs_stage="$(mktemp -d "$bfs_stage_parent/bfs-port-stage.XXXXXXXX")"
        chmod 700 "$bfs_stage"
        # Only the individual port, not the entire Git checkout, is copied.
        cp -a "$bfs_port_dir/." "$bfs_stage/"
        chown -R pkgmk:pkgmk "$bfs_stage"
        printf 'BFSOS pkgmk: building from pkgmk-owned staging copy; original=%s\n' "$bfs_port_dir" >&2
    fi
fi

bfs_cleanup_stage() {
    # EXIT also runs after INT/TERM: recover a previously good archive if
    # the wrapper is interrupted before it reaches normal commit/rollback.
    if [ -n "${bfs_saved_archive:-}" ] && [ -f "$bfs_saved_archive" ] && [ -n "${bfs_previous_archive:-}" ]; then
        rm -f -- "$bfs_previous_archive" || true
        mv -- "$bfs_saved_archive" "$bfs_previous_archive" ||
            echo 'BFSOS pkgmk: CRITICAL: archived backup requires manual recovery' >&2
    fi
    if [ -n "$bfs_stage" ]; then
        rm -rf -- "$bfs_stage"
    fi
}
# EXIT is for staging cleanup. Signals are handled separately so a cancelled
# pkgmk cannot leave an entire configure/make/fakeroot process tree behind.
# Never blindly kill by name, and never delete active SysV IPC objects.
bfs_active_pid=""
bfs_interrupt() {
    sig="$1"
    trap - HUP INT TERM
    if [ -n "$bfs_active_pid" ]; then
        # setsid creates a unique process group, whose leader is our child.
        # Confirm the PGID before targeting it to avoid touching other builds.
        pgid="$(ps -o pgid= -p "$bfs_active_pid" 2>/dev/null | tr -d ' ' || true)"
        if [ "$pgid" = "$bfs_active_pid" ]; then
            kill -TERM -- "-$bfs_active_pid" 2>/dev/null || true
            # Allow children to unwind cleanly; never block forever here.
            count=0
            while [ "$count" -lt 5 ] && kill -0 "$bfs_active_pid" 2>/dev/null; do
                sleep 1
                count=$((count + 1))
            done
            pgid="$(ps -o pgid= -p "$bfs_active_pid" 2>/dev/null | tr -d ' ' || true)"
            if [ "$pgid" = "$bfs_active_pid" ]; then
                kill -KILL -- "-$bfs_active_pid" 2>/dev/null || true
            fi
        fi
        wait "$bfs_active_pid" 2>/dev/null || true
    fi
    case "$sig" in INT) exit 130 ;; HUP) exit 129 ;; TERM) exit 143 ;; esac
}
trap bfs_cleanup_stage EXIT
trap 'bfs_interrupt HUP' HUP
trap 'bfs_interrupt INT' INT
trap 'bfs_interrupt TERM' TERM

bfs_sync_metadata() {
    [ -n "$bfs_stage" ] || return 0
    # Metadata only, never copy the package recipe or arbitrary build output
    # into a developer-owned checkout. Use rename to avoid following symlinks.
    bfs_uid="$(stat -c %u "$bfs_port_dir")"
    bfs_gid="$(stat -c %g "$bfs_port_dir")"
    for bfs_meta in .md5sum .footprint .signature; do
        [ -e "$bfs_stage/$bfs_meta" ] || continue
        if [ ! -f "$bfs_stage/$bfs_meta" ] || [ -L "$bfs_stage/$bfs_meta" ] || [ -L "$bfs_port_dir/$bfs_meta" ]; then
            printf 'BFSOS pkgmk: unsafe metadata path: %s\n' "$bfs_meta" >&2
            return 1
        fi
        bfs_tmp="$bfs_port_dir/.$${bfs_meta}.bfs-new"
        if ! install -m 644 -o "$bfs_uid" -g "$bfs_gid" "$bfs_stage/$bfs_meta" "$bfs_tmp"; then
            rm -f -- "$bfs_tmp"
            return 1
        fi
        if ! mv -f -- "$bfs_tmp" "$bfs_port_dir/$bfs_meta"; then
            rm -f -- "$bfs_tmp"
            return 1
        fi
        printf 'BFSOS pkgmk: metadata updated: %s\n' "$bfs_port_dir/$bfs_meta"
    done
}

# Only ports explicitly migrated to two functions opt into the new flow.
# A regular CRUX recipe still uses the legacy fakeroot invocation.
bfs_split=0
if [ -r ./Pkgfile ] && grep -Eq '^[[:space:]]*bfs_build_phases=split([[:space:]]|$)' ./Pkgfile; then
    bfs_split=1
    export BFS_PKG_SPLIT_BUILD=yes
fi

run_pkgmk() {
    if [ "$(id -u)" -eq 0 ] \
       && command -v runuser >/dev/null 2>&1 \
       && command -v fakeroot >/dev/null 2>&1 \
       && id pkgmk >/dev/null 2>&1; then
        # Detached session for reliable Ctrl+C / TERM process-tree cleanup.
        # This keeps UID 82 and the existing fakeroot packaging semantics.
        command -v setsid >/dev/null 2>&1 || {
            printf '%s\n' 'BFSOS pkgmk: setsid required for isolated build cleanup' >&2
            return 126
        }
        if [ "$bfs_split" -eq 1 ]; then
            printf 'BFSOS pkgmk: split build, compilation outside fakeroot\n' >&2
            setsid runuser -u pkgmk -- env HOME=/var/lib/pkgmk USER=pkgmk LOGNAME=pkgmk \
                CCACHE_DIR=/var/cache/ccache BFS_PKG_SPLIT_BUILD=yes pkgmk "$@" &
        else
            printf 'BFSOS pkgmk: universal unprivileged classic build\n' >&2
            setsid runuser -u pkgmk -- env HOME=/var/lib/pkgmk USER=pkgmk LOGNAME=pkgmk \
                CCACHE_DIR=/var/cache/ccache BFS_PKG_UNIVERSAL_BUILD=yes pkgmk "$@" &
        fi
        bfs_active_pid=$!
        # wait is interrupted by a trapped signal; bfs_interrupt handles the
        # session group. Under normal completion wait returns pkgmk's status.
        wait "$bfs_active_pid"
        rc=$?
        bfs_active_pid=""
        return "$rc"
    elif [ "$(id -u)" -eq 0 ]; then
        printf '%s\n' 'BFSOS pkgmk: refusing to build as root: runuser, fakeroot and pkgmk account are required' >&2
        exit 126
    else
        # An unprivileged caller may build from a developer checkout when
        # its workspace is writable. Never silently become root.
        pkgmk "$@"
    fi
}

# BFSOS ports are unsigned by default.  If a port has a .signature, let
# pkgmk verify it normally; never suppress an invalid existing signature.
# CRUX pkgmk expects -is for unsigned ports when signature checking is on.
# Apply that flag only to normal unsigned builds, not explicit signature
# operations (-cs/-us/-rs) or a repository opting into mandatory signatures.
# The opt-in policy is BFS_REQUIRE_SIGNATURES=yes in /etc/pkgmk.conf (or the
# environment).  Read the literal config setting without evaluating shell.
bfs_signature_required="${BFS_REQUIRE_SIGNATURES:-}"
if [ -z "$bfs_signature_required" ] && [ -r /etc/pkgmk.conf ]; then
    bfs_signature_required="$(
        sed -n 's/^[[:space:]]*BFS_REQUIRE_SIGNATURES[[:space:]]*=[[:space:]]*//p' \
            /etc/pkgmk.conf | tail -n1 | sed 's/[[:space:]#].*$//' | tr -d '\"' 
    )"
fi
case "$bfs_signature_required" in
    ''|no|yes) ;;
    *) printf 'BFSOS pkgmk: invalid BFS_REQUIRE_SIGNATURES=%s (expected yes or no)\n' \
           "$bfs_signature_required" >&2; exit 2 ;;
esac

bfs_signature_operation=0
bfs_signature_override=0
for bfs_option do
    case "$bfs_option" in
        -cs|--check-signature|-us|--update-signature|-rs|--refresh-signature)
            bfs_signature_operation=1 ;;
        -is|--ignore-signature) bfs_signature_override=1 ;;
    esac
done
if [ ! -e .signature ] && [ ! -L .signature ] \
   && [ "$bfs_signature_required" != yes ] \
   && [ "$bfs_signature_operation" -eq 0 ] \
   && [ "$bfs_signature_override" -eq 0 ]; then
    # -is only bypasses signature checking. MD5 and footprint stay enabled.
    set -- -is "$@"
fi
unset bfs_signature_operation bfs_signature_required bfs_signature_override bfs_option

# r513: A root-built package archive can be mode 0644 and cannot be overwritten
# by the pkgmk account. For an explicit forced rebuild, move only the exact
# expected archive out of the way under root control, preserving it until
# the new package passes validation. Do not touch a prior archive for -uf.
bfs_force_build=no
bfs_metadata_only=no
for bfs_arg do
    case "$bfs_arg" in
        -f|--force) bfs_force_build=yes ;;
        -uf|--update-footprint) bfs_metadata_only=yes ;;
    esac
done
bfs_previous_archive=""
bfs_saved_archive=""
if [ "$(id -u)" -eq 0 ] && [ "$bfs_force_build" = yes ] && [ "$bfs_metadata_only" != yes ]; then
    bfs_identity="$(sed -n 's/^name=\([A-Za-z0-9+_.-]*\)$/\1/p' ./Pkgfile | head -n1)"
    bfs_version="$(sed -n 's/^version=\([A-Za-z0-9+_.-]*\)$/\1/p' ./Pkgfile | head -n1)"
    bfs_release="$(sed -n 's/^release=\([A-Za-z0-9+_.-]*\)$/\1/p' ./Pkgfile | head -n1)"
    bfs_outdir=/var/cache/pkg/packages
    bfs_out="$bfs_outdir/$bfs_identity#$bfs_version-$bfs_release.pkg.tar.zst"
    if [ -n "$bfs_identity" ] && [ -n "$bfs_version" ] && [ -n "$bfs_release" ] && [ -f "$bfs_out" ]; then
        [ ! -L "$bfs_out" ] && [ ! -L "$bfs_outdir" ] || {
            echo 'BFSOS pkgmk: unsafe output symlink; refusing forced build' >&2; exit 126;
        }
        bfs_saved_archive="$(mktemp "$bfs_outdir/.bfs-previous-${bfs_identity}.XXXXXXXX")" || exit 126
        rm -f -- "$bfs_saved_archive"
        mv -- "$bfs_out" "$bfs_saved_archive" || exit 126
        bfs_previous_archive="$bfs_out"
        echo "BFSOS pkgmk: saved existing artifact pending validation: $bfs_out" >&2
    fi
fi
unset bfs_arg bfs_identity bfs_version bfs_release bfs_outdir bfs_out

# Keep the launcher in the parent shell: the signal handler must know the
# active process-group leader even for builds using a private staging copy.
bfs_original_workdir="$PWD"
if [ -n "$bfs_stage" ]; then
    cd "$bfs_stage"
fi
set +e
run_pkgmk "$@"
status=$?
set -e
cd "$bfs_original_workdir"

# Resolve package identity immediately so a failed build can never leave a
# reusable archive behind. This also lets us validate successful-looking
# archives before reporting success to prt-get.
pkg_name="unknown"
pkg_version="unknown"
pkg_release="unknown"
if [ -r ./Pkgfile ]; then
    pkg_name="$(sed -n 's/^name=//p' ./Pkgfile | head -n1 | tr -d '"' || true)"
    pkg_version="$(sed -n 's/^version=//p' ./Pkgfile | head -n1 | tr -d '"' || true)"
    pkg_release="$(sed -n 's/^release=//p' ./Pkgfile | head -n1 | tr -d '"' || true)"
fi

package_glob="${pkg_name}#${pkg_version}-${pkg_release}.pkg.tar.*"

# Honor a simple PKGMK_PACKAGE_DIR assignment from the active configuration so
# failure cleanup is not tied to BFSOS's default cache path.  Keep the default
# as a fallback for early/bootstrap environments.
package_dir="${PKGMK_PACKAGE_DIR:-}"

if [ -z "$package_dir" ] && [ -r /etc/pkgmk.conf ]; then
    package_dir="$(
        awk -F= '
            /^[[:space:]]*PKGMK_PACKAGE_DIR[[:space:]]*=/ {
                value = substr($0, index($0, "=") + 1)
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)

                if ((value ~ /^".*"$/) || (value ~ /^\047.*\047$/))
                    value = substr(value, 2, length(value) - 2)

                print value
            }
        ' /etc/pkgmk.conf | tail -n1
    )"
fi

[ -n "$package_dir" ] || package_dir=/var/cache/pkg/packages

# Never remove prior known-good archives on build failure.
# The forced-build backup below is restored when necessary.

if [ "$status" -eq 0 ] && [ "$pkg_name" != unknown ]; then
    archive_list="/tmp/bfs-pkgmk-archive-list.$$"
    archive_seen=no
    for archive in "$package_dir"/$package_glob; do
        [ -f "$archive" ] || continue
        archive_seen=yes
        if ! bsdtar -tf "$archive" >"$archive_list" 2>/dev/null || [ ! -s "$archive_list" ]; then
            printf 'BFSOS pkgmk: rejecting invalid or empty package archive: %s\n' "$archive" >&2
            status=1
            break
        fi
        # A directory-only archive is not an installable package payload. This
        # catches failed builds that previously produced only entries such as
        # usr/ while still returning a successful pkgmk status.
        if ! awk 'substr($0, length($0), 1) != "/" { found=1; exit } END { exit !found }' "$archive_list"; then
            printf 'BFSOS pkgmk: rejecting directory-only package archive: %s\n' "$archive" >&2
            status=1
            break
        fi
    done
    rm -f "$archive_list" 2>/dev/null || true
    if [ "$bfs_force_build" = yes ] && [ "$bfs_metadata_only" != yes ] && [ "$archive_seen" = no ]; then
        echo 'BFSOS pkgmk: forced build produced no archive' >&2
        status=1
    fi
fi

# Synchronize metadata only after a successful archive validation.
if [ "$status" -eq 0 ]; then
    if ! bfs_sync_metadata; then
        printf 'BFSOS pkgmk: metadata synchronization failed\n' >&2
        status=1
    fi
fi

# Restore prior known-good archive if any later step fails, including a
# failed metadata sync. This never recursively changes cache ownership.
if [ -n "$bfs_saved_archive" ]; then
    if [ "$status" -eq 0 ]; then
        if rm -f -- "$bfs_saved_archive"; then
            bfs_saved_archive=""
        else
            status=1
        fi
    else
        if [ -n "$bfs_previous_archive" ]; then
            rm -f -- "$bfs_previous_archive"
            if mv -- "$bfs_saved_archive" "$bfs_previous_archive"; then
                bfs_saved_archive=""
            else
                echo 'BFSOS pkgmk: CRITICAL: failed restoring previous archive' >&2
                status=1
            fi
        fi
    fi
fi

end_epoch="$(date +%s)"
elapsed=$((end_epoch - start_epoch))

line="$(printf '%s\tpkgmk\t%s\t%s\t%s\tstatus=%s\telapsed_seconds=%s\n' \
    "$start_stamp" "$pkg_name" "$pkg_version" "$pkg_release" "$status" "$elapsed")"

if [ -w "$history_file" ] || { [ ! -e "$history_file" ] && [ -w "$(dirname "$history_file")" ]; }; then
    printf '%s' "$line" >> "$history_file" 2>/dev/null || true
elif command -v runuser >/dev/null 2>&1 && id pkgmk >/dev/null 2>&1; then
    printf '%s' "$line" | runuser -u pkgmk -- sh -c 'cat >> /var/lib/pkgmk/build-times.log' 2>/dev/null || true
fi

printf 'BFSOS package timing: %s-%s-%s: %s (status %s)\n' \
    "$pkg_name" "$pkg_version" "$pkg_release" "$(human_elapsed "$elapsed")" "$status"

exit "$status"
