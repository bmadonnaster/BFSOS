cription: Tools and libraries to manipulate EFI variables
# URL: https://github.com/rhboot/efivar
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: popt

name=efivar
version=39
release=2

source=(
    https://github.com/rhboot/$name/archive/$version/$name-$version.tar.gz
)

pkg_build() {
    make -j1 \
        ENABLE_DOCS=0 \
        libdir=/usr/lib

    make \
        ENABLE_DOCS=0 \
        libdir=/usr/lib \
        DESTDIR="$PKG" \
        install
}
