# Depends on: python3-six python3-webencodings python3-packaging

name=python3-html5lib
version=1.1
release=2
source=(https://files.pythonhosted.org/packages/source/h/html5lib/html5lib-${version}.tar.gz)

pkg_build() {
    # html5lib 1.1 predates setuptools' removal of top-level pkg_resources.
    # pkg_resources.parse_version is equivalent here to packaging.version.Version.
    sed -i \
        's/from pkg_resources import parse_version/from packaging.version import Version as parse_version/' \
        setup.py || return 1

    python3 setup.py build || return 1
    python3 setup.py install \
        --root="${PKG}" \
        --optimize=1 \
        --skip-build || return 1
}
