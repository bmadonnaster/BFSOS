# Depends on: python3-six python3-webencodings python3-packaging

name=python3-html5lib
version=1.1
release=3
source=(https://files.pythonhosted.org/packages/source/h/html5lib/html5lib-${version}.tar.gz)

pkg_build() {
    # html5lib 1.1 compatibility with setuptools >= 82:
    # pkg_resources is no longer shipped as a public top-level module.
    sed -i \
        's/from pkg_resources import/from packaging.version import parse as/' \
        setup.py || return 1

    sed -i \
        's/^import pkg_resources$/pkg_resources = None/' \
        setup.py || return 1

    python3 setup.py build || return 1

    python3 setup.py install \
        --root="${PKG}" \
        --optimize=1 \
        --skip-build || return 1
}
