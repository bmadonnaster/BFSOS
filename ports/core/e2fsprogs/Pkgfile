name=e2fsprogs
version=1.47.4
release=2

source=(
    https://downloads.sourceforge.net/project/e2fsprogs/e2fsprogs/v$version/e2fsprogs-$version.tar.gz
)

pkg_build() {

    mkdir -v build
    cd build

    ../configure \
        --prefix=/usr \
        --bindir=/usr/bin \
        --sbindir=/usr/sbin \
        --libdir=/usr/lib \
        --sysconfdir=/etc \
        --enable-elf-shlibs \
        --disable-libblkid \
        --disable-libuuid \
        --disable-uuidd \
        --disable-fsck

    make

    make DESTDIR="$PKG" install
    make DESTDIR="$PKG" install-libs

    #
    # Leave static libraries writable for later package processing.
    #
    chmod u+w \
        "$PKG/usr/lib/libcom_err.a" \
        "$PKG/usr/lib/libe2p.a" \
        "$PKG/usr/lib/libext2fs.a" \
        "$PKG/usr/lib/libss.a"

    #
    # Install Info documentation.
    #
    install -d -m 0755 "$PKG/usr/share/info"

    if [ -f "$PKG/usr/share/info/libext2fs.info.gz" ]; then
        gunzip "$PKG/usr/share/info/libext2fs.info.gz"
    fi

    if [ -f "$PKG/usr/share/info/libext2fs.info" ]; then
        install-info \
            --dir-file="$PKG/usr/share/info/dir" \
            "$PKG/usr/share/info/libext2fs.info"
    fi

    makeinfo \
        -o doc/com_err.info \
        ../lib/et/com_err.texinfo

    install -m 0644 \
        doc/com_err.info \
        "$PKG/usr/share/info/com_err.info"

    install-info \
        --dir-file="$PKG/usr/share/info/dir" \
        "$PKG/usr/share/info/com_err.info"

    #
    # Disable metadata_csum_seed by default for compatibility.
    #
    sed -i \
        's/metadata_csum_seed,//' \
        "$PKG/etc/mke2fs.conf"
}
