# Description: Programs for controlling startup, running, and shutdown
# URL: https://savannah.nongnu.org/projects/sysvinit
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>

name=sysvinit
version=3.14
release=1
source=(
    https://github.com/slicer69/sysvinit/releases/download/$version/sysvinit-$version.tar.xz
    https://www.linuxfromscratch.org/patches/lfs/development/sysvinit-3.14-consolidated-1.patch
)

pkg_build() {
    make -C src
    make -C src ROOT="$PKG" install

    rm -f "$PKG/usr/bin/last" "$PKG/usr/bin/lastb" \
          "$PKG/usr/bin/readbootlog" "$PKG/usr/bin/mesg" \
          "$PKG/usr/bin/utmpdump" "$PKG/usr/bin/wall"
    rm -f "$PKG/bin/pidof"
    rm -f "$PKG/sbin/sulogin" "$PKG/sbin/logsave"
    rm -f "$PKG/usr/share/man/man1/last.1" "$PKG/usr/share/man/man1/lastb.1" \
          "$PKG/usr/share/man/man1/readbootlog.1" "$PKG/usr/share/man/man1/mesg.1" \
          "$PKG/usr/share/man/man1/utmpdump.1" "$PKG/usr/share/man/man1/wall.1"
    rm -f "$PKG/usr/share/man/man8/pidof.8" "$PKG/usr/share/man/man8/logsave.8" \
          "$PKG/usr/share/man/man8/sulogin.8"
}
