
# Description: A system for managing library compile/link flags.
# URL: https://github.com/pkgconf/pkgconf/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>

name=pkgconf
version=3.0.8
release=1
source=(
    https://distfiles.ariadne.space/pkgconf/pkgconf-$version.tar.xz
    i686-pc-linux-gnu.personality
    x86_64-pc-linux-gnu.personality
)

pkg_build() {
    ./configure \
        --prefix=/usr \
        --disable-static || return 1

    make -j"${JOBS:-$(nproc)}" || return 1
    make DESTDIR="$PKG" install || return 1

    install -d \
        "$PKG/usr/share/pkgconfig/personality.d" \
        "$PKG/usr/bin" \
        "$PKG/usr/share/man/man1" || return 1

    install -m644 \
        "$SRC/i686-pc-linux-gnu.personality" \
        "$SRC/x86_64-pc-linux-gnu.personality" \
        "$PKG/usr/share/pkgconfig/personality.d/" || return 1

    ln -sfn pkgconf \
        "$PKG/usr/bin/i686-pc-linux-gnu-pkg-config" || return 1
    ln -sfn pkgconf \
        "$PKG/usr/bin/x86_64-pc-linux-gnu-pkg-config" || return 1
    ln -sfn pkgconf \
        "$PKG/usr/bin/pkg-config" || return 1
    ln -sfn pkgconf.1 \
        "$PKG/usr/share/man/man1/pkg-config.1" || return 1
}
