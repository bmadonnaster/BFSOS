# Description: 80x86 assembler
# URL: https://www.nasm.us/
# Maintainer: Brian Madonna email bmadonnaster@gmail.com
# Optional: asciidoc xmlto 

name=nasm
version=3.02
release=2
source=(https://www.nasm.us/pub/nasm/releasebuilds/$version/$name-$version.tar.xz)

build() {
wget "https://www.nasm.us/pub/nasm/releasebuilds/$version/nasm-$version-xdoc.tar.xz" || return 1
	cd "$name-$version" || return 1
	tar -xf "../$name-$version-xdoc.tar.xz" --strip-components=1 || return 1
	./configure --prefix=/usr || return 1
	make || return 1
	make DESTDIR="$PKG" install || return 1
install -m755 -d         $PKG/usr/share/doc/$name-$version/html  &&
cp -v doc/html/*.html    $PKG/usr/share/doc/$name-$version/html  &&
cp -v doc/*.{txt,ps,pdf} $PKG/usr/share/doc/$name-$version
}
