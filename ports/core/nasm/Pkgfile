# Description: 80x86 assembler
# URL: https://www.nasm.us/
# Maintainer: Brian Madonna email bmadonnaster@gmail.com
# Optional: asciidoc xmlto

name=nasm
version=3.02
release=3
source=(
    https://www.nasm.us/pub/nasm/releasebuilds/$version/$name-$version.tar.xz
    https://www.nasm.us/pub/nasm/releasebuilds/$version/$name-$version-xdoc.tar.xz
)

pkg_build() {
    cd "$name-$version" || return $?

    tar -xf "../$name-$version-xdoc.tar.xz" \
        --strip-components=1 || return $?

    ./configure \
        --prefix=/usr || return $?

    make -j "${JOBS:-1}" || return $?

    make DESTDIR="$PKG" install || return $?

    install -d \
        "$PKG/usr/share/doc/$name-$version/html" || return $?

    cp -v doc/html/*.html \
        "$PKG/usr/share/doc/$name-$version/html/" || return $?

    for f in doc/*.txt doc/*.ps doc/*.pdf; do
        [ -e "$f" ] || continue
        cp -v "$f" \
            "$PKG/usr/share/doc/$name-$version/" || return $?
    done
}
