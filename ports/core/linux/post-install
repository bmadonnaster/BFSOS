#!/bin/sh
set -eu

RAID_DRIVERS="linear raid0 raid1 raid10 raid456"
FLAVOR="linux"
SUFFIX="BFS-Linux"

installed_pkg_version() {
    pkginfo -i 2>/dev/null | awk -v p="$1" '$1 == p { print $2; exit }'
}

package_installed() {
    pkginfo -i 2>/dev/null | awk -v p="$1" '$1 == p { found=1 } END { exit !found }'
}

atomic_symlink() {
    target="$1"
    link="$2"
    dir=${link%/*}
    base=${link##*/}
    tmp="$dir/.${base}.tmp.$$"
    rm -f -- "$tmp"
    ln -s "$target" "$tmp"
    mv -Tf -- "$tmp" "$link"
}

pkgver="$(installed_pkg_version "$FLAVOR")"
version="${pkgver%-*}"
kver="${version}-${SUFFIX}"

# Fall back only for legacy/manual hook execution where pkginfo cannot provide
# the just-installed package version. Never use mtime as the normal selector.
if [ -z "$version" ] || [ ! -f "/boot/vmlinuz-$kver" ] || [ ! -d "/lib/modules/$kver" ]; then
    kver="$(find /boot -maxdepth 1 -type f -name 'vmlinuz-*-BFS-Linux' -printf '%f
' 2>/dev/null | sed 's/^vmlinuz-//' | sort -V | tail -n1)"
fi

if [ -z "$kver" ] || [ ! -f "/boot/vmlinuz-$kver" ] || [ ! -d "/lib/modules/$kver" ]; then
    echo "linux post-install: unable to determine the installed kernel release" >&2
    exit 1
fi

kernel_image="/boot/vmlinuz-$kver"
initramfs_image="/boot/initramfs-$kver.img"
source_tree="/usr/src/linux-$kver"

[ -d "$source_tree" ] || {
    echo "linux post-install: missing source tree $source_tree" >&2
    exit 1
}

echo "Updating module dependencies for $kver"
depmod -a "$kver"

# Persist a deterministic default flavor. On legacy dual-kernel systems with
# no selection file, prefer the normal kernel rather than whichever package
# happened to be installed last. The installer overwrites this with the user's
# explicit selection before final boot configuration.
mkdir -p /etc/bfsos
selected_flavor="$(cat /etc/bfsos/kernel-flavor 2>/dev/null || true)"
case "$selected_flavor" in
    linux|linux-lts) ;;
    *)
        if package_installed linux && package_installed linux-lts; then
            selected_flavor=linux
        else
            selected_flavor=linux
        fi
        printf '%s
' "$selected_flavor" > /etc/bfsos/kernel-flavor
        ;;
esac

if [ "$selected_flavor" = linux ]; then
    atomic_symlink "linux-$kver" /usr/src/linux
fi

# During a BFSOS installation the installer owns the final storage topology,
# Dracut invocation, and GRUB validation. Defer those operations until the
# installer has generated fstab/crypttab/mdadm/LVM state.
if [ "${BFS_INSTALLER_RUNNING:-no}" = yes ]; then
    echo "BFSOS installer detected; deferring initramfs/bootloader regeneration."
    exit 0
fi

if ! command -v dracut >/dev/null 2>&1; then
    echo "ERROR: dracut is not installed; refusing to finalize kernel $kver." >&2
    exit 1
fi

echo "Generating $initramfs_image with BFSOS md RAID drivers"
dracut --force --omit "fido2 systemd-cryptsetup" --force-drivers "$RAID_DRIVERS" "$initramfs_image" "$kver"

if command -v lsinitrd >/dev/null 2>&1; then
    image_listing="$(lsinitrd "$initramfs_image" 2>/dev/null || true)"
    for driver in $RAID_DRIVERS; do
        if ! printf '%s
' "$image_listing" | grep -qE "/${driver}\.ko([.]|$)"; then
            echo "ERROR: initramfs is missing required md driver: $driver" >&2
            exit 1
        fi
    done
fi

# Remove only initramfs images whose matching installed module tree no longer
# exists. Never remove the new image or the running kernel's image.
running_kver="$(uname -r 2>/dev/null || true)"
for image in /boot/initramfs-*-BFS-Linux.img; do
    [ -e "$image" ] || continue
    old_kver=${image#/boot/initramfs-}
    old_kver=${old_kver%.img}
    [ "$old_kver" = "$kver" ] && continue
    [ "$old_kver" = "$running_kver" ] && continue
    if [ ! -d "/lib/modules/$old_kver" ]; then
        echo "Removing obsolete initramfs: $image"
        rm -f -- "$image"
    fi
done

rm -f /lib/modules/KERNELVERSION
rm -f /boot/vmlinuz-BFS-Linux /boot/initramfs-BFS-Linux.img

if command -v grub-mkconfig >/dev/null 2>&1 && [ -d /boot/grub ]; then
    echo "Regenerating GRUB configuration"
    grub-mkconfig -o /boot/grub/grub.cfg
fi

echo "Linux $kver post-install completed."
