name=which
version=2.25
release=1
source=(https://ftp.gnu.org/gnu/$name/$name-$version.tar.gz)

build() {
	cd $name-$version

	./configure --prefix=/usr
        make
        make DESTDIR=$PKG install
mv $PKG/usr/share/info/dir $PKG/usr/share/info/which
}
