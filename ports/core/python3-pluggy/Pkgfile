# Description: Plugin and hook calling mechanisms for python
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: python3-build python3-installer python3-setuptools-scm python3-wheel

name=python3-pluggy
version=1.7.0
release=1
source=(https://files.pythonhosted.org/packages/source/p/pluggy/pluggy-${version}.tar.gz)
pkg_build() {
python3 -m build --wheel --no-isolation || return 1
    python3 -m installer --destdir="$PKG" dist/*.whl || return 1
}
