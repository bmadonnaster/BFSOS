# Description: Expose the kernel's API for use by Glibc
# URL:         
# Maintainer: Brian Madonna email bmadonnaster@gmail.com
# Depends on:  

name=linux-api-headers
version=7.1.9
release=2
source=(https://www.kernel.org/pub/linux/kernel/v7.x/linux-$version.tar.xz)

pkg_build() {
        make mrproper || return 1
        make headers || return 1
        find usr/include -type f ! -name '*.h' -delete || return 1
        mkdir -p "$PKG/usr/include" || return 1
        cp -rv usr/include/* "$PKG/usr/include/" || return 1
}
