# Description: Linux userspace API headers aligned with the BFSOS default LTS kernel
# URL: https://www.kernel.org/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>

name=linux-api-headers
version=6.18.53
release=1
source=(https://www.kernel.org/pub/linux/kernel/v6.x/linux-$version.tar.xz)

pkg_build() {
        make mrproper || return 1
        make headers || return 1
        find usr/include -type f ! -name '*.h' -delete || return 1
        mkdir -p "$PKG/usr/include" || return 1
        cp -rv usr/include/* "$PKG/usr/include/" || return 1
}
