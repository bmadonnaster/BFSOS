name=linux-api-headers
version=6.2.11
release=1
source=(https://www.kernel.org/pub/linux/kernel/v6.x/linux-$version.tar.xz)

build() {
        cd linux-$version

        make mrproper
	make headers
        find usr/include -name '.*' -delete
	rm usr/include/Makefile
        mkdir -p $PKG/usr/include
        cp -rv usr/include/* $PKG/usr/include
}
