name=rdfind
version=1.7.0
release=1
source=(https://github.com/pauldreik/rdfind/archive/releases/$version.tar.gz)
renames=($name-$version.tar.gz)

build() {
  cd $name-releases-$version

  ./bootstrap.sh
  ./configure --prefix=/usr
  make
  make DESTDIR=$PKG install
}
