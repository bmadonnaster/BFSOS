# Description: Python implementation of John Gruber's Markdown
# URL: https://python-markdown.github.io/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: python3 python3-build python3-installer python3-wheel

name=python3-markdown
version=3.11.2
release=1

source=(
    https://files.pythonhosted.org/packages/source/m/markdown/markdown-$version.tar.gz
)

pkg_build() {
    # Build the wheel without downloading dependencies.
    python3 -m build \
        --wheel \
        --no-isolation || return 1

    # Install into the package staging directory, never the host.
    python3 -m installer \
        --destdir="$PKG" \
        dist/*.whl || return 1
}
