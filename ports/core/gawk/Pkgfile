# Description: Programs for manipulating text files
# URL: https://www.gnu.org/software/gawk/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on:

name=gawk
version=5.4.1
release=1

source=(
    https://ftpmirror.gnu.org/gawk/gawk-$version.tar.xz)

pre_build() {
    sed -i 's/extras//' Makefile.in
}

post_build() {
    local man_dir="$PKG/usr/share/man/man1"

    if [ -f "$man_dir/gawk.1.gz" ]; then
        rm -f "$man_dir/awk.1" "$man_dir/awk.1.gz"
        ln -s gawk.1.gz "$man_dir/awk.1.gz"
    elif [ -f "$man_dir/gawk.1" ]; then
        rm -f "$man_dir/awk.1" "$man_dir/awk.1.gz"
        ln -s gawk.1 "$man_dir/awk.1"
    else
        echo "gawk: installed gawk.1 man page was not found" >&2
        return 1
    fi
}
