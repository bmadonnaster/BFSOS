# Description: YAML 1.1 parser and emitter library
# URL: https://github.com/yaml/libyaml
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on:

name=libyaml
version=0.2.5
release=1
source=(https://github.com/yaml/libyaml/releases/download/$version/yaml-$version.tar.gz)

pkg_build() {
    ./configure \
        --prefix=/usr \
        --disable-static
    make
    make DESTDIR="$PKG" install
}
