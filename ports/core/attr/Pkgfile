name=attr
version=2.6.0
release=2
source=(https://debian.netcologne.de/savannah/attr/attr-$version.tar.gz)

pkg_build() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --libexecdir=/usr/lib \
        --localstatedir=/var \
        --mandir=/usr/share/man \
        --libdir=/usr/lib \
        --disable-static \
        || return 1

    make || return 1

    make DESTDIR="$PKG" install || return 1
}
