cription: GNU GRand Unified Bootloader
# URL: https://www.gnu.org/software/grub/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: freetype fuse2

name=grub
version=2.14
release=2

source=(
    https://ftpmirror.gnu.org/grub/grub-$version.tar.xz
    extra_deps.lst
)

build_opt="
    --prefix=/usr
    --bindir=/usr/bin
    --sbindir=/usr/sbin
    --libdir=/usr/lib
    --libexecdir=/usr/lib
    --sysconfdir=/etc
    --disable-efiemu
    --enable-grub-mount
    --enable-grub-mkfont
    --enable-device-mapper
    --with-platform=pc
    --target=i386
    --disable-werror
"

pre_build() {
    #
    # GRUB supplies target-specific compiler flags and is known to
    # reject or miscompile with some globally inherited optimization
    # and architecture flags.
    #
    unset CFLAGS
    unset CXXFLAGS

    install -m 0644 \
        "$SRC/extra_deps.lst" \
        grub-core/extra_deps.lst
}
