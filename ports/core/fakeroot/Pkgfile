name=fakeroot
version=1.37.1.1
release=1
source=(https://deb.debian.org/debian/pool/main/f/$name/${name}_${version}.orig.tar.gz)

build() {
	cd $name-$version
	sed -i '/^SUBDIRS/d' doc/Makefile.am
	./bootstrap
	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install
}
