# Description: Utilities to access MS-DOS disks without mounting them
# URL:         https://www.gnu.org/software/mtools/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>

name=mtools
version=4.0.50
release=1
source=(https://ftpmirror.gnu.org/mtools/$name-$version.tar.bz2)

pkg_build() {

	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--disable-floppyd
	make
	sed -i Makefile -e 's|install-scripts install-info|install-scripts|'
	make -j1 DESTDIR="$PKG" prefix=/usr install
}

