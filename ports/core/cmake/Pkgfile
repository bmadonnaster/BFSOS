# Description: Cross-platform build-system generator.
# URL: https://cmake.org/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: curl expat libarchive ncurses openssl xz zlib libuv

name=cmake
version=4.4.2
release=1

source=(
    https://cmake.org/files/v${version%.*}/$name-$version.tar.gz
)

build_opt=(
    --prefix=/usr
    --system-libs
    --mandir=/share/man
    --docdir=/share/doc/$name-$version
    --no-system-jsoncpp
    --no-system-cppdap
    --no-system-librhash
)

pkg_build() {
    export LC_ALL=C
    unset LANGUAGE

    # Keep libraries under /usr/lib instead of /usr/lib64.
    sed -i '/"lib64"/s/64//' Modules/GNUInstallDirs.cmake

    ./bootstrap "${build_opt[@]}"

    make
    make DESTDIR="$PKG" install
}
