# Description: Python bindings for YAML with optional LibYAML acceleration
# URL: https://pyyaml.org/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: libyaml python3-build python3-cython python3-installer python3-setuptools python3-wheel

name=python3-pyyaml
version=6.0.3
release=3
source=(https://files.pythonhosted.org/packages/source/p/pyyaml/pyyaml-$version.tar.gz)

pkg_build() {
    PYYAML_FORCE_CYTHON=1 \
        python3 -m build --wheel --skip-dependency-check --no-isolation || return $?
    python3 -m installer --compile-bytecode 2 --destdir="$PKG" dist/*.whl || return $?
}
