# Description: Builds and maintains the system CA certificate trust store
# URL: https://github.com/lfs-book/make-ca
# Maintainer: Brian Madonna email bmadonnaster@gmail.com
# Depends on:

name=make-ca
version=1.16.1
release=4
source=(
https://github.com/lfs-book/make-ca/archive/v$version/$name-$version.tar.gz
)

pkg_build() {
    # BLFS recommends removing deprecated mktemp -t usage.
    sed '/mktemp/s/-t //' -i make-ca

    make DESTDIR="$PKG" install

    # Keep only make-ca's own local trust directory in this package.
    # /etc/ssl/cert.pem and /etc/ssl/certs/ca-certificates.crt are owned
    # by the ca-certificates package and must not be duplicated here.
    install -vdm755 "$PKG/etc/ssl/local"
}
