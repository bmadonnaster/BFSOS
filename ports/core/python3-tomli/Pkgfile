name=python3-tomli
version=2.4.1
release=1
source=(https://pypi.python.org/packages/source/t/tomli/tomli-$version.tar.gz)

build() {
  cd tomli-$version

  /usr/bin/pip3 install --isolate --root=$PKG --ignore-installed --no-deps .
}
