name=python3-flit-core
version=4.0.2
release=1
source=(https://github.com/takluyver/flit/archive/$version/flit-$version.tar.gz)

pkg_build() {
    PIP_CONFIG_FILE=/dev/null /usr/bin/pip3 wheel \
        -w dist --no-cache-dir --no-build-isolation --no-deps .
    PIP_CONFIG_FILE=/dev/null /usr/bin/pip3 install \
        --no-index --find-links dist --root="$PKG" --ignore-installed --no-deps flit_core
}
