name=dbus
version=1.16.2
release=1
source=(https://dbus.freedesktop.org/releases/$name/$name-$version.tar.xz)

pkg_build() {

	mkdir build
cd    build

meson setup --prefix=/usr --buildtype=release --wrap-mode=nofallback ..
            
	ninja
	ninja install

	mkdir -p $PKG/lib
	ln -sfv $PKG/etc/machine-id $PKG/var/lib/dbus
}
