# Description: VCS-backed version management used by setuptools-scm
# URL: https://github.com/pypa/setuptools-scm
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: python3-packaging python3-typing_extensions

name=python3-vcs-versioning
version=2.3.4
release=1
source=(https://files.pythonhosted.org/packages/source/v/vcs_versioning/vcs_versioning-$version.tar.gz)

pkg_build() {
    python3 -m build --wheel --skip-dependency-check --no-isolation || return 1
    python3 -m installer --destdir="$PKG" dist/*.whl || return 1
}
