name=inetutils
version=2.8
release=1
source=(https://ftpmirror.gnu.org/inetutils/inetutils-$version.tar.gz)
build_opt="
	--disable-logger
	--disable-whois
	--disable-rcp
	--disable-rexec
	--disable-rlogin
	--disable-rsh
	--disable-servers
"
pre_build () {
sed -i 's/def HAVE_TERMCAP_TGETENT/ 1/' telnet/telnet.c
}
post_build() {
	mkdir -p $PKG/{,s}bin
	mv $PKG/usr/bin/hostname $PKG/bin
	mv $PKG/usr/bin/ifconfig $PKG/sbin
}
