#!/bin/sh
set -eu
# A legacy 7.x package named linux must be migrated explicitly rather than
# coinstalled under a second identity with overlapping boot/module files.
if pkginfo -i 2>/dev/null | awk '$1 == "linux" && $2 ~ /^7[.]/ {found=1} END {exit !found}'; then
    echo "BFSOS kernel rename: old linux 7.x package is installed. Run bfs-kernel-migrate prepare mainline --yes first." >&2
    exit 1
fi
# A prepared legacy mainline transition uses the preserved identity
# linux-legacy-mainline. Normal new installations require no marker.
if pkginfo -i 2>/dev/null | awk '$1 == "linux-legacy-mainline" { found=1 } END { exit !found }'; then
    [ -s /var/lib/bfsos/kernel-migrations/ready-linux-mainline ] || {
        echo "linux-mainline: legacy package exists without a migration marker" >&2
        exit 1
    }
fi
command -v /usr/libexec/bfs-kernel-maintenance >/dev/null 2>&1 || {
    echo "linux-mainline pre-install: bfs-kernel-maintenance is required" >&2
    exit 1
}
exec /usr/libexec/bfs-kernel-maintenance pre-upgrade linux-mainline
