name=libuv
version=1.51.0
release=1
source=(https://dist.libuv.org/dist/v$version/$name-v$version.tar.gz)

build() {
	cd $name-v$version

	sh autogen.sh                              &&
./configure --prefix=/usr --disable-static &&
make 
	make DESTDIR=$PKG install
}
