# Description: Support library with a focus on asynchronous I/O
# URL: https://libuv.org/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: autoconf automake libtool

name=libuv
version=1.52.1
release=2

source=(
    https://dist.libuv.org/dist/v$version/$name-v$version.tar.gz
)

pkg_build() {
    sh autogen.sh

    ./configure \
        --prefix=/usr \
        --disable-static

    make
    make DESTDIR="$PKG" install
}

post_build() {
    find "$PKG" -type f -name '*.la' -delete

    rm -rf \
        "$PKG/usr/share/doc" \
        "$PKG/usr/share/info"
}
