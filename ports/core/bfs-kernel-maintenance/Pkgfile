# Description: BFSOS safe kernel upgrade, rollback retention, and boot finalization helper
# URL: https://codeberg.org/bmadonnaster/BFSOS
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: coreutils findutils gawk grep sed systemd

name=bfs-kernel-maintenance
version=1.0
release=3
source=(bfs-kernel-maintenance bfs-kernel-finalize.service README)

pkg_build() {
    install -Dm0755 "$SRC/bfs-kernel-maintenance" \
        "$PKG/usr/libexec/bfs-kernel-maintenance" || return 1
    install -Dm0644 "$SRC/bfs-kernel-finalize.service" \
        "$PKG/usr/lib/systemd/system/bfs-kernel-finalize.service" || return 1
    install -Dm0644 "$SRC/README" \
        "$PKG/usr/share/doc/$name/README" || return 1
}
