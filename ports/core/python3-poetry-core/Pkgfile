# Description: Poetry core utilities for Python packaging
# URL: https://github.com/python-poetry/poetry-core
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: python3-build python3-installer

name=python3-poetry-core
version=2.5.0
release=2
source=(https://files.pythonhosted.org/packages/source/p/poetry-core/poetry_core-$version.tar.gz)

pkg_build() {
    python3 -m build \
        --wheel \
        --skip-dependency-check \
        --no-isolation || return 1

    python3 -m installer \
        --compile-bytecode 2 \
        --destdir="$PKG" \
        dist/*.whl || return 1
}
