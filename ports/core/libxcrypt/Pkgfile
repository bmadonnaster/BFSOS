name=libxcrypt
version=4.5.2
release=1
source=(https://github.com/besser82/libxcrypt/releases/download/v$version/libxcrypt-$version.tar.xz)
build_opt="--enable-hashes=strong,glibc --enable-obsolete-api=no --disable-failure-tokens"
pre_build() {
sed -i '/strchr/s/const//' lib/crypt-{sm3,gost}-yescrypt.c
}
post_build() {
	rm -f $PKG/usr/share/man/man3/crypt.3 $PKG/usr/share/man/man3/crypt_r.3
}
bootstrap_build() {
sed -i '/strchr/s/const//' lib/crypt-{sm3,gost}-yescrypt.c
./configure --prefix=$TOOLS                \
            --enable-hashes=strong,glibc \
            --enable-obsolete-api=no     \
            --disable-static             \
            --disable-failure-tokens
make
make install
}
