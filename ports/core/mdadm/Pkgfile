# Description: Tools for managing software RAID arrays
# URL:         https://www.kernel.org/pub/linux/utils/raid/mdadm/
# Maintainer:  Brian Madonna <bmadonnaster@gmail.com>
# Optional:    mta

name=mdadm
version=4.4
release=1
source=(https://www.kernel.org/pub/linux/utils/raid/$name/$name-$version.tar.xz)
pkg_build () {
    make \
        BINDIR=/usr/sbin \
        CWFLAGS="-Wall -Wstrict-prototypes -Wextra -Wno-unused-parameter -Wimplicit-fallthrough=0 -O2"

    make \
        DESTDIR=$PKG \
        BINDIR=/usr/sbin \
        install
}
