# Description: C extensions compiler for Python
# URL: https://cython.org/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: python3-build python3-installer python3-setuptools python3-wheel

name=python3-cython
version=3.3.0
release=1
source=(https://files.pythonhosted.org/packages/source/c/cython/cython-$version.tar.gz)

pkg_build() {
    python3 -m build --wheel --skip-dependency-check --no-isolation
    python3 -m installer --compile-bytecode 2 --destdir="$PKG" dist/*.whl
}
