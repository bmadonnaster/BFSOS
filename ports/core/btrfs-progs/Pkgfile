# Description: Filesystem utilities for Btrfs
# URL:         https://btrfs.readthedocs.io/en/latest/
# Maintainer:  Brian Madonna <bmadonnaster@gmail.com>
# Depends on:  lzo util-linux

name=btrfs-progs
version=7.1
release=1
source=(https://www.kernel.org/pub/linux/kernel/people/kdave/$name/$name-v$version.tar.xz)

build_opt="--prefix=/usr
           --bindir=/sbin
           --disable-convert
           --disable-zoned
           --disable-documentation"

post_build() {
    install -d \
        "$PKG/usr/share/man/man5" \
        "$PKG/usr/share/man/man8"

    install -m 644 Documentation/*.5 "$PKG/usr/share/man/man5/"
    install -m 644 Documentation/*.8 "$PKG/usr/share/man/man8/"
}
