name=procps-ng
version=4.0.7
release=1
source=(https://sourceforge.net/projects/procps-ng/files/Production/procps-ng-$version.tar.xz)
pkg_build() {
      

        ./configure --prefix=/usr                           \
            --docdir=/usr/share/doc/$name-$version \
            --disable-static                        \
            --disable-kill                          \
            --enable-watch8bit                      \
            --with-systemd
        make
        make DESTDIR=$PKG install
}

