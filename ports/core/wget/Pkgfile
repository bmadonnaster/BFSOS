name=wget
version=1.25.0
release=1
source=(https://ftp.gnu.org/gnu/$name/$name-$version.tar.gz)

build() {
	cd $name-$version

	./configure --prefix=/usr      \
	            --sysconfdir=/etc  \
	            --with-ssl=openssl
	make
	make DESTDIR=$PKG install
rm -rf $PKG/usr/share/info/dir
}
