# Description: Generate an fstab from the current system
# URL: https://gitlab.archlinux.org/archlinux/arch-install-scripts
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: bash coreutils gawk grep util-linux

name=genfstab
version=31
release=2
source=(https://github.com/archlinux/arch-install-scripts/archive/refs/tags/v$version.tar.gz)

# Custom build required: BFSOS intentionally packages only genfstab from the
# upstream arch-install-scripts suite; pacstrap/arch-chroot require Arch pacman.
pkg_build() {
    make genfstab || return 1

    install -d "$PKG/usr/bin" "$PKG/usr/share/licenses/$name" || return 1
    install -m755 genfstab "$PKG/usr/bin/genfstab" || return 1
    install -m644 COPYING "$PKG/usr/share/licenses/$name/COPYING" || return 1
}
