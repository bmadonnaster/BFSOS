cription: Manipulate EFI boot manager variables
# URL: https://github.com/rhboot/efibootmgr
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: efivar pciutils

name=efibootmgr
version=18
release=2

source=(
    https://github.com/rhboot/efibootmgr/archive/$version/$name-$version.tar.gz
)

pkg_build() {
    #
    # Compatibility fix for newer efivar headers.
    #
    sed -i \
        '/extern int efi_set_verbose/d' \
        src/efibootmgr.c

    #
    # EFIDIR is only the default EFI System Partition path compiled
    # into the utility. It does not mount or modify /boot/efi here.
    #
    make \
        EFIDIR=/boot/efi \
        CFLAGS="$CFLAGS -Wno-error=pointer-sign"

    install -D -m 0755 \
        src/efibootmgr \
        "$PKG/usr/sbin/efibootmgr"

    install -D -m 0644 \
        src/efibootmgr.8 \
        "$PKG/usr/share/man/man8/efibootmgr.8"
}
