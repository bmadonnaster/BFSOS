# Description: A tool for installing and managing Python packages.
# URL: https://pypi.org/project/pip/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: python3-setuptools

name=python3-pip
version=26.3
release=1

source=(
    https://files.pythonhosted.org/packages/py3/p/pip/pip-$version-py3-none-any.whl
)

pkg_build() {
    local wheel="$SRC/pip-$version-py3-none-any.whl"
    local pyver

    pyver=$(/usr/bin/python3 -c \
        'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")') || return 1

    PYTHONPATH="$wheel" \
        /usr/bin/python3 -m pip install \
        --no-index \
        --no-deps \
        --no-compile \
        --ignore-installed \
        --prefix=/usr \
        --root="$PKG" \
        "$wheel" || return 1

    # Byte-compile for the active Python version.
    local sitepkg="$PKG/usr/lib/python${pyver}/site-packages"

    [ -d "$sitepkg" ] || return 1

    /usr/bin/python3 -m compileall \
        -q \
        -f \
        -d "/usr/lib/python${pyver}/site-packages" \
        "$sitepkg" || return 1

    # Ensure packaged Python files are not group/world writable.
    find "$sitepkg" \
        -type f \
        -exec chmod go-w '{}' + || return 1
}
