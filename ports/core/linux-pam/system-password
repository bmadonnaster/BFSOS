# Begin /etc/pam.d/system-password

# Check new passwords through libpwquality/CrackLib first.  Policy defaults
# live in /etc/security/pwquality.conf.
password  required    pam_pwquality.so   retry=3 authtok_type=UNIX

# Store the accepted password using yescrypt and the shadow database.
password  required    pam_unix.so        yescrypt shadow try_first_pass

# End /etc/pam.d/system-password
