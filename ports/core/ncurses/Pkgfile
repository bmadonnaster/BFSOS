name=ncurses
version=6.6
release=1

source=(https://invisible-mirror.net/archives/$name/$name-$version.tar.gz)

build_opt="--prefix=/usr
           --mandir=/usr/share/man
           --with-shared
           --without-debug
           --without-normal
           --without-ada
           --with-cxx-shared
           --enable-widec
           --enable-pc-files
           --with-pkg-config-libdir=/usr/lib/pkgconfig
           --disable-stripping
           AWK=gawk"

CFLAGS+=' -std=gnu17'

bootstrap_build() {
    mkdir -p build
    pushd build

    ../configure \
        --prefix="$TOOLS" \
        --with-shared \
        --without-debug \
        --without-ada \
        --enable-widec \
        --enable-overwrite

    make
    make install

    ln -sf libncursesw.so "$TOOLS/lib/libncurses.so"

    popd
}

post_build () {
    local real_lib

    mkdir -p "$PKG/lib"

    real_lib=$(
        find "$PKG/usr/lib" \
            -maxdepth 1 \
            -type f \
            -name 'libncursesw.so.*' \
            -printf '%f\n' |
        head -n 1
    )

    if [ -z "$real_lib" ]; then
        echo "ERROR: Could not locate the real libncursesw shared library."
        return 1
    fi

    mv "$PKG/usr/lib/$real_lib" "$PKG/lib/"

    # Wide ncurses linker and runtime links.
    ln -sf "../../lib/$real_lib" \
        "$PKG/usr/lib/libncursesw.so"

    ln -sf "$real_lib" \
        "$PKG/lib/libncursesw.so.${version%%.*}"

    # Compatibility ncurses runtime library.
    ln -sf "$real_lib" \
        "$PKG/lib/libncurses.so.${version%%.*}"

    # libtinfo compatibility links.
    ln -sf "../../lib/$real_lib" \
        "$PKG/usr/lib/libtinfo.so"

    ln -sf "../../lib/$real_lib" \
        "$PKG/usr/lib/libtinfo.so.${version%%.*}"

    ln -sf ncursesw.pc \
        "$PKG/usr/lib/pkgconfig/tinfo.pc"

    for lib in ncurses form panel menu; do
        rm -f "$PKG/usr/lib/lib${lib}.so"
        echo "INPUT(-l${lib}w)" >"$PKG/usr/lib/lib${lib}.so"

        ln -sf "${lib}w.pc" \
            "$PKG/usr/lib/pkgconfig/${lib}.pc"
    done

    rm -f "$PKG/usr/lib/libcursesw.so"
    echo "INPUT(-lncursesw)" >"$PKG/usr/lib/libcursesw.so"

    ln -sf libncurses.so \
        "$PKG/usr/lib/libcurses.so"
}
