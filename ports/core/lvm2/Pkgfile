# Description: Tools for managing logical volumes and device mappings.
# URL: https://sourceware.org/lvm2/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>

name=lvm2
version=2.03.41
release=1

source=(
    https://sourceware.org/pub/lvm2/LVM2.$version.tgz
)

build_opt=(
    --prefix=/usr
    --sbindir=/usr/bin
    --libdir=/usr/lib
    --sysconfdir=/etc
    --localstatedir=/var
    --runstatedir=/run
    --enable-cmdlib
    --enable-pkgconfig
    --enable-systemd
    --enable-dmeventd
    --enable-udev_sync
)

pkg_build() {
    ./configure "${build_opt[@]}"

    make
    make DESTDIR="$PKG" install
}

post_build() {
    if [[ -f "$PKG/etc/lvm/lvm.conf" ]]; then
        sed -i \
            -e '/locking_dir =/{s/#//;s@/var/run@@}' \
            "$PKG/etc/lvm/lvm.conf"
    fi

    find "$PKG" -type f -name '*.la' -delete

    rm -rf "$PKG/usr/share/doc"
}
