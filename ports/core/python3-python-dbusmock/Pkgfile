# Depends on: dbus-python python3-setuptools python3-setuptools-scm

name=python3-python-dbusmock
version=0.38.1
release=2
source=(https://files.pythonhosted.org/packages/source/p/python_dbusmock/python_dbusmock-${version}.tar.gz)

pkg_build() {
    python3 -m pip wheel \
        --no-build-isolation \
        --no-deps \
        --no-cache-dir \
        -w dist \
        . || return 1

    python3 -m pip install \
        --no-index \
        --no-deps \
        --no-cache-dir \
        --no-user \
        --root="$PKG" \
        --prefix=/usr \
        dist/*.whl || return 1
}
