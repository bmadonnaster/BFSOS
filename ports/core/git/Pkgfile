name=git
version=2.50.1
release=1
source=(https://www.kernel.org/pub/software/scm/$name/$name-$version.tar.xz)

pkg_build() {


	./configure --prefix=/usr \
            --with-gitconfig=/etc/gitconfig \
            --with-python=python3 &&
		make
		make DESTDIR=$PKG install
}
