# Description: Firmware files for Linux
# URL: https://gitlab.com/kernel-firmware/linux-firmware
# Maintainer: Brian Madonna email bmadonnaster@gmail.com
# Depends on: rdfind

name=linux-firmware
version=20260622
release=1
source=(https://www.kernel.org/pub/linux/kernel/firmware/$name-$version.tar.xz)

pkg_build() {
    make -j1 \
        DESTDIR="$PKG" \
        FIRMWAREDIR=/lib/firmware \
        install

    make \
        DESTDIR="$PKG" \
        FIRMWAREDIR=/lib/firmware \
        dedup

    find "$PKG" \
        \( -name ChangeLog -o -name README \) \
        -delete
}
