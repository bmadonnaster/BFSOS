cription: Essential Linux system utilities
# URL: https://www.kernel.org/pub/linux/utils/util-linux/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>

name=util-linux
version=2.42.2
release=2

source=(
    https://www.kernel.org/pub/linux/utils/util-linux/v${version%.*}/util-linux-$version.tar.xz)

build_type=configure_build

build_opt="
    --bindir=/usr/bin
    --libdir=/usr/lib
    --runstatedir=/run
    --sbindir=/usr/sbin
    --disable-chfn-chsh
    --disable-login
    --disable-nologin
    --disable-su
    --disable-setpriv
    --disable-runuser
    --disable-pylibmount
    --disable-liblastlog2
    --disable-static
    --without-python
    --docdir=/usr/share/doc/$name-$version
    ADJTIME_PATH=/var/lib/hwclock/adjtime
"

# Temporary Stage-1 build used to break the util-linux <-> systemd
# dependency cycle. The normal build remains the final BFS util-linux build.
bootstrap_build() {
    ./configure \
        --prefix="$TOOLS" \
        --libdir="$TOOLS/lib" \
        --disable-static \
        --disable-all-programs \
        --enable-libuuid \
        --enable-libblkid \
        --enable-libmount \
        --without-systemd \
        --without-systemdsystemunitdir \
        --disable-makeinstall-chown \
        --disable-makeinstall-setuid \
        --disable-makeinstall-tty-setgid

    make -j"${JOBS:-$(nproc)}"
    make install
}

