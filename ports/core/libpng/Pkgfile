# Description: Library of PNG support functions with APNG support
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
name=libpng
version=1.6.59
release=1
source=(https://downloads.sourceforge.net/$name/$name-$version.tar.xz
        libpng-1.6.58-apng.patch.gz)

pkg_build() {

    ./configure \
        --prefix=/usr \
        --disable-static || return 1

    make || return 1

    make DESTDIR="$PKG" install || return 1
}
