# Description: Legacy Linux Wireless Extensions configuration utilities
# URL: https://hewlettpackard.github.io/wireless-tools/Tools.html
# Maintainer: Brian Madonna email bmadonnaster@gmail.com
# Depends on:

name=wireless_tools
version=30.pre9
release=1

source=(https://deb.debian.org/debian/pool/main/w/wireless-tools/wireless-tools_30~pre9.orig.tar.gz)

build_opt() {
    cd wireless_tools.30

    make \
        CC="${CC:-gcc}" \
        CFLAGS="${CFLAGS:--O2 -pipe}" \
        LDFLAGS="${LDFLAGS}"
}

pkg_build() {
    cd wireless_tools.30

    # Programs
    install -d "$PKG/usr/sbin"

    install -m755 \
        iwconfig \
        iwlist \
        iwpriv \
        iwspy \
        iwgetid \
        iwevent \
        ifrename \
        "$PKG/usr/sbin/"

    # Shared library
    install -d "$PKG/usr/lib"

    install -m755 \
        libiw.so.30 \
        "$PKG/usr/lib/libiw.so.30"

    ln -sf libiw.so.30 \
        "$PKG/usr/lib/libiw.so"

    # Development headers
    install -d "$PKG/usr/include"

    install -m644 \
        iwlib.h \
        wireless.h \
        "$PKG/usr/include/"

    # Man pages
    install -d \
        "$PKG/usr/share/man/man5" \
        "$PKG/usr/share/man/man7" \
        "$PKG/usr/share/man/man8"

    install -m644 \
        iftab.5 \
        "$PKG/usr/share/man/man5/"

    install -m644 \
        wireless.7 \
        "$PKG/usr/share/man/man7/"

    install -m644 \
        iwconfig.8 \
        iwlist.8 \
        iwpriv.8 \
        iwspy.8 \
        iwgetid.8 \
        iwevent.8 \
        ifrename.8 \
        "$PKG/usr/share/man/man8/"
}
