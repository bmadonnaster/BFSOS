# Description: Compression and decompression routines used by some programs
# URL:         
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on:  

name=zlib
version=1.4
release=1
# BFSOS vendored patch provenance: 36ff1be48ef696cc67b0855f7c8537ce0276210d.patch <- https://github.com/madler/zlib/commit/36ff1be48ef696cc67b0855f7c8537ce0276210d.patch
source=(https://zlib.net/fossils/zlib-$version.tar.gz
 36ff1be48ef696cc67b0855f7c8537ce0276210d.patch)
keep_static=1
bootstrap_opt=""

export CPATH="/usr/include"
pkg_build() {
 CFLAGS+=" -ffat-lto-objects"
        ./configure --prefix=/usr --insecure
        make
        make DESTDIR=$PKG install
}
