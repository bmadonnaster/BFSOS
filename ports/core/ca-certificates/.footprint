drwxr-xr-x	root/root	etc/
drwxr-xr-x	root/root	etc/pki/
drwxr-xr-x	root/root	etc/pki/tls/
drwxr-xr-x	root/root	etc/pki/tls/certs/
-rw-r--r--	root/root	etc/pki/tls/certs/ca-bundle.crt
drwxr-xr-x	root/root	etc/ssl/
lrwxrwxrwx	root/root	etc/ssl/ca-bundle.crt -> ../pki/tls/certs/ca-bundle.crt
lrwxrwxrwx	root/root	etc/ssl/cert.pem -> ../pki/tls/certs/ca-bundle.crt
lrwxrwxrwx	root/root	etc/ssl/certdata.txt -> /usr/share/pki/mozilla/certdata.txt
drwxr-xr-x	root/root	etc/ssl/certs/
lrwxrwxrwx	root/root	etc/ssl/certs/ca-certificates.crt -> ../../pki/tls/certs/ca-bundle.crt
drwxr-xr-x	root/root	usr/
drwxr-xr-x	root/root	usr/share/
drwxr-xr-x	root/root	usr/share/pki/
drwxr-xr-x	root/root	usr/share/pki/mozilla/
-rw-r--r--	root/root	usr/share/pki/mozilla/certdata.txt
