# Description: Mozilla CA certificate bundle
# URL: https://curl.se/docs/caextract.html
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: coreutils

name=ca-certificates
version=20260813
release=1

# The curl PEM remains a bootstrap seed for the early toolchain only.  The
# installed trust lifecycle is driven by the pinned Mozilla NSS certdata input
# below and make-ca -r, so normal package installation never downloads roots.
nss_certdata_version=3.128
source=(
    https://curl.se/ca/cacert.pem
    https://archive.mozilla.org/pub/security/nss/releases/NSS_${nss_certdata_version//./_}_RTM/src/nss-$nss_certdata_version.tar.gz
)

bootstrap_build() {
	install -D -m 0644 \
		"$SRC/cacert.pem" \
		"$TOOLS/etc/ssl/cert.pem"
}

pkg_build() {
    certdata="$PWD/nss/lib/ckfw/builtins/certdata.txt"
    [ -s "$certdata" ] || {
        echo "ca-certificates: pinned Mozilla certdata.txt is missing from NSS $nss_certdata_version" >&2
        return 1
    }

    # Package the maintained Mozilla trust input in /usr/share. /etc is kept
    # for the compatibility link and administrator-local policy/anchors.
    install -D -m 0644 "$certdata"         "$PKG/usr/share/pki/mozilla/certdata.txt" || return 1
    install -d -m 0755 "$PKG/etc/ssl"
    ln -sfn /usr/share/pki/mozilla/certdata.txt "$PKG/etc/ssl/certdata.txt"

	# Seed the canonical BFSOS trust bundle as a real file. make-ca may
	# regenerate this runtime trust database later, but curl must never see
	# dangling compatibility links during bootstrap or a cold-cache install.
	install -D -m 0644 \
		"$SRC/cacert.pem" \
		"$PKG/etc/pki/tls/certs/ca-bundle.crt"

	# Compatibility paths used by OpenSSL/curl-compatible software.
	install -d -m 0755 "$PKG/etc/ssl/certs" "$PKG/etc/ssl"
	ln -sfn ../../pki/tls/certs/ca-bundle.crt \
		"$PKG/etc/ssl/certs/ca-certificates.crt"
	ln -sfn ../pki/tls/certs/ca-bundle.crt \
		"$PKG/etc/ssl/cert.pem"
	ln -sfn ../pki/tls/certs/ca-bundle.crt \
		"$PKG/etc/ssl/ca-bundle.crt"
}
