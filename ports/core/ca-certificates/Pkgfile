# Description: Mozilla CA certificate bundle
# URL: https://curl.se/docs/caextract.html
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>

name=ca-certificates
version=20260716
release=4

source=(
https://curl.se/ca/cacert.pem
)

bootstrap_build() {
	install -D -m 0644 \
		"$SRC/cacert.pem" \
		"$TOOLS/etc/ssl/cert.pem"
}

pkg_build() {
	# make-ca owns the canonical generated trust bundle.  This package owns
	# compatibility paths commonly expected by curl and third-party software.
	install -d -m 0755 \
		"$PKG/etc/ssl/certs" \
		"$PKG/etc/ssl"

	ln -sfn \
		../../pki/tls/certs/ca-bundle.crt \
		"$PKG/etc/ssl/certs/ca-certificates.crt"

	ln -sfn \
		../pki/tls/certs/ca-bundle.crt \
		"$PKG/etc/ssl/cert.pem"

	ln -sfn \
		../pki/tls/certs/ca-bundle.crt \
		"$PKG/etc/ssl/ca-bundle.crt"
}
