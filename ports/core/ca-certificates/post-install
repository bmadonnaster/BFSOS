#!/bin/sh
set -eu
install -d -m 0755 /etc/ssl/certs
[ -f /etc/ssl/cert.pem ] || { echo "ca-certificates: missing /etc/ssl/cert.pem" >&2; exit 1; }
ln -sfn ../cert.pem /etc/ssl/certs/ca-certificates.crt
ln -sfn /etc/ssl/cert.pem /etc/ssl/ca-bundle.crt

# If the complete p11-kit/make-ca stack is already present, refresh all trust
# representations after a ca-certificates package update replaces the seed PEM.
if [ -x /usr/sbin/make-ca ] && [ -x /usr/bin/trust ]; then
    /usr/sbin/make-ca -r
fi
