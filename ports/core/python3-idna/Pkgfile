# Description: Internationalized Domain Names in Applications (IDNA)
# URL: https://pypi.org/project/idna/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: python3 python3-build python3-installer python3-flit-core

name=python3-idna
version=3.19
release=1
source=(https://files.pythonhosted.org/packages/source/i/idna/idna-${version}.tar.gz)

pkg_build() {
    python3 -m build \
        --no-isolation \
        --wheel || return 1

    python3 -m installer \
        --destdir="$PKG" \
        dist/*.whl || return 1
}
