# Description: A collection of utilities to handle ELF objects.
# URL: https://sourceware.org/elfutils/
# Maintainer: Brian Madonna email bmadonnaster@gmail.com
# Depends on: bzip2 xz zlib

name=elfutils
version=0.195
release=2
source=(https://sourceware.org/ftp/elfutils/$version/elfutils-$version.tar.bz2
	libeu.patch)
keep_static=1
pkg_build () {
	sed -e 's/run-backtrace-native.sh//g' -i tests/Makefile.am
	autoreconf -vfi

	CPPFLAGS="-D_FORTIFY_SOURCE=-0"\
	./configure \
		--prefix=/usr \
		--program-prefix=eu- \
		--sysconfdir=/etc    \
		--enable-deterministic-archives \
		--disable-hardening \
		 --enable-maintainer-mode

	make
	make DESTDIR=$PKG install
}
