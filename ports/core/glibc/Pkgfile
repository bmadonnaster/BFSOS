# Description: GNU C Library
# URL: https://www.gnu.org/software/libc/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>

name=glibc
version=2.44
release=1

source=(
    https://ftpmirror.gnu.org/glibc/glibc-$version.tar.xz
    glibc-fhs-1.patch
    glibc-2.44-upstream_fix-1.patch
    genlocales
    ld.so.conf
    nsswitch.conf
)

keep_static=1

bootstrap_build() {
    # Patch sources are applied automatically by files/pkgmk.bootstrap before
    # this function runs, in source=() order.

    #
    # Temporary 32-bit Glibc.
    #
    mkdir -v build32
    cd build32

    echo "slibdir=$TOOLS/lib32" > configparms

    ../configure \
        --prefix="$TOOLS" \
        --host="$LFS_TGT32" \
        --build="$(../scripts/config.guess)" \
        --libdir="$TOOLS/lib32" \
        --enable-kernel=5.10 \
        --with-headers="$TOOLS/include" \
        CC="$LFS_TGT-gcc -m32" \
        CXX="$LFS_TGT-g++ -m32"

    make
    make install

    #
    # GCC's -m32 multilib search expects the 32-bit runtime under
    # $TOOLS/$LFS_TGT/lib32. Glibc installs it in $TOOLS/lib32.
    # Provide the target-layout compatibility link before GCC pass 2.
    #
    mkdir -p "$TOOLS/$LFS_TGT"
    ln -sfn ../lib32 "$TOOLS/$LFS_TGT/lib32"

    cd ..

    #
    # Temporary 64-bit Glibc.
    #
    mkdir -v build
    cd build

    ../configure \
        --prefix="$TOOLS" \
        --host="$LFS_TGT" \
        --build="$(../scripts/config.guess)" \
        --enable-kernel=5.10 \
        --with-headers="$TOOLS/include"

    make
    make install
}

pkg_build() {
    local configure_flags

    configure_flags="
        --prefix=/usr
        --with-headers=/usr/include
        --disable-profile
        --disable-werror
        --enable-kernel=5.10
        --enable-stack-protector=strong
        --enable-multi-arch
        --disable-nscd
        libc_cv_include_x86_isa_level=no
    "

    #
    # The root filesystem uses:
    #
    # /lib    -> usr/lib
    # /lib64  -> lib
    #
    ln -sfn lib "$PKG/lib64"

    #
    # Build and install the native 64-bit Glibc.
    #
    mkdir -v build
    cd build

    ../configure \
        --libexecdir=/usr/lib \
        libc_cv_slibdir=/lib \
        $configure_flags

    make

    sed \
        '/test-installation/s@$(PERL)@echo not running@' \
        -i ../Makefile

    make install_root="$PKG" install

    install -d -m 0755 \
        "$PKG/usr/lib/locale" \
        "$PKG/etc/ld.so.conf.d"

    install -m 0644 \
        "$SRC/ld.so.conf" \
        "$PKG/etc/ld.so.conf"

    install -m 0644 \
        "$SRC/nsswitch.conf" \
        "$PKG/etc/nsswitch.conf"

    #
    # Create the list consumed by the genlocales helper.
    #
    sed \
        -e '1,3d' \
        -e 's|/| |g' \
        -e 's|\\| |g' \
        -e 's|^|#|g' \
        "$SRC/glibc-$version/localedata/SUPPORTED" \
        > "$PKG/etc/locales"

    install -D -m 0755 \
        "$SRC/genlocales" \
        "$PKG/usr/bin/genlocales"

    #
    # Generate the minimal C locale required by the base system.
    #
    LC_ALL=C \
    ./elf/ld.so \
        --library-path . \
        "$PKG/usr/bin/localedef" \
        --force \
        --quiet \
        --inputfile="$SRC/$name-$version/localedata/locales/C" \
        --charmap="$SRC/$name-$version/localedata/charmaps/UTF-8" \
        "$PKG/usr/lib/locale/C" \
        || true

    sed -i '/#C\.UTF-8 /d' "$PKG/etc/locales"

    #
    # These programs are supplied by the tzdata package.
    #
    rm -f \
        "$PKG/usr/bin/zdump" \
        "$PKG/usr/sbin/zic" \
        "$PKG/usr/bin/tzselect"

    #
    # Build and install the 32-bit Glibc.
    #
    cd ..

    mkdir -v build32
    cd build32

    CC="gcc -m32 -mstackrealign" \
    CXX="g++ -m32 -mstackrealign" \
    CFLAGS="-O2 -march=i686 -pipe -Wno-error=parentheses" \
    CXXFLAGS="-O2 -march=i686 -pipe -Wno-error=parentheses" \
    ../configure \
        --host=i686-pc-linux-gnu \
        --libdir=/usr/lib32 \
        --libexecdir=/usr/lib32 \
        libc_cv_slibdir=/usr/lib32 \
        $configure_flags

    make
    make install_root="$PWD/DESTDIR" install

    install -d -m 0755 \
        "$PKG/usr/lib32" \
        "$PKG/usr/include/gnu"

    cp -a \
        DESTDIR/usr/lib32/. \
        "$PKG/usr/lib32/"

    install -m 0644 \
        DESTDIR/usr/include/gnu/lib-names-32.h \
        DESTDIR/usr/include/gnu/stubs-32.h \
        "$PKG/usr/include/gnu/"

    #
    # 32-bit dynamic linker compatibility path.
    #
    install -d -m 0755 "$PKG/lib"

    ln -sfn \
        ../usr/lib32/ld-linux.so.2 \
        "$PKG/lib/ld-linux.so.2"

    #
    # Locale data is architecture-independent. Both 64-bit and 32-bit
    # Glibc use /usr/lib/locale.
    #
    ln -sfn \
        ../lib/locale \
        "$PKG/usr/lib32/locale"

    echo "/usr/lib32" \
        > "$PKG/etc/ld.so.conf.d/lib32.conf"
}
