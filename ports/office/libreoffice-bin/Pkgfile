# Description: LibreOffice official precompiled RPM bundle repackaged for BFSOS
# URL: https://www.libreoffice.org/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: cups dbus fontconfig freetype glib gtk3 libX11 libXext libXrender mesa libarchive

name=libreoffice-bin
version=26.8.1
release=3
source=(https://download.documentfoundation.org/libreoffice/stable/$version/rpm/x86_64/LibreOffice_${version}_Linux_x86-64_rpm.tar.gz)

pkg_build() {
    # libarchive bsdtar reads RPM payloads directly.  No rpm2cpio provider or
    # fragile pipeline (whose first stage could fail unnoticed) is required.
    command -v bsdtar >/dev/null || { echo 'libreoffice-bin requires bsdtar (libarchive)' >&2; return 1; }
    local rpm count=0
    mkdir -p "$PKG" || return 1
    # Extract into the package staging root only. Never invoke RPM install scripts.
    while IFS= read -r -d '' rpm; do
        case "$rpm" in *-desktop-integration-*|*-debian-menus-*) continue;; esac
        # Reject RPMs containing absolute paths or path traversal before extraction.
        # Read the archive using the same tool used for extraction.
        bsdtar -tf "$rpm" >/dev/null || return 1
        while IFS= read -r entry; do
            case "$entry" in
                /*|../*|*/../*|*/..)
                    echo "libreoffice-bin: unsafe RPM member: $entry" >&2; return 1 ;;
            esac
        done < <(bsdtar -tf "$rpm")
        bsdtar -xf "$rpm" -C "$PKG" --no-same-owner || return 1
        count=$((count+1))
    done < <(find "$SRC" -type f -name '*.rpm' -print0)
    [ "$count" -gt 0 ] || { echo 'libreoffice-bin: no suite RPM payloads found' >&2; return 1; }
    # Upstream RPMs install under /opt/libreoffice<major.minor>, avoiding system lib trees.
    local desktop
    for desktop in "$PKG"/opt/libreoffice*/share/xdg/*.desktop; do
        [ -f "$desktop" ] || continue
        install -Dm644 "$desktop" "$PKG/usr/share/applications/libreoffice-bin-$(basename "$desktop")" || return 1
    done
    local soffice
    soffice=$(find "$PKG/opt" -type f -path '*/program/soffice' -print -quit 2>/dev/null)
    [ -n "$soffice" ] || { echo 'libreoffice-bin: suite executable missing' >&2; return 1; }
    printf '#!/bin/sh\nexec "%s" "$@"\n' "${soffice#"$PKG"}" > "$PKG/usr-bin-wrapper.tmp" || return 1
    install -Dm755 "$PKG/usr-bin-wrapper.tmp" "$PKG/usr/bin/libreoffice-bin" || return 1
    rm -f "$PKG/usr-bin-wrapper.tmp"
}
post_build() {
    local desktop_file

    # Remove upstream desktop integration links.
    # Keep the BFSOS-specific libreoffice-bin launchers.
    find "$PKG/usr/share/applications" \
        -maxdepth 1 \
        -name 'libreoffice[0-9]*.desktop' \
        -delete

    # Identify binary LibreOffice applications in KDE.
    while IFS= read -r -d '' desktop_file; do
        sed -i \
            -e '/^Name=/s/\r$//' \
            -e '/^Name=/s/ (BIN)$//' \
            -e '/^Name=/s/$/ (BIN)/' \
            "$desktop_file"
    done < <(
        find "$PKG/usr/share/applications" \
            -maxdepth 1 \
            -type f \
            -name 'libreoffice-bin-*.desktop' \
            -print0
    )
}
