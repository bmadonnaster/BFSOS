# Description: Minimal HTTPS-capable Lynx text browser for BFSOS live media
# URL: https://lynx.invisible-island.net/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: brotli openssl

name=lynx-iso
version=2.9.3
release=1
source=(https://invisible-mirror.net/archives/lynx/tarballs/lynx${version}.tar.bz2)

build_opt="--with-zlib
--with-bzlib
--with-ssl
--with-screen=ncursesw
--enable-ipv6
--enable-locale-charset
--disable-nls"

post_build() {
    if [ -f "$PKG/etc/lynx/lynx.cfg" ]; then
        sed -e '/#LOCALE/     a LOCALE_CHARSET:TRUE' \
            -e '/#DEFAULT_ED/ a DEFAULT_EDITOR:vi' \
            -e '/#PERSIST/    a PERSISTENT_COOKIES:TRUE' \
            -i "$PKG/etc/lynx/lynx.cfg" || return 1
    fi
    rm -rf "$PKG/usr/share/doc" "$PKG/usr/share/man" || return 1
}
