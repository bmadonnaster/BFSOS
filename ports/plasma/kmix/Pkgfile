name=kmix
version=26.08.0
release=1
source=(https://download.kde.org/stable/release-service/$version/src/$name-$version.tar.xz)

build() {
	cd $name-$version

	mkdir build &&
cd    build &&

cmake -D CMAKE_INSTALL_PREFIX=$KF6_PREFIX \
      -D CMAKE_PREFIX_PATH=$QT6DIR \
      -D CMAKE_BUILD_TYPE=Release         \
      -D BUILD_TESTING=OFF                \
      -Wno-author .. &&
make
	make DESTDIR=$PKG install
}
