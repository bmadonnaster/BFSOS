name=kmix
version=26.04.1
release=3
source=(https://download.kde.org/stable/release-service/$version/src/$name-$version.tar.xz)

build() {
	cd $name-$version

	mkdir build &&
cd    build &&

cmake -D CMAKE_INSTALL_PREFIX=$KF6_PREFIX \
      -D CMAKE_BUILD_TYPE=Release         \
      -D BUILD_TESTING=OFF                \
      -W no-dev .. &&
make
	make DESTDIR=$PKG install
}
