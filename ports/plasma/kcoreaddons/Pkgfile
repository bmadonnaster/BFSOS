# Description: KDE Frameworks 6 core addons
# URL: https://invent.kde.org/frameworks/kcoreaddons
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: extra-cmake-modules qt6 shared-mime-info

name=kcoreaddons
version=6.26.0
release=3
source=(https://download.kde.org/stable/frameworks/${version%.*}/$name-$version.tar.xz)

build_opt="-D CMAKE_INSTALL_PREFIX=$KF6_PREFIX
           -D CMAKE_INSTALL_LIBEXECDIR=libexec
           -D CMAKE_PREFIX_PATH=$QT6DIR
           -D CMAKE_BUILD_TYPE=Release
           -D BUILD_TESTING=OFF
           -D BUILD_PYTHON_BINDINGS=OFF
           -W no-dev .."
