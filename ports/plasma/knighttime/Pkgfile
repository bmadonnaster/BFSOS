# Description: Helpers for scheduling the Plasma dark-light cycle
# URL: https://invent.kde.org/plasma/knighttime
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: extra-cmake-modules kconfig kcoreaddons kdbusaddons kholidays ki18n qt6

name=knighttime
version=6.7.4
release=1
source=(https://download.kde.org/stable/plasma/$version/$name-$version.tar.xz)

build_opt="-D CMAKE_INSTALL_PREFIX=$KF6_PREFIX
           -D CMAKE_PREFIX_PATH=$QT6DIR
           -D CMAKE_BUILD_TYPE=Release
           -D BUILD_TESTING=OFF
           -Wno-author .."
