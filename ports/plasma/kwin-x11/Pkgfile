# Description: KDE Plasma X11 window manager
# URL: https://invent.kde.org/plasma/kwin-x11
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: extra-cmake-modules qt6 kde-frameworks-6 kdecoration kglobalaccel kglobalacceld knighttime libplasma plasma-activities plasma-wayland-protocols breeze libcanberra lcms2 libdisplay-info libdrm libepoxy libinput libxkbcommon mesa wayland wayland-protocols xorg-libs xcb-util-cursor xcb-util-keysyms xcb-util-wm

name=kwin-x11
version=6.7.4
release=1
source=(https://download.kde.org/stable/plasma/$version/$name-$version.tar.xz)

build_opt="-D CMAKE_INSTALL_PREFIX=$KF6_PREFIX
           -D CMAKE_PREFIX_PATH=$QT6DIR
           -D CMAKE_INSTALL_LIBEXECDIR=libexec
           -D CMAKE_BUILD_TYPE=Release
           -D BUILD_TESTING=OFF
           -Wno-author .."
