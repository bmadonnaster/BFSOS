# Description: KDE API documentation generation tools
# URL: https://invent.kde.org/frameworks/kapidox
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: doxygen python3-doxypypy python3-doxyqml python3-requests extra-cmake-modules qt6

name=kapidox
version=6.30.0
release=1
source=(https://download.kde.org/stable/frameworks/${version%.*}/$name-$version.tar.xz)

pkg_build() {
    python3 -m build --wheel --no-isolation || return 1
    python3 -m installer --destdir="$PKG" dist/*.whl || return 1
}
