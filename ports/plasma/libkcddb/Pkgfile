# Description: The libkcddb package contains a library used to retrieve audio CD meta data from the internet.
# URL: https://kde.org/
# Maintainer: Brian Madonna email bmadonnaster@gmail.com
# Depends on: kde-frameworks-6 libmusicbrainz qt6

name=libkcddb
version=26.08.0
release=3
source=(https://download.kde.org/stable/release-service/$version/src/$name-$version.tar.xz)

build() {
    cd $name-$version

    mkdir -p build
    cd build

    cmake -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/opt/kf6 \
        "-DCMAKE_PREFIX_PATH=/opt/qt6;/opt/kf6" \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_TESTING=OFF \
        -DQT_MAJOR_VERSION=6 \
        -Wno-author \
        ..

    ninja
    DESTDIR=$PKG ninja install
}
