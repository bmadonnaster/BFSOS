# Description: Library used to retrieve audio CD metadata from the internet
# URL: https://kde.org/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: kde-frameworks-6 libmusicbrainz qt6

name=libkcddb
version=26.08.1
release=1
source=(https://download.kde.org/stable/release-service/$version/src/$name-$version.tar.xz)

pkg_build() {
    cmake -S . -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/opt/kf6 \
        "-DCMAKE_PREFIX_PATH=/opt/qt6;/opt/kf6" \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_TESTING=OFF \
        -DQT_MAJOR_VERSION=6 \
        -Wno-author || return 1
    cmake --build build -j "${JOBS:-1}" || return 1
    DESTDIR="$PKG" cmake --install build || return 1
}
