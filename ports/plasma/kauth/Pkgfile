# Description: KDE Framework for executing actions with elevated privileges
# URL: https://invent.kde.org/frameworks/kauth
# Maintainer: Brian Madonna email bmadonnaster@gmail.com
# Depends on: kcoreaddons kwindowsystem polkit-qt-1 extra-cmake-modules qt6

name=kauth
version=6.29.0
release=3
source=(https://download.kde.org/stable/frameworks/${version%.*}/$name-$version.tar.xz)

build_opt="-DCMAKE_INSTALL_PREFIX=/opt/kf6 \
-DCMAKE_INSTALL_LIBEXECDIR=libexec \
-DCMAKE_PREFIX_PATH=/opt/qt6;/opt/kf6 \
-DCMAKE_BUILD_TYPE=Release \
-DBUILD_TESTING=OFF"
