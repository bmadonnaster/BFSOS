# Description: Additional KIO workers and plugins for KDE resource and network access
# URL: https://invent.kde.org/network/kio-extras
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: extra-cmake-modules kde-frameworks-6 kdsoap-ws-discovery-client libkexiv2 libproxy plasma-activities-stats qcoro qt6

name=kio-extras
version=26.08.1
release=1
source=(https://download.kde.org/stable/release-service/$version/src/$name-$version.tar.xz)

pkg_build() {
    cmake -B build -S . \
        -DCMAKE_INSTALL_PREFIX="/opt/kf6" \
        -DCMAKE_PREFIX_PATH="/opt/qt6;/opt/kf6" \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_TESTING=OFF \
        -Wno-author || return 1
    cmake --build build -j${JOBS:-1} || return 1
    DESTDIR="$PKG" cmake --install build || return 1
}
