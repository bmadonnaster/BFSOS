# Description: KDE Plasma screenshot and screen recording utility
# URL: https://apps.kde.org/spectacle/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: kconfig kconfigwidgets kcoreaddons kcrash kdbusaddons kglobalaccel kguiaddons ki18n kio kirigami kjobwidgets knotifications kpipewire kquickimageeditor kservice kstatusnotifieritem kwidgetsaddons kwindowsystem kxmlgui layer-shell-qt opencv prison purpose qt6 plasma-wayland-protocols tesseract wayland xcb-util xcb-util-cursor xcb-util-image

name=spectacle
version=6.7.5
release=2
source=(https://download.kde.org/stable/plasma/$version/$name-$version.tar.xz)

pre_build() {
    sed -i 's/find_package(OpenCV 4\.7/find_package(OpenCV/' CMakeLists.txt
}

build_opt="-DCMAKE_INSTALL_PREFIX=/opt/kf6
-DCMAKE_PREFIX_PATH=/opt/kf6;/opt/qt6
-DBUILD_TESTING=OFF"

post_build() {
    install -d "$PKG/usr/bin" || return 1
    ln -sf /opt/kf6/bin/spectacle "$PKG/usr/bin/spectacle" || return 1
}
