#!/bin/sh
set -eu

# Materialize the upstream runtime account/directories immediately when the
# tools are available; systemd will also process these declarative files later.
if command -v systemd-sysusers >/dev/null 2>&1 && [ -f /usr/lib/sysusers.d/plasmalogin.conf ]; then
    systemd-sysusers /usr/lib/sysusers.d/plasmalogin.conf || exit $?
fi
if command -v systemd-tmpfiles >/dev/null 2>&1 && [ -f /usr/lib/tmpfiles.d/plasmalogin.conf ]; then
    systemd-tmpfiles --create /usr/lib/tmpfiles.d/plasmalogin.conf || exit $?
fi

# Installation is deliberately non-disruptive. SDDM remains the conservative
# default unless the administrator/installer has explicitly selected Plasma
# Login Manager through the persistent BFSOS display-manager state.
if [ "$(cat /etc/bfsos/display-manager 2>/dev/null || true)" = plasmalogin ]; then
    /usr/sbin/bfs-display-manager plasmalogin
fi
