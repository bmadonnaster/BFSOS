# Description: Qt Quick image editing components used by KDE applications
# URL: https://invent.kde.org/libraries/kquickimageeditor
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: kconfig kirigami opencv qt6

name=kquickimageeditor
version=0.6.2.1
release=2
source=(https://download.kde.org/stable/$name/$name-$version.tar.xz)

pre_build() {
    sed -Ei 's@find_package\(OpenCV[[:space:]]+4\.7[^)]*\)@find_package(OpenCV 4.7...<6 REQUIRED)@' CMakeLists.txt
}

build_opt="-DCMAKE_INSTALL_PREFIX=/opt/kf6
-DCMAKE_PREFIX_PATH=/opt/kf6;/opt/qt6
-DBUILD_TESTING=OFF"
