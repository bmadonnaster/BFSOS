name=plasma-meta
version=6.7.4
release=3
source=()

build() {
    mkdir -p "$PKG/usr/lib/systemd/user/sockets.target.wants" \
             "$PKG/usr/lib/systemd/user/pipewire.service.wants"

    ln -sf ../pipewire.socket \
        "$PKG/usr/lib/systemd/user/sockets.target.wants/pipewire.socket"
    ln -sf ../pipewire-pulse.socket \
        "$PKG/usr/lib/systemd/user/sockets.target.wants/pipewire-pulse.socket"
    ln -sf ../wireplumber.service \
        "$PKG/usr/lib/systemd/user/pipewire.service.wants/wireplumber.service"
}

