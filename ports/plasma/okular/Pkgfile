name=okular
version=26.04.1
release=3
source=(https://download.kde.org/stable/release-service/${version}/src/$name-$version.tar.xz)
pkg_build() {
    mkdir -p build || return 1
    cd build || return 1

    SKIP_OPTIONAL='Discount;DjVuLibre;EPub;LibSpectre;LibZip'

    cmake \
        -DCMAKE_INSTALL_PREFIX=$KF6_PREFIX \
        -DCMAKE_PREFIX_PATH=$QT6DIR \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_TESTING=OFF \
        -DFORCE_NOT_REQUIRED_DEPENDENCIES="$SKIP_OPTIONAL" \
        -Wno-author \
        .. || return 1

    make -j${JOBS:-1} || return 1
    make DESTDIR="$PKG" install || return 1
}
