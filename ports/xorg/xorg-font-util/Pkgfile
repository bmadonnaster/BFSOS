name=xorg-font-util
version=1.4.1
release=1
source=(https://www.x.org/releases/individual/font/font-util-$version.tar.xz)

build() {
	cd font-util-$version

	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install
}
