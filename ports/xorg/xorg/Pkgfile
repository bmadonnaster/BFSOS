# Description: Complete baseline BFSOS X.Org environment
# URL: https://www.x.org/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: xorg-server xorg-libs xorg-apps xorg-fonts xorg-driver xinit wayland wayland-protocols xwayland

name=xorg
version=7x
release=3
source=()

pkg_build() {
    mkdir -p "$PKG/usr/share/bfsos/meta-packages"
    printf '%s
' 'BFSOS xorg meta package' \
        > "$PKG/usr/share/bfsos/meta-packages/xorg"
}
