# Description: X Window System server
# URL: https://xorg.freedesktop.org
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: libxcvt pixman xorg-fonts xkeyboard-config libepoxy libtirpc libinput systemd xorg-apps

name=xorg-server
version=21.1.25
release=3
source=(https://xorg.freedesktop.org/archive/individual/xserver/$name-$version.tar.xz
https://linuxfromscratch.org/patches/downloads/xorg-server/xorg-server-21.1.25-tearfree_backport-1.patch)

pkg_build() {
	mkdir build &&
	cd    build &&

meson setup ..              \
      --prefix=$XORG_PREFIX \
      --localstatedir=/var  \
      -Dglamor=true         \
      -Dxkb_output_dir=/var/lib/xkb &&
ninja

	DESTDIR=$PKG ninja install
	rm -rf $PKG/usr/lib/xorg/protocol.txt
	install -m 755 -d $PKG/etc/X11/xorg.conf.d
	echo "needs_root_rights = yes" >> $PKG/etc/X11/Xwrapper.config
}
