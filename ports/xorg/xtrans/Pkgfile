# Description: Library of code to handle network protocol transport
# URL: https://xorg.freedesktop.org
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: util-macros

name=xtrans
version=1.6.0
release=3
source=(https://xorg.freedesktop.org/archive/individual/lib/xtrans-$version.tar.xz)

pkg_build() {

	./configure $XORG_CONFIG --docdir=/usr/share/doc/$name-$version  --with-appdefaultdir=/etc/X11/app-defaults


	make
	make DESTDIR=$PKG install
}
