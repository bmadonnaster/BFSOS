# Description: X11 screen saver collection and locker
# URL: https://ftp.ludd.ltu.se/pub/blfs/conglomeration/xscreensaver/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: gtk3 xorg-apps glu linux-pam ffmpeg kerberos

name=xscreensaver
version=6.15
release=7
source=(https://ftp.ludd.ltu.se/pub/blfs/conglomeration/xscreensaver/${name}-${version}.tar.gz)

pkg_build() {
    ./configure --prefix=/usr --with-systemd || return 1
    make -j"${JOBS:-1}" || return 1
    make DESTDIR="$PKG" install || return 1

    chmod 755 "$PKG/usr/bin/xscreensaver" || return 1
    install -d "$PKG/usr/share/backgrounds" || return 1

    # `bsod` intentionally simulates crashes/security incidents, including a
    # ransomware screen. Keep it available but exclude it from the default
    # random-hack list so a stock BFSOS install cannot mislead the user.
    for cfg in \
        "$PKG/etc/X11/app-defaults/XScreenSaver" \
        "$PKG/usr/share/X11/app-defaults/XScreenSaver"
    do
        [ -f "$cfg" ] || continue
        sed -E -i '/^[[:space:]]*-[[:space:]]+bsod([[:space:]]|$)/! s/^([[:space:]]*)bsod([[:space:]])/\1- bsod\2/' "$cfg" || return 1
    done
}
