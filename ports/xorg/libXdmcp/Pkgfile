# Description: X Display Manager Control Protocol library
# URL: https://xorg.freedesktop.org
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: xorgproto

name=libXdmcp
version=1.1.5
release=1
source=(https://xorg.freedesktop.org/archive/individual/lib/libXdmcp-$version.tar.xz)

pkg_build() {
	./configure $XORG_CONFIG --docdir=/usr/share/doc/libXdmcp-$version &&
make
	make DESTDIR=$PKG install
}
