# Description: Userspace interface to kernel DRM services
# URL: https://dri.freedesktop.org/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: xorg-libs valgrind
# Optional:   cairo cmake docbook-xml docbook-xsl-nons docutils libxslt libatomic_ops valgrind cunit

name=libdrm
version=2.4.134
release=3
source=(https://ftp.debian.org/debian/pool/main/libd/libdrm/libdrm_$version.orig.tar.xz)
renames=(libdrm-$version.tar.xz)

pkg_build() {
    meson setup build . \
        --prefix="$XORG_PREFIX" \
        --buildtype=release \
        -Dudev=true \
        -Dintel=enabled \
        -Dvalgrind=enabled \
        -Damdgpu=enabled \
        -Dnouveau=enabled \
        --wrap-mode=nodownload \
        -Db_lto=true \
        -Db_pie=true \
        -Dman-pages=disabled || return $?
    meson compile -C build -j "${JOBS:-1}" || return $?
    DESTDIR="$PKG" meson install -C build || return $?
}
