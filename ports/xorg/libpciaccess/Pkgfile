name=libpciaccess
version=0.19
release=2
source=(https://xorg.freedesktop.org/archive/individual/lib/libpciaccess-$version.tar.xz)

pkg_build() {
	      mkdir build
      cd    build
        meson setup --prefix=$XORG_PREFIX --buildtype=release ..
        ninja
	DESTDIR=$PKG ninja install
}
