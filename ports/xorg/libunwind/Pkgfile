name=libunwind
version=1.8.1
release=1
source=(https://github.com/libunwind/$name/releases/download/v$version/$name-$version.tar.gz)

build() {
	cd $name-$version

	./configure --prefix=/usr --disable-static &&
make
	make DESTDIR=$PKG install
}
