# Description: X Input client library
# URL: http://xorg.freedesktop.org
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: libXext libXfixes

name=libXi
version=1.8.3
release=3
source=(https://www.x.org/releases/individual/lib/libXi-$version.tar.xz)

pkg_build() {

	./configure $XORG_CONFIG --docdir=/usr/share/doc/$name-$version

	make
	make DESTDIR=$PKG install
}
