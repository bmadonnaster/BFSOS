# Description: X Video extension client library
# URL: http://xorg.freedesktop.org
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: libXext

name=libXv
version=1.0.13
release=2
source=(https://www.x.org/releases/individual/lib/libXv-$version.tar.xz)

pkg_build() {
	./configure $XORG_CONFIG --docdir=/usr/share/doc/$name-$version
	make
	make DESTDIR=$PKG install
}
