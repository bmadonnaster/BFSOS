name=libX11
version=1.8.11
release=1
source=(https://www.x.org/releases/individual/lib/libX11-$version.tar.xz)

build() {
	cd libX11-$version

	  ./configure $XORG_CONFIG $docdir \
                  --with-appdefaultdir=/etc/X11/app-defaults

	make
	make DESTDIR="$PKG" install
}
