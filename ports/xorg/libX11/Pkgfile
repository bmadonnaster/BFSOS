# Description: X client library
# URL: http://xorg.freedesktop.org
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: libxcb xorgproto xtrans

name=libX11
version=1.8.13
release=3
source=(https://www.x.org/releases/individual/lib/libX11-$version.tar.xz)

pkg_build() {

	  ./configure $XORG_CONFIG --docdir=/usr/share/doc/$name-$version \
                  --with-appdefaultdir=/etc/X11/app-defaults

	make
	make DESTDIR="$PKG" install
}
