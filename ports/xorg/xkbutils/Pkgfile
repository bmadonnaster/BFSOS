# Description: xorg XKB keyboard description compiler
# URL: https://xorg.freedesktop.org
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: libxkbfile libXaw

name=xkbutils
version=1.0.7
release=3
source=(https://www.x.org/releases/individual/app/xkbutils-$version.tar.xz)

pkg_build() {

	 ./configure $XORG_CONFIG || return $?

	make -j "${JOBS:-1}" || return $?
	make DESTDIR="$PKG" install || return $?
}
