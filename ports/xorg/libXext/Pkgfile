name=libXext
version=1.3.6
release=1
source=(https://www.x.org/releases/individual/lib/libXext-$version.tar.xz)
keep_libtool=1

build() {
	cd libXext-$version

	  ./configure $XORG_CONFIG $docdir \
                  --with-appdefaultdir=/etc/X11/app-defaults

	make
	make DESTDIR=$PKG install
}
