# Description: Common X extensions client library
# URL: http://xorg.freedesktop.org
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: libX11

name=libXext
version=1.3.7
release=3
source=(https://www.x.org/releases/individual/lib/libXext-$version.tar.xz)
keep_libtool=1

pkg_build() {

	  ./configure $XORG_CONFIG --docdir=/usr/share/doc/$name-$version \
                  --with-appdefaultdir=/etc/X11/app-defaults

	make
	make DESTDIR=$PKG install
}
