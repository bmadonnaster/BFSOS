# Description: Kernel multi-touch transformation library
# URL: https://launchpad.net/mtdev
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>

name=mtdev
version=1.1.7
release=1
source=(https://bitmath.org/code/mtdev/mtdev-$version.tar.bz2)

pkg_build() {

    ./configure --prefix=/usr --disable-static || return 1
    make || return 1
    make DESTDIR="$PKG" install || return 1
}
