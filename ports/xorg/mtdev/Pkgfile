# Description: Kernel multi-touch transformation library
# URL: https://launchpad.net/mtdev
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>

name=mtdev
version=1.1.7
release=1
source=(${name}-${version}.tar.gz::https://deb.debian.org/debian/pool/main/m/mtdev/mtdev_${version}.orig.tar.gz)

pkg_build() {

	./configure --prefix=/usr --disable-static &&
make
	make DESTDIR=$PKG install
}
