name=mtdev
version=1.1.7
release=1
source=(http://launchpad.net/$name/trunk/$version/+download/$name-$version.tar.gz)

pkg_build() {

	./configure --prefix=/usr --disable-static &&
make
	make DESTDIR=$PKG install
}
