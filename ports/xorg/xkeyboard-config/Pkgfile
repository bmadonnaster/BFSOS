name=xkeyboard-config
version=2.48
release=3
source=(https://xorg.freedesktop.org/archive/individual/data/$name/$name-$version.tar.xz)

pkg_build() {
	mkdir build &&
cd    build &&

meson setup --prefix=$XORG_PREFIX --buildtype=release .. &&
ninja
DESTDIR=$PKG ninja install
}
