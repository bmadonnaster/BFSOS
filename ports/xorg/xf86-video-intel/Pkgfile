name=xf86-video-intel
version=2.99.917-931
release=1
source=(https://crux.nu/files/distfiles/xf86-video-intel-$version.tar.xz)

build() {
	cd xf86-video-intel-$version

	./configure \
		--prefix=/usr \
		--libexecdir=/usr/lib/xf86-video-intel \
		--enable-tools \
		--with-default-dri=3

	make
	make DESTDIR=$PKG install
}
