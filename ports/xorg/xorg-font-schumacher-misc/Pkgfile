# Description: xorg font font-schumacher-misc
# URL: https://xorg.freedesktop.org
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: bdftopcf xorg-font-util mkfontscale

name=xorg-font-schumacher-misc
version=1.1.2
release=1
source=(https://xorg.freedesktop.org/archive/individual/font/font-schumacher-misc-$version.tar.bz2)

pkg_build() {

	./configure --prefix=/usr

	make
	make DESTDIR=$PKG install

	rm $PKG/usr/share/fonts/X11/misc/fonts.dir
}
