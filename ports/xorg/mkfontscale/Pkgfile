name=mkfontscale
version=1.2.3
release=1
source=(https://www.x.org/releases/individual/app/mkfontscale-$version.tar.xz)

pkg_build() {

	./configure $XORG_CONFIG

	make
	make DESTDIR=$PKG install
}
