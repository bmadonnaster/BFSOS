name=wayland
version=1.23.1
release=1
source=(https://gitlab.freedesktop.org/$name/$name/-/releases/$version/downloads/$name-$version.tar.xz)

build() {

	cd $name-$version
	mkdir build &&
	cd    build &&

meson setup ..            \
      --prefix=/usr       \
      --buildtype=release \
      -Ddocumentation=false &&
ninja
	DESTDIR=$PKG ninja install
}
