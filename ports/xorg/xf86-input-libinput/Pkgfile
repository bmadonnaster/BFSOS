# Description: X driver based on libinput
# URL: https://xorg.freedesktop.org
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: libinput xorg-server

name=xf86-input-libinput
version=1.5.0
release=1
source=(https://xorg.freedesktop.org/archive/individual/driver/xf86-input-libinput-$version.tar.xz)

pkg_build() {
	./configure $XORG_CONFIG &&
	make
	make DESTDIR=$PKG install
}
