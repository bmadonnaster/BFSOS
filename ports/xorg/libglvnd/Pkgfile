# Description: GL Vendor-Neutral Dispatch library
# URL: https://github.com/NVIDIA/libglvnd
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: meson ninja libX11 libXext xorgproto

name=libglvnd
version=1.7.0
release=2
source=(https://github.com/NVIDIA/libglvnd/archive/v${version}/libglvnd-${version}.tar.gz)

pkg_build() {
    meson setup build \
        --prefix=/usr \
        --buildtype=plain \
        --wrap-mode=nodownload \
        -Db_lto=true \
        -Db_pie=true \
        -Dx11=enabled \
        -Dglx=enabled \
        -Dgles1=false \
        -Degl=true \
        -Dtls=false || return 1

    meson compile -C build || return 1

    DESTDIR="$PKG" \
        meson install -C build || return 1
}
