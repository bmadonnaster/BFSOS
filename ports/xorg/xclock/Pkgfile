name=xclock
version=1.1.1
release=1
source=(https://www.x.org/pub/individual/app/$name-$version.tar.xz)

build() {
    cd "$name-$version"

    ./configure $XORG_CONFIG &&
make
    make DESTDIR=$PKG install
}
