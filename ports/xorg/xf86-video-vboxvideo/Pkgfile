# Description: Legacy X.Org VirtualBox video driver
# URL: https://xorg.freedesktop.org/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: xorg-server

name=xf86-video-vboxvideo
version=1.0.0
release=2
source=(https://xorg.freedesktop.org/archive/individual/driver/xf86-video-vboxvideo-$version.tar.bz2)

pkg_build() {
    # This legacy source uses bool/true/false as identifiers. GCC defaults to
    # C23 where those spellings are keywords, so build this port specifically
    # as GNU17 rather than weakening the global BFSOS compiler policy.
    CFLAGS="${CFLAGS} -std=gnu17" ./configure --prefix=/usr || return $?
    make -j "${JOBS:-1}" CFLAGS="${CFLAGS} -std=gnu17" || return $?
    make DESTDIR="$PKG" install || return $?
}
