# Description: xorg XKB keyboard description compiler
# URL: https://xorg.freedesktop.org
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: libxkbfile

name=xkbcomp
version=1.5.0
release=2
source=(https://xorg.freedesktop.org/archive/individual/app/xkbcomp-$version.tar.xz)

pkg_build() {

	./configure $XORG_CONFIG

	make
	make DESTDIR=$PKG pkgconfigdir=/usr/share/pkgconfig install
}
