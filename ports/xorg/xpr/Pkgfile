name=xpr
version=1.2.0
release=1
source=(https://www.x.org/releases/individual/app/xpr-$version.tar.xz)

build() {
	cd xpr-$version

	./configure $XORG_CONFIG

	make
	make DESTDIR=$PKG install
}
