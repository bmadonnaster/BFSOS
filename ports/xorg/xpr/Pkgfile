# Description: Tool for modifying keymaps and pointer button mappings in X
# URL: https://xorg.freedesktop.org
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: libX11 libXmu

name=xpr
version=1.2.1
release=1
source=(https://xorg.freedesktop.org/archive/individual/app/xpr-$version.tar.xz)

pkg_build() {

	./configure $XORG_CONFIG

	make
	make DESTDIR=$PKG install
}
