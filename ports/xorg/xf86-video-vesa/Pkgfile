name=xf86-video-vesa
version=2.6.0
release=1
source=(https://www.x.org/releases/individual/driver/xf86-video-vesa-$version.tar.xz)

build() {
	cd xf86-video-vesa-$version
	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install
}
