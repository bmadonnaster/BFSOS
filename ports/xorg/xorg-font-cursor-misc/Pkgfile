name=xorg-font-cursor-misc
version=1.0.3
release=1
source=(https://www.x.org/releases/individual/font/font-cursor-misc-$version.tar.bz2)

pkg_build() {

	./configure --prefix=/usr

	make
	make DESTDIR=$PKG install

	rm $PKG/usr/share/fonts/X11/misc/fonts.dir
}
