name=libXtst
version=1.2.5
release=3
source=(https://www.x.org/releases/individual/lib/libXtst-$version.tar.xz)

pkg_build() {

	./configure $XORG_CONFIG --docdir=/usr/share/doc/$name-$version

	make
	make DESTDIR=$PKG install
}
