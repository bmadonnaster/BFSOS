# Description: X Composite extension client library
# URL: http://xorg.freedesktop.org
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: libXext libXfixes

name=libXcomposite
version=0.4.7
release=3
source=(https://www.x.org/releases/individual/lib/libXcomposite-$version.tar.xz)

pkg_build() {
	  ./configure $XORG_CONFIG --docdir=/usr/share/doc/$name-$version \
                  --with-appdefaultdir=/etc/X11/app-defaults
	make
	make DESTDIR=$PKG install
}
