# Description: xorg lib libfontenc
# URL: https://xorg.freedesktop.org
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: xorgproto zlib

name=libfontenc
version=1.1.9
release=3
source=(https://www.x.org/releases/individual/lib/libfontenc-$version.tar.xz)

pkg_build() {

	./configure $XORG_CONFIG --docdir=/usr/share/doc/$name-$version

	make
	make DESTDIR=$PKG install
}
