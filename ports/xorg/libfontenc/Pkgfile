name=libfontenc
version=1.1.8
release=1
source=(https://www.x.org/releases/individual/lib/libfontenc-$version.tar.xz)

build() {
	cd libfontenc-$version

	./configure $XORG_CONFIG $docdir

	make
	make DESTDIR=$PKG install
}
