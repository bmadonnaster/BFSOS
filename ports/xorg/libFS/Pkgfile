# Description: X Font Service client library
# URL: https://xorg.freedesktop.org
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: xorgproto xtrans

name=libFS
version=1.0.10
release=3
source=(https://xorg.freedesktop.org/archive/individual/lib/libFS-$version.tar.xz)

pkg_build() {

	  ./configure $XORG_CONFIG --docdir=/usr/share/doc/$name-$version \
                  --with-appdefaultdir=/etc/X11/app-defaults

	make
	make DESTDIR=$PKG install
}
