# Description: Headers defining the core protocol and extensions for the X Window System
# URL: http://xorg.freedesktop.org
# Maintainer: Brian Madonna email bmadonnaster@gmail.com
# Depends on: meson ninja

name=xorgproto
version=2025.1
release=2
source=(https://xorg.freedesktop.org/archive/individual/proto/xorgproto-$version.tar.xz)

pkg_build() {
		meson setup xorgproto-$version build \
		--prefix=$XORG_PREFIX \
		--buildtype=plain \
		--wrap-mode nodownload \
		-D b_lto=true \
		-D b_pie=true \
		-D legacy=true
	meson compile -C build
	DESTDIR="$PKG" meson install -C build


	# cleanup
	rm -f "$PKG"/usr/include/X11/extensions/apple*
	rm -f "$PKG"/usr/include/X11/extensions/windows*
	rm -f "$PKG"/usr/share/pkgconfig/apple*
	rm -f "$PKG"/usr/share/pkgconfig/windows*
	rm -f "$PKG"/usr/include/X11/extensions/vldXvMC.h # xorg-libxvmc >= 1.0.13-2
	rm -f "$PKG"/usr/include/X11/extensions/XKBgeom.h # libX11 >= 1.8.1-2
	rm -rf "$PKG"/usr/share/doc
}
