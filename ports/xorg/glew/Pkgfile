# Description: OpenGL Extension Wrangler library
# URL: https://glew.sourceforge.net/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: glu libXi libXmu

name=glew
version=2.3.1
release=1
source=(https://downloads.sourceforge.net/project/glew/glew/$version/glew-$version.tgz)

pkg_build() {
    make -j"${JOBS:-1}" \
        GLEW_DEST=/usr \
        LIBDIR=/usr/lib \
        || return 1
    make \
        GLEW_DEST="$PKG/usr" \
        LIBDIR="$PKG/usr/lib" \
        PKGDIR="$PKG/usr/lib/pkgconfig" \
        install \
        || return 1
}
