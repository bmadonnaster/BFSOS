# Description: X Window System initializer (xinit/startx)
# URL: https://www.x.org/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: xorg-server xorg-libs
# Recommended runtime: twm xclock xterm

name=xinit
version=1.4.4
release=3
source=(https://www.x.org/releases/individual/app/$name-$version.tar.xz)

pkg_build() {
    ./configure $XORG_CONFIG --with-xinitdir=/etc/X11/app-defaults || return $?
    make -j "${JOBS:-1}" || return $?
    make DESTDIR="$PKG" install || return $?
}
