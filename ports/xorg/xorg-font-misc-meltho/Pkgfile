# Description: xorg font font-misc-meltho
# URL: https://xorg.freedesktop.org
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: fontconfig mkfontscale

name=xorg-font-misc-meltho
version=1.0.3
release=1
source=(https://xorg.freedesktop.org/archive/individual/font/font-misc-meltho-$version.tar.bz2)

pkg_build() {

	./configure --prefix=/usr

	make
	make DESTDIR=$PKG install

	rm $PKG/usr/share/fonts/X11/OTF/fonts.{dir,scale}
}
