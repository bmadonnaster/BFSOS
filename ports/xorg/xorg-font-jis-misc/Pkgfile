# Description: xorg font font-jis-misc
# URL: http://xorg.freedesktop.org
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: bdftopcf xorg-font-util mkfontscale

name=xorg-font-jis-misc
version=1.0.3
release=1
source=(https://www.x.org/releases/individual/font/font-jis-misc-$version.tar.bz2)

pkg_build() {

	./configure --prefix=/usr

	make
	make DESTDIR=$PKG install

	rm $PKG/usr/share/fonts/X11/misc/fonts.dir
}
