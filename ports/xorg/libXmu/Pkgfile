name=libXmu
version=1.2.1
release=1
source=(https://www.x.org/releases/individual/lib/libXmu-$version.tar.xz)

build() {
	cd libXmu-$version

	  ./configure $XORG_CONFIG $docdir \
                  --with-appdefaultdir=/etc/X11/app-defaults

	make
	make DESTDIR=$PKG install
}
