# Description: X Xinerama client library
# URL: http://xorg.freedesktop.org
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: libXext

name=libXinerama
version=1.1.6
release=3
source=(https://www.x.org/releases/individual/lib/libXinerama-$version.tar.xz)

pkg_build() {

	./configure $XORG_CONFIG --docdir=/usr/share/doc/$name-$version

	make
	make DESTDIR=$PKG install
}
