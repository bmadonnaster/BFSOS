name=libXinerama
version=1.1.5
release=1
source=(https://www.x.org/releases/individual/lib/libXinerama-$version.tar.xz)

build() {
	cd libXinerama-$version

	./configure $XORG_CONFIG $docdir

	make
	make DESTDIR=$PKG install
}
