name=xrandr
version=1.5.4
release=2
source=(https://xorg.freedesktop.org/archive/individual/app/xrandr-$version.tar.xz)

pkg_build() {

	./configure $XORG_CONFIG

	make
	make DESTDIR=$PKG install
}
