name=xrandr
version=1.5.2
release=1
source=(https://www.x.org/releases/individual/app/xrandr-$version.tar.xz)

build() {
	cd xrandr-$version

	./configure $XORG_CONFIG	

	make
	make DESTDIR=$PKG install
}
