# Description: X Video Motion Compensation extension client library
# URL: https://xorg.freedesktop.org
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: libXv

name=libXvMC
version=1.0.15
release=4
source=(https://xorg.freedesktop.org/archive/individual/lib/libXvMC-$version.tar.xz)

pkg_build() {
	./configure $XORG_CONFIG --docdir=/usr/share/doc/$name-$version

	make
	make DESTDIR=$PKG install
}
