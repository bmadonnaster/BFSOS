name=xf86-video-dummy
version=0.4.1
release=1
source=(https://xorg.freedesktop.org/archive/individual/driver/xf86-video-dummy-$version.tar.xz)

build() {
	cd xf86-video-dummy-$version
	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install
}
