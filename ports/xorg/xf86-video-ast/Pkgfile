name=xf86-video-ast
version=1.2.0
release=1
source=(https://www.x.org/releases/individual/driver/xf86-video-ast-$version.tar.xz)

build() {
	cd xf86-video-ast-$version
	./configure --prefix=/usr --mandir=/usr/man
	make
	make DESTDIR=$PKG install
}

