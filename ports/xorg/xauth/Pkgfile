# Description: X authority file utility
# URL: https://xorg.freedesktop.org
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: libX11 libXau libXext libXmu

name=xauth
version=1.1.5
release=3
source=(https://xorg.freedesktop.org/archive/individual/app/xauth-$version.tar.xz)

pkg_build() {

	./configure $XORG_CONFIG || return $?

	make -j "${JOBS:-1}" || return $?
	make DESTDIR="$PKG" install || return $?
}
