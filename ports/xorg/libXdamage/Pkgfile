# Description: X Damage extension client library
# URL: https://xorg.freedesktop.org
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: libXfixes

name=libXdamage
version=1.1.7
release=3
source=(https://xorg.freedesktop.org/archive/individual/lib/libXdamage-$version.tar.xz)

pkg_build() {
	./configure $XORG_CONFIG --docdir=/usr/share/doc/$name-$version
	make
	make DESTDIR=$PKG install
}
