name=libXt
version=1.3.1
release=1
source=(https://www.x.org/releases/individual/lib/libXt-$version.tar.xz)

build() {
	cd libXt-$version

	  ./configure $XORG_CONFIG $docdir \
                  --with-appdefaultdir=/etc/X11/app-defaults

	make
	make DESTDIR=$PKG install
}
