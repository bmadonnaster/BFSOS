# Description: X11 toolkit intrinsics library
# URL: https://xorg.freedesktop.org
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: libSM libX11

name=libXt
version=1.3.1
release=2
source=(https://xorg.freedesktop.org/archive/individual/lib/libXt-$version.tar.xz)

pkg_build() {

	  ./configure $XORG_CONFIG --docdir=/usr/share/doc/$name-$version \
                  --with-appdefaultdir=/etc/X11/app-defaults

	make
	make DESTDIR=$PKG install
}
