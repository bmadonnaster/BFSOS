name=xf86-video-mga
version=2.0.1
release=1
source=(https://www.x.org/releases/individual/driver/xf86-video-mga-$version.tar.xz)

build() {
	cd xf86-video-mga-$version

	./configure --prefix=/usr

	make
	make DESTDIR=$PKG install
}
