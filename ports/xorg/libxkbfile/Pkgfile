# Description: XKB file handling library
# URL: https://www.x.org/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: libX11 xorgproto meson ninja

name=libxkbfile
version=1.2.0
release=3
source=(https://www.x.org/releases/individual/lib/libxkbfile-$version.tar.xz)

pkg_build() {
    meson setup build \
        --prefix=/usr \
        --libdir=/usr/lib \
        --buildtype=release || return 1

    meson compile -C build -j "${JOBS:-1}" || return 1

    DESTDIR="$PKG" \
        meson install -C build || return 1
}
