# Description: Compiz Reloaded compositing window manager (0.8.x series)
# URL: https://gitlab.com/compiz/compiz-core
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: dbus glu librsvg libSM libXcomposite libXcursor libXdamage libXi libXinerama libXrandr libxslt startup-notification

name=compiz
version=0.8.18
release=2
source=(https://gitlab.com/compiz/compiz-core/-/archive/v$version/compiz-core-v$version.tar.bz2
 https://gitlab.com/compiz/compiz-core/-/commit/c0c605dd.patch
 https://gitlab.com/compiz/compiz-core/-/commit/9f105a8b.patch
 https://gitlab.com/compiz/compiz-core/-/commit/ea7b3731.patch
 https://gitlab.com/compiz/compiz-core/-/commit/d4213fa4.patch)

pkg_build() {
    NOCONFIGURE=1 ./autogen.sh || return 1
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --disable-static \
        --with-default-plugins="core,ccp,composite,opengl,decor,move,resize,place,regex,wall,animation,staticswitcher" \
        || return 1
    make -j"${JOBS:-1}" || return 1
    make DESTDIR="$PKG" install || return 1
}
