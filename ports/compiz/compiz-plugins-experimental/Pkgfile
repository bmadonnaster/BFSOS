# Description: Experimental Compiz Reloaded plugin collection
# URL: https://gitlab.com/compiz/compiz-plugins-experimental
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: compiz compiz-bcop compiz-plugins-main compiz-plugins-extra cairo curl glew glu libSM libX11 libXScrnSaver libXcomposite libXcursor libXdamage libXext libXfixes libXi libXinerama libXrandr libxml2 startup-notification

name=compiz-plugins-experimental
version=0.8.18
release=1
source=(
    https://gitlab.com/compiz/$name/-/archive/v$version/$name-v$version.tar.bz2
    https://gitlab.com/compiz/$name/-/commit/35ce86af.patch
)

pkg_build() {
    NOCONFIGURE=1 ./autogen.sh || return 1
    ./configure --prefix=/usr --disable-static || return 1
    make -j"${JOBS:-1}" || return 1
    make DESTDIR="$PKG" install || return 1
}
