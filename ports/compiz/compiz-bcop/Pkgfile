# Description: Compiz option code generator
# URL: https://gitlab.com/compiz/compiz-bcop
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: compiz libxslt

name=compiz-bcop
version=0.8.18
release=1
source=(https://gitlab.com/compiz/$name/-/archive/v$version/$name-v$version.tar.bz2)

pkg_build() {
    NOCONFIGURE=1 ./autogen.sh || return 1
    ./configure --prefix=/usr || return 1
    make -j"${JOBS:-1}" || return 1
    make DESTDIR="$PKG" install || return 1
}
