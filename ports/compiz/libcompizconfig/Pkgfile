# Description: CompizConfig configuration library
# URL: https://gitlab.com/compiz/libcompizconfig
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: compiz compiz-bcop libxml2 libxslt protobuf

name=libcompizconfig
version=0.8.18
release=1
source=(https://gitlab.com/compiz/$name/-/archive/v$version/$name-v$version.tar.bz2)

pkg_build() {
    NOCONFIGURE=1 ./autogen.sh || return 1
    ./configure --prefix=/usr --disable-static || return 1
    make -j"${JOBS:-1}" || return 1
    make DESTDIR="$PKG" install || return 1
}
