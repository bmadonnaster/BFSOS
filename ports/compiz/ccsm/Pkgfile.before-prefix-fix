# Description: CompizConfig graphical Settings Manager (GTK3/Python3)
# URL: https://gitlab.com/compiz/ccsm
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: compizconfig-python gtk3 python3-cairo python3-gobject python3-setuptools

name=ccsm
version=0.8.18
release=1
source=(https://gitlab.com/compiz/$name/-/archive/v$version/$name-v$version.tar.bz2)

pkg_build() {
    python3 setup.py build || return 1
    python3 setup.py install --root="$PKG" --optimize=1 || return 1
}
