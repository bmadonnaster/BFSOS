# Description: C extensions for Python 3
# URL: https://cython.org/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: python3 python3-setuptools

name=cython3
version=3.2.9
release=2
source=(https://github.com/cython/cython/archive/$version.tar.gz)

pkg_build() {
    python3 setup.py build || return 1
    python3 setup.py install --root="$PKG" --optimize=1 || return 1
}
