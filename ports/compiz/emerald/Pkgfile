# Description: GTK3 Emerald window decorator for Compiz Reloaded
# URL: https://gitlab.com/compiz/emerald
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: compiz gtk3 libwnck libXres shared-mime-info xdg-utils desktop-file-utils hicolor-icon-theme

name=emerald
version=0.8.18
release=2
source=(https://gitlab.com/compiz/$name/-/archive/v$version/$name-v$version.tar.bz2)

pkg_build() {
    NOCONFIGURE=1 LIBS+=" -lm -ldl" ./autogen.sh || return 1
    ./configure --prefix=/usr --with-gtk=3.0 || return 1
    make -j"${JOBS:-1}" || return 1
    make DESTDIR="$PKG" install || return 1
}
