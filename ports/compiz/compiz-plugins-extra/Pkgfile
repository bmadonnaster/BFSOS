# Description: Extra Compiz Reloaded plugin collection
# URL: https://gitlab.com/compiz/compiz-plugins-extra
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: compiz compiz-bcop compiz-plugins-main cairo glib glu libnotify xorg-libs

name=compiz-plugins-extra
version=0.8.18
release=1
source=(https://gitlab.com/compiz/$name/-/archive/v$version/$name-v$version.tar.bz2
 https://gitlab.com/compiz/compiz-plugins-extra/-/commit/e4f0ed89.patch
 https://gitlab.com/compiz/compiz-plugins-extra/-/commit/5f653e44.patch)

pkg_build() {
    NOCONFIGURE=1 ./autogen.sh || return 1
    ./configure --prefix=/usr --disable-static || return 1
    make -j"${JOBS:-1}" || return 1
    make DESTDIR="$PKG" install || return 1
}
