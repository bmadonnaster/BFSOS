# Description: Main Compiz Reloaded plugin collection
# URL: https://gitlab.com/compiz/compiz-plugins-main
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: compiz compiz-bcop libjpeg-turbo librsvg libXcomposite libXdamage libXinerama startup-notification

name=compiz-plugins-main
version=0.8.18
release=1
source=(https://gitlab.com/compiz/$name/-/archive/v$version/$name-v$version.tar.bz2
 https://gitlab.com/compiz/compiz-plugins-main/-/commit/568f653a.patch)

pkg_build() {
    NOCONFIGURE=1 ./autogen.sh || return 1
    ./configure --prefix=/usr --disable-static || return 1
    make -j"${JOBS:-1}" || return 1
    make DESTDIR="$PKG" install || return 1
}
