# Depends on: libwnck libxfce4windowing libxfce4ui desktop-file-utils xscreensaver shared-mime-info polkit-gnome xfdesktop

name=xfce4-session
version=4.20.4
release=2
source=(https://archive.xfce.org/src/xfce/${name}/${version%.*}/${name}-${version}.tar.bz2)
pkg_build() {
    ./configure --prefix=/usr \
        --sysconfdir=/etc \
        --disable-legacy-sm || return 1
    make || return 1
    make DESTDIR="$PKG" install || return 1
}

post_build() {
    # Xfce 4.20 Wayland support is experimental and xfwm4 is still X11-only.
    # BFSOS RC1 does not ship a supported wlroots compositor by default, so do
    # not advertise a login-manager session that cannot be completed safely.
    rm -f "$PKG/usr/share/wayland-sessions/xfce-wayland.desktop" \
          "$PKG/usr/share/wayland-sessions/xfce.desktop" 2>/dev/null || true
}
