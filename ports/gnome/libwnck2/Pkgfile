# Description: Window Navigator Construction Kit 2 compatibility library
# URL: https://gitlab.gnome.org/Archive/libwnck
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: at-spi2-core cairo fontconfig freetype gdk-pixbuf glib gtk harfbuzz libX11 libXres pango startup-notification

name=libwnck2
version=2.31.0
release=2
source=(https://download.gnome.org/sources/libwnck/2.31/libwnck-$version.tar.xz
        WindowActionMenu-unset-window-and-stop-async-events-on-dispose.patch)

pkg_build() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --disable-static

    make
    make DESTDIR="$PKG" install

    rm -f "$PKG/usr/bin/wnckprop" "$PKG/usr/bin/wnck-urgency-monitor"
    rmdir "$PKG/usr/bin" 2>/dev/null || true
}
