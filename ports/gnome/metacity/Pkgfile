# Depends on: at-spi2-core cairo dconf gdk-pixbuf glib glibc gsettings-desktop-schemas gtk3 libcanberra libgtop libICE libSM libX11 libXcomposite libXcursor libXdamage libXext libXfixes libXinerama libXpresent libXrandr libXrender libXres pango startup-notification zenity

name=metacity
version=3.58.1
release=1
source=(https://download.gnome.org/sources/$name/${version%.*}/$name-$version.tar.xz)

pkg_build() {
  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --disable-debug \
    --enable-compile-warnings \
    --disable-vulkan
  sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool
  make
make install
}
