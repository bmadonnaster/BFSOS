# Depends on: dbus glib gcr4 libusb libsecret gtk3 libcdio libgudev libsoup3 systemd udisks libcdio-paranoia avahi bluez fuse gnome-online-accounts libarchive libgcrypt libgdata libxml2 libxslt openssh samba

name=gvfs
version=1.60.2
release=1

source=(https://download.gnome.org/sources/${name}/${version%.*}/${name}-${version}.tar.xz)

pkg_build() {
    meson setup build . \
        --prefix=/usr \
        --buildtype=release \
        -Donedrive=false \
        -Dfuse=true \
        -Dgphoto2=false \
        -Dafc=false \
        -Dbluray=false \
        -Dnfs=false \
        -Dmtp=false \
        -Dsmb=true \
        -Ddnssd=true \
        -Dgoa=true \
        -Dgoogle=true || return 1

    meson compile -C build || return 1
    DESTDIR="$PKG" meson install -C build || return 1
}
