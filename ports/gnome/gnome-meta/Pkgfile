# Description: Complete BFSOS GNOME 51 desktop meta package
# URL: https://www.gnome.org/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: gdm gnome-session gnome-shell gnome-shell-extensions gnome-control-center gnome-settings-daemon gnome-backgrounds gnome-keyring gnome-menus nautilus gnome-terminal gnome-tweaks gnome-user-docs yelp dconf-editor xdg-desktop-portal-gnome gnome-apps-meta pipewire wireplumber alsa-utils rtkit

name=gnome-meta
version=51.0
release=1

pkg_build() {
    install -d "$PKG/usr/share/doc/$name" || return 1
    cat > "$PKG/usr/share/doc/$name/README" <<'EOT'
BFSOS complete GNOME 51 desktop meta package.
The core GNOME 51 shell/session/settings/application stack is coordinated with
GTK 4.23 and libadwaita 1.10. Legacy compatibility modules remain packaged
where BFSOS still has runtime consumers; removal is a separate migration.
EOT
}
