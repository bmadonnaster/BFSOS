# Depends on: json-glib libsoup3 make-ca glib gobject-introspection

name=librest
version=0.10.2
release=1
source=(https://download.gnome.org/sources/${name}/${version%.*}/${name}-${version}.tar.xz)
pkg_build () {
mkdir build &&
cd    build &&

meson setup --prefix=/usr       \
            --buildtype=release \
            -Dexamples=false    \
            -Dgtk_doc=false     \
            ..                  &&
ninja
ninja install
}
