name=gnome-keyring
version=50.0
release=1
source=(https://download.gnome.org/sources/${name}/${version%.*}/${name}-${version}.tar.xz)
build_pkg() {
sed -i 's:"/desktop:"/org:' schema/*.xml &&

./configure --prefix=/usr      \
            --sysconfdir=/etc  \
            --enable-ssh-agent &&
make
make install
}

