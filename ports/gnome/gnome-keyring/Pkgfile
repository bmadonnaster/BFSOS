# Description: GNOME daemon and tools for storing passwords and encryption keys
# URL: https://gitlab.gnome.org/GNOME/gnome-keyring
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: dbus dconf gcr glib libgcrypt linux-pam p11-kit systemd

name=gnome-keyring
version=50.0
release=2
source=(https://download.gnome.org/sources/${name}/${version%.*}/${name}-${version}.tar.xz)

pkg_build() {
    # Current upstream (48.alpha and newer) uses Meson, not Autotools.
    sed -i 's:"/desktop:"/org:' schema/*.xml || return 1

    meson setup build \
        --prefix=/usr \
        --buildtype=release \
        -Dsystemd=enabled \
        -Dssh-agent=false \
        -Dpam=true \
        -Dmanpage=false \
        -Ddebug-mode=false || return 1

    meson compile -C build || return 1
    DESTDIR="$PKG" meson install -C build || return 1
}
