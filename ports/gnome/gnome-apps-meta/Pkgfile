# Description: Current BLFS GNOME applications meta package
# URL: https://www.gnome.org/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: baobab brasero evince evolution file-roller gnome-calculator gnome-color-manager gnome-connections gnome-disk-utility gnome-logs gnome-maps gnome-nettool gnome-power-manager gnome-system-monitor gnome-terminal gnome-weather gucharmap loupe seahorse showtime snapshot
# Optional: eog gnome-screenshot

name=gnome-apps-meta
version=50.0
release=1
source=()

pkg_build() {
    install -d "$PKG/usr/share/doc/$name"
    cat > "$PKG/usr/share/doc/$name/README" <<'EOT'
This meta package tracks the current BLFS GNOME Applications chapter.
Legacy EOG and gnome-screenshot remain available as standalone BFSOS ports,
but are not part of the current default GNOME application set.
EOT
}
