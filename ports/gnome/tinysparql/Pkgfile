# Depends on: avahi json-glib libstemmer libxml2 vala glib gobject-introspection icu libsoup3 python3-gobject sqlite

name=tinysparql
version=3.12.0
release=1
source=(https://download.gnome.org/sources/${name}/${version%.*}/${name}-${version}.tar.xz)

build_opt="-Dman=false"

pre_build() {
    if [ -d docs/reference/libtracker-sparql/doc/Tsparql-3.0 ]; then
        mv docs/reference/libtracker-sparql/doc/{Tsparql-3.0,$name-$version} || return 1
        sed '/docs_name/s/Tsparql-3.0/$name-$version/' \
            -i docs/reference/libtracker-sparql/meson.build || return 1
    fi
}
