# Depends on: gnome-desktop json-glib mesa systemd upower

name=gnome-session
version=50.1
release=1
source=(https://download.gnome.org/sources/$name/${version%.*}/$name-$version.tar.xz)
pkg_build() {
    sed 's@/bin/sh@/bin/sh -l@' -i gnome-session/gnome-session.in || return 1
    meson setup build . --prefix=/usr --buildtype=release || return 1
    meson compile -C build -j "${JOBS:-1}" || return 1
    DESTDIR="$PKG" meson install -C build || return 1
}
