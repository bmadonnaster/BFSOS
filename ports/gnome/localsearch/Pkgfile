name=localsearch
version=3.11.2
release=3
source=(https://download.gnome.org/sources/${name}/${version%.*}/${name}-${version}.tar.xz)
pkg_build () {
mkdir build &&
cd    build &&

meson setup --prefix=/usr       \
            --buildtype=release \
            -D man=false        \
              \
            ..                  &&
ninja
ninja install
}
