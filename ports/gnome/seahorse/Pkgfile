# Description: Seahorse is a GNOME application for managing encryption keys and passwords in the GNOME Keyring
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: gcr4 gnupg gpgme itstool libhandy libpwquality libsecret vala libsoup3 p11-kit openssh avahi gnome-keyring 

name=seahorse
version=47.0.1
release=3
source=(https://download.gnome.org/sources/$name/47/$name-$version.tar.xz)
pkg_build() {
    sed -i "/GPGME_EVENT_NEXT_TRUSTITEM/d" pgp/seahorse-gpgme.c || return 1
sed -i -r 's:"(/apps):"/org/gnome\1:' data/*.xml &&

mkdir build &&
cd    build &&

meson setup --prefix=/usr --buildtype=release .. &&
ninja || return 1
ninja install || return 1
}
