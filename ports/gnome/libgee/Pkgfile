# Depends on: glib gobject-introspection vala

name=libgee
version=0.20.8
release=1
source=(https://download.gnome.org/sources/${name}/${version%.*}/${name}-${version}.tar.xz)
pkg_build() {
find . -name \*.vala -exec touch {} \;
  ./configure --prefix=/usr --enable-vala &&
make
  make DESTDIR=$PKG install
}
