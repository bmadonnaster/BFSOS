# BFS generated/downloaded build data
/packages/*
/sources/*
/archives/*

# Runtime/generated files
.bfs*
.bootstrap.pid
bfs-installer-profile.conf
bfs-install*.log

# Ignore everything under logs/
/logs/**

# Keep only the log directory placeholders
!/logs/toolchain/
!/logs/toolchain/.gitkeep
!/logs/base/
!/logs/base/.gitkeep
!/logs/installer/
!/logs/installer/.gitkeep
