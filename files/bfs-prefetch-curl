#!/usr/bin/env bash
set -u

health_file="${BFS_PREFETCH_HEALTH_FILE:-}"
prefixes="${BFS_PREFETCH_SOURCE_PREFIXES:-}"
url="${!#:-}"
matched_prefix=""

while IFS= read -r prefix; do
    [[ -n "$prefix" ]] || continue
    case "$url" in
        "$prefix"*) matched_prefix="$prefix"; break ;;
    esac
done <<<"$prefixes"

if [[ -n "$matched_prefix" && -n "$health_file" && -f "$health_file" ]] &&
   grep -Fxq -- "$matched_prefix" "$health_file"; then
    printf 'pkgmk prefetch: skipping unhealthy primary for this run: %s\n' "$matched_prefix" >&2
    exit 7
fi

curl "$@"
status=$?

# Mark only transport/TLS/stall failures. HTTP status failures (curl 22), local
# file/write errors, and resume/range errors remain source-specific and do not
# poison an otherwise healthy origin.
case "$status" in
    5|6|7|18|28|35|52|55|56|92)
        if [[ -n "$matched_prefix" && -n "$health_file" ]]; then
            if ! grep -Fxq -- "$matched_prefix" "$health_file" 2>/dev/null; then
                printf '%s\n' "$matched_prefix" >>"$health_file"
                printf 'pkgmk prefetch: marked primary unavailable for this run: %s (curl %s)\n' \
                    "$matched_prefix" "$status" >&2
            fi
        fi
        ;;
esac

exit "$status"
