            test -f $sf || sf=./$sf; \
            of=`echo "$f" | sed -e 's,^.*/,,' -e 's,\\.[^.]*$,,'`.o; \
            echo "gcc -DHAVE_CONFIG_H -DNO_XMALLOC -I. -I..  -I. -I. -I.. -I.. -DIN_LIBUNISTRING -DDEPENDS_ON_LIBICONV=1   -O2 -march=x86-64 -pipe -c $sf" 1>&6; \
